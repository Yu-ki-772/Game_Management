<%# app/views/alarms/calendar.html.erb %>
<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 sm:py-8">
  <%= render 'alarms/navigation' %>

  <div class="mb-4 sm:mb-6">
    <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-1 sm:mb-2">
      アラームカレンダー
    </h1>
    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mb-3">
      登録されたアラームを確認できます
    </p>

    <div class="flex items-center gap-4 flex-wrap">
      <div class="flex items-center gap-1.5">
        <div class="w-2.5 h-2.5 rounded-sm bg-blue-400 border-l-2 border-blue-600 flex-shrink-0"></div>
        <span class="text-xs text-gray-600 dark:text-gray-400">自分のアラーム</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-2.5 h-2.5 rounded-sm bg-amber-100 border-l-2 border-amber-400 flex-shrink-0"></div>
        <span class="text-xs text-gray-600 dark:text-gray-400">招待されたアラーム</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-2.5 h-2.5 rounded-sm bg-gray-200 border-l-2 border-gray-400 flex-shrink-0 opacity-60"></div>
        <span class="text-xs text-gray-600 dark:text-gray-400">過去のアラーム</span>
      </div>
    </div>
  </div>

  <%= turbo_frame_tag "calendar" do %>
    <%= render 'calendar_content' %>
  <% end %>
</div>