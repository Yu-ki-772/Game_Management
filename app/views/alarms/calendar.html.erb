<%# app/views/alarms/calendar.html.erb %>
<div class="max-w-7xl mx-auto px-2 sm:px-4 py-4 sm:py-8">
  <%= render 'alarms/navigation' %>

  <div class="mb-4 sm:mb-6">
    <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-1 sm:mb-2">アラームカレンダー</h1>
    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">登録されたアラームを確認できます</p>
  </div>

  <%= turbo_frame_tag "calendar" do %>
    <%= render 'calendar_content' %>
  <% end %>
</div>