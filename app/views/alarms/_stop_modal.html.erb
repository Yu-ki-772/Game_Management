<%# app/views/alarms/_stop_modal.html.erb %>
<div data-controller="stop_modal"
     data-stop_modal-alarm-log-id-value="<%= alarm_log.id %>"
     data-action="turbo:before-cache@window->stop_modal#beforeCache"
     class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">

  <%# オーバーレイ背景 %>
  <div data-action="click->stop_modal#close"
       class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>

  <%#
    モーダル本体
  %>
  <div class="relative
              bg-white dark:bg-gray-950
              border border-gray-200 dark:border-gray-800
              rounded-xl shadow-lg shadow-black/10 dark:shadow-black/40
              p-6 w-11/12 max-w-sm mx-4">

    <%# モーダルを閉じるボタン %>
    <button data-action="click->stop_modal#close"
            title="閉じる"
            class="absolute top-4 right-4
                   text-gray-400 dark:text-gray-500
                   hover:text-gray-600 dark:hover:text-gray-300
                   transition-colors"
            type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
      </svg>
    </button>

    
    <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
      アラームをストップしました
    </h2>

    <%#
      目標の超過時間に応じたメッセージ。
      エメラルド：「早め離脱＝完了・成功」→ 維持（意味のある色）。
      グレー： 「少し遅れた場合」
      赤：「遅れ＝緊急・問題」→ 維持（意味のある色）。
    %>
    <% if alarm_log.minutes_to_stop < 0 %>
      <p class="text-base font-medium mb-5
                text-emerald-600 dark:text-emerald-400">
        🎉 早めに離脱できたね！おめでとう！
      </p>
    <% elsif alarm_log.minutes_to_stop.between?(1, 60) %>
      <p class="text-base font-medium mb-5
                text-gray-500 dark:text-gray-400">
        ⏰ 少し遅くなっちゃったね。次は早めに離脱しよう！
      </p>
    <% elsif alarm_log.minutes_to_stop > 60 %>
      <p class="text-base font-medium mb-5
                text-red-500 dark:text-red-400">
        😓 だいぶ遅くなっちゃったね。次こそ早めに切り上げよう！
      </p>
    <% else %>
      <div class="mb-5"></div>
    <% end %>

    <div class="bg-gray-50 dark:bg-gray-900
                border border-gray-200 dark:border-gray-800
                rounded-xl px-4 py-4 mb-5">
      <p class="text-base text-gray-600 dark:text-gray-400 mb-1">
        引き延ばし時間
      </p>
      <p class="text-xl font-bold tabular-nums tracking-tight
                text-gray-900 dark:text-white">
        <%= format_play_minutes(alarm_log.minutes_to_stop) %>
      </p>

      <% if alarm_log.play_duration.present? %>
        <p class="text-base text-gray-600 dark:text-gray-400 mt-3 mb-1">
          プレイ時間
        </p>
        <p class="text-xl font-bold tabular-nums tracking-tight
                  text-gray-900 dark:text-white">
          <%= format_play_minutes(alarm_log.play_duration) %>
        </p>
      <% end %>
    </div>

    <%#
      X シェアボタン。
    %>
    <%= link_to x_share_url_for_alarm_log(alarm_log),
        target: "_blank",
        rel: "noopener noreferrer",
        class: "flex items-center justify-center gap-2 w-full py-2.5
                bg-gray-900 dark:bg-white
                hover:bg-gray-700 dark:hover:bg-gray-200
                text-white dark:text-gray-900
                text-base font-normal rounded-xl transition-colors" do %>
      <%= image_tag "x_logo_for_light.png", class: "h-4 hidden dark:block" %>
      <%= image_tag "x_logo_for_dark.png",  class: "h-4 dark:hidden" %>
      <span>でシェア</span>
    <% end %>
  </div>
</div>