<%# app/views/alarms/index/_membership_row.html.erb %>
<% alarm = membership.alarm %>

<div id="<%= dom_id(membership) %>"
     class="px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

  <%= link_to alarm_alarm_membership_path(alarm, membership),
      class: "flex items-center gap-4 flex-1 min-w-0 hover:opacity-70 transition-opacity" do %>

    <%# 日付・時刻ブロック %>
    <div class="flex flex-col items-center justify-center gap-0.5 shrink-0
                bg-emerald-50 dark:bg-emerald-900/20
                border border-emerald-100 dark:border-emerald-800
                rounded-lg px-3 py-2 min-w-[64px]">

      <%# 日付 %>
      <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium whitespace-nowrap">
        <%= alarm.scheduled_at.strftime("%m/%d") %>
        <span class="text-[10px]">(<%= %w[日 月 火 水 木 金 土][alarm.scheduled_at.wday] %>)</span>
      </span>

      <%# 時刻 %>
      <span class="text-sm font-bold text-gray-900 dark:text-gray-100 whitespace-nowrap">
        <% if alarm.started_at.present? %>
          <%= alarm.started_at.strftime("%H:%M") %>
          <span class="text-xs text-gray-400 dark:text-gray-500 mx-0.5">-</span>
          <%= alarm.scheduled_at.strftime("%H:%M") %>
        <% else %>
          <%= alarm.scheduled_at.strftime("%H:%M") %>
        <% end %>
      </span>
    </div>

    <%# ラベル・バッジ・メンバー情報ブロック %>
    <div class="flex-1 min-w-0 flex flex-col gap-1.5">

      <%# アラームラベル %>
      <span class="text-sm font-semibold text-gray-800 dark:text-gray-100 truncate">
        <%= truncate(alarm.label, length: 20) %>
      </span>

      <%# リマインダーバッジ %>
      <% if alarm.reminder_minutes.present? %>
        <span class="inline-flex items-center gap-1 w-fit text-xs
                     text-emerald-600 dark:text-emerald-400
                     bg-emerald-50 dark:bg-emerald-900/30
                     border border-emerald-200 dark:border-emerald-800
                     px-2 py-0.5 rounded-full">
          <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <%= reminder_label(alarm) %>
        </span>
      <% end %>

      <%# 作成者・メンバー情報 %>
      <% if alarm.alarm_memberships.any? %>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">

          <%# 作成者アバターと名前 %>
          <span class="inline-flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-500">
            作成者:
            <% if alarm.creator.avatar.attached? %>
              <%= image_tag alarm.creator.avatar, class: "w-5 h-5 rounded-full object-cover" %>
            <% else %>
              <span class="w-5 h-5 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
              </span>
            <% end %>
            <span class="font-medium text-gray-600 dark:text-gray-400">
              <%= truncate(alarm.creator.name, length: 11, omission: "...") %>
            </span>
          </span>

          <%# メンバー %>
          <% if alarm_display_members(alarm).any? %>
            <span class="w-px h-3 bg-gray-300 dark:bg-gray-600"></span>
            <span class="text-xs text-gray-400 dark:text-gray-500">メンバー:</span>

            <% alarm_display_members(alarm).each do |member| %>
              <span class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
                <% if member.avatar.attached? %>
                  <%= image_tag member.avatar, class: "w-4 h-4 rounded-full object-cover" %>
                <% else %>
                  <span class="w-4 h-4 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                    </svg>
                  </span>
                <% end %>
                <%= truncate(member.name, length: 11, omission: "...") %>
              </span>
            <% end %>

            <% if alarm_hidden_members_count(alarm) > 0 %>
              <span class="text-xs text-gray-400 dark:text-gray-500 font-medium">
                +<%= alarm_hidden_members_count(alarm) %>人
              </span>
            <% end %>
          <% end %>

        </div>
      <% end %>
    </div>
  <% end %>

  <%# 操作ボタンエリア %>
  <% if alarm.created_by?(current_user) %>
    <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
      <%= render "alarm_memberships/invite_dropdown", alarm: alarm %>

      <%= link_to edit_alarm_path(alarm),
          data: { turbo_frame: "dialog" },
          class: "px-3 py-1.5 text-xs font-semibold rounded-md border transition
                  bg-emerald-50 dark:bg-emerald-900/30 hover:bg-emerald-100 dark:hover:bg-emerald-900/50
                  text-emerald-700 dark:text-emerald-400
                  border-emerald-200 dark:border-emerald-800" do %>
        編集
      <% end %>

      <%= button_to alarm_path(alarm),
          method: :delete,
          data: { turbo_confirm: '本当に削除しますか?' },
          class: "px-3 py-1.5 text-xs font-semibold rounded-md border transition
                  bg-red-50 dark:bg-red-900/30 hover:bg-red-100 dark:hover:bg-red-900/50
                  text-red-600 dark:text-red-400
                  border-red-200 dark:border-red-800" do %>
        削除
      <% end %>
    </div>
  <% end %>

</div>