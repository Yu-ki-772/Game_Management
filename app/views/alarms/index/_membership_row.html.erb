<%# app/views/alarms/index/_membership_row.html.erb %>
<% alarm = membership.alarm %>

<div id="<%= dom_id(membership) %>"
     class="px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

  <%= link_to alarm_alarm_membership_path(alarm, membership),
      class: "flex items-center gap-4 flex-1 min-w-0
              hover:opacity-70 transition-opacity" do %>

    <%# ── 日付・時刻ブロック ── %>
    <%#
      エメラルド背景を廃止してニュートラルなグレーに。
      「色は意味を持つときだけ使う」という原則に従い、
      日付ブロックに色を付ける理由がないため装飾を排除した。
    %>
    <div class="flex flex-col items-center justify-center gap-1 shrink-0
                bg-gray-50 dark:bg-gray-900
                border border-gray-200 dark:border-gray-800
                rounded-lg px-3 py-2.5 min-w-[68px]">

      <%#
        時刻：行の中で最重要情報なので text-base を維持。
        Vercel の「重要な情報は大きく」という原則に従う。
      %>
      <span class="text-base font-bold tabular-nums
                   text-gray-900 dark:text-white
                   whitespace-nowrap leading-tight">
        <% if alarm.started_at.present? %>
          <%= alarm.started_at.strftime("%H:%M") %>
          <%# ハイフンより en ダッシュ（–）の方が時刻範囲の表現として自然 %>
          <span class="text-xs font-normal text-gray-400 dark:text-gray-600 mx-0.5">–</span>
          <%= alarm.scheduled_at.strftime("%H:%M") %>
        <% else %>
          <%= alarm.scheduled_at.strftime("%H:%M") %>
        <% end %>
      </span>

      <%#
        日付：補足情報なので text-[10px] のまま。
        さらに色を gray-600 に落として時刻との階層差を強調する。
      %>
      <span class="text-xs font-medium tabular-nums
                   text-gray-400 dark:text-gray-600
                   whitespace-nowrap leading-tight">
        <%= alarm.scheduled_at.strftime("%-m/%-d") %>
        (<%= %w[日 月 火 水 木 金 土][alarm.scheduled_at.wday] %>)
      </span>

    </div>

    <%# ── ラベル・バッジ・メンバー情報ブロック ── %>
    <div class="flex-1 min-w-0 flex flex-col gap-1.5">

      <%#
        アラームラベル：text-sm → text-base に上げる。
        時刻と同格の存在感を持たせることで、
        「時刻 + ラベル」がひと目で把握できる主情報のペアになる。
      %>
      <span class="text-base font-semibold text-gray-900 dark:text-white truncate">
        <%= truncate(alarm.label, length: 20) %>
      </span>

      <%#
        リマインダーバッジ：エメラルドを維持。
        「通知が設定されている」という状態を示しており、色に意味があるため。
      %>
      <% if alarm.reminder_minutes.present? %>
        <span class="inline-flex items-center gap-1 w-fit text-xs
                     text-emerald-600 dark:text-emerald-400
                     bg-emerald-50 dark:bg-emerald-900/20
                     border border-emerald-200 dark:border-emerald-800
                     px-2 py-0.5 rounded-full">
          <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <%= reminder_label(alarm) %>
        </span>
      <% end %>

      <%# ── 作成者・メンバー情報 ── %>
      <% if alarm.alarm_memberships.any? %>
        <div class="flex items-center gap-2">

          <div class="flex items-center -space-x-1">
            <%#
              作成者アバターの ring 色をエメラルドからニュートラルなグレーに変更。
              「なぜ緑のリングなのか」という疑問に答えられないため装飾を排除した。
            %>
            <% if alarm.creator.avatar.attached? %>
              <%= image_tag alarm.creator.avatar,
                    title: "作成者: #{alarm.creator.name}",
                    class: "w-5 h-5 rounded-full object-cover
                            ring-2 ring-gray-200 dark:ring-gray-700" %>
            <% else %>
              <span title="作成者: <%= alarm.creator.name %>"
                    class="w-5 h-5 rounded-full
                           bg-gray-100 dark:bg-gray-800
                           ring-2 ring-gray-200 dark:ring-gray-700
                           flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400"
                     viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
              </span>
            <% end %>

            <%# メンバーアバター %>
            <% alarm_display_members(alarm).each do |member| %>
              <% if member.avatar.attached? %>
                <%= image_tag member.avatar,
                      title: member.name,
                      class: "w-5 h-5 rounded-full object-cover
                              ring-2 ring-white dark:ring-gray-950" %>
              <% else %>
                <span title="<%= member.name %>"
                      class="w-5 h-5 rounded-full
                             bg-gray-100 dark:bg-gray-800
                             ring-2 ring-white dark:ring-gray-950
                             flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-gray-400"
                       viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                  </svg>
                </span>
              <% end %>
            <% end %>

            <%# +N人 %>
            <% if alarm_hidden_members_count(alarm) > 0 %>
              <span class="w-5 h-5 rounded-full
                           bg-gray-100 dark:bg-gray-800
                           ring-2 ring-white dark:ring-gray-950
                           text-[10px] font-semibold text-gray-500 dark:text-gray-400
                           flex items-center justify-center">
                +<%= alarm_hidden_members_count(alarm) %>
              </span>
            <% end %>
          </div>

          <%# 作成者名：補足情報なので text-xs + gray-600 でさらに控えめに %>
          <span class="text-xs text-gray-400 dark:text-gray-600 truncate">
            <%= truncate(alarm.creator.name, length: 11, omission: "...") %>
          </span>

        </div>
      <% end %>

    </div>
  <% end %>

  <%# ── 操作ボタンエリア ── %>
  <% if alarm.created_by?(current_user) %>
    <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
      <%= render "alarm_memberships/invite_dropdown", alarm: alarm %>

      <%# 編集ボタン：セカンダリ（border のみ）、エメラルドを廃止してニュートラルに %>
      <%= link_to edit_alarm_path(alarm),
          data: { turbo_frame: "dialog" },
          class: "px-3 py-1.5 text-xs font-medium rounded-md
                  border border-gray-200 dark:border-gray-800
                  text-gray-600 dark:text-gray-400
                  bg-white dark:bg-gray-950
                  hover:bg-gray-50 dark:hover:bg-gray-900
                  hover:text-gray-900 dark:hover:text-gray-100
                  transition-colors" do %>
        編集
      <% end %>

      <%# 削除ボタン：デストラクティブアクションは赤を維持（意味のある色） %>
      <%= button_to alarm_path(alarm),
          method: :delete,
          data: { turbo_confirm: '本当に削除しますか?',
                  turbo_submits_with: "削除中..." },
          class: "px-3 py-1.5 text-xs font-medium rounded-md
                  border border-red-200 dark:border-red-900
                  text-red-500 dark:text-red-400
                  bg-white dark:bg-gray-950
                  hover:bg-red-50 dark:hover:bg-red-950/50
                  transition-colors" do %>
        削除
      <% end %>
    </div>
  <% end %>

</div>