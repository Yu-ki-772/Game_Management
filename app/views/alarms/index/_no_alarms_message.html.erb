<%# app/views/alarms/index/_no_alarms_message.html.erb %>
<div id="no_alarms_message" class="flex items-center justify-center py-20">
  <div class="max-w-md mx-auto text-center">
    <% if user_signed_in? %>
      <%#
        見出しタグを廃止してシンプルな説明文に。
        「アラームがない」という状態は主張が強い見出しよりも、
        控えめな説明文の方が Vercel 的な「静かさ」に合う。
      %>
      <p class="text-base font-medium text-gray-700 dark:text-gray-500 mb-6">
        アラームが登録されていません
      </p>
      <%#
        トップページの空状態ボタンと同じ反転ボタンパターンを使うことで、
        「空の状態からのアクション促進」というUI パターンが全画面で統一される。
      %>
      <%= link_to new_alarm_path,
          data: { turbo_frame: "dialog" },
          class: "inline-flex items-center gap-2 px-5 py-2.5
                  bg-gray-900 dark:bg-white
                  text-white dark:text-gray-900
                  text-base font-semibold rounded-md
                  hover:bg-gray-700 dark:hover:bg-gray-100
                  transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 5l0 14" />
          <path d="M5 12l14 0" />
        </svg>
        アラームを作成
      <% end %>
    <% end %>
  </div>
</div>