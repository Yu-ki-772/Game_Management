<%# アラーム一覧の表示用のパーシャル %>
<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">

  <%# デスクトップ: テーブル形式 %>
  <div class="hidden sm:block">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-100 bg-gray-50">
          <th class="text-left text-xs font-medium text-gray-400 px-5 py-3">予定時間</th>
          <th class="text-left text-xs font-medium text-gray-400 px-5 py-3">ラベル</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% alarms.each do |alarm| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-5 py-3.5 whitespace-nowrap">
              <span class="text-sm font-bold text-gray-900">
                <%= l(alarm.scheduled_at, format: :short) %>
              </span>
            </td>
            <td class="px-5 py-3.5 w-full">
              <span class="text-sm text-gray-700"><%= alarm.label %></span>
            </td>
            <td class="px-5 py-3.5">
              <div class="flex items-center gap-2 justify-end">
                <%= link_to edit_alarm_path(alarm),
                    class: "px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-md border border-emerald-200 transition" do %>
                  編集
                <% end %>
                <%= button_to alarm_path(alarm),
                    method: :delete,
                    data: { turbo_confirm: '本当に削除しますか?' },
                    class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded-md border border-red-200 transition" do %>
                  削除
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# モバイル: リスト形式 %>
  <div class="sm:hidden divide-y divide-gray-50">
    <% alarms.each do |alarm| %>
      <div class="px-5 py-4 flex items-center justify-between gap-4">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-bold text-gray-900 mb-0.5">
            <%= l(alarm.scheduled_at, format: :short) %>
          </p>
          <p class="text-sm text-gray-600 truncate"><%= alarm.label %></p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <%= link_to edit_alarm_path(alarm),
              class: "px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-md border border-emerald-200 transition" do %>
            編集
          <% end %>
          <%= button_to alarm_path(alarm),
              method: :delete,
              data: { turbo_confirm: '本当に削除しますか?' },
              class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded-md border border-red-200 transition" do %>
            削除
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

</div>