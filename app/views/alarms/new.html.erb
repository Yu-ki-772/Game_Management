<%# アラーム作成画面 %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-baseline gap-3 pb-4 border-b-2 border-emerald-500 mb-8">
    <h1 class="text-3xl font-bold">アラームを作成</h1>
    <span class="text-xs bg-green-200 text-green-800 px-3 py-1 rounded-full">
      ※ 通知はメールで送信されます
    </span>
  </div>
  <div class="bg-white rounded-lg shadow-md p-6 max-w-2xl">
    <%= form_with model: @alarm, class: "space-y-6" do |f| %>
      
      <p class="text-sm text-gray-600 mb-4">
        <span class="text-red-600">*</span>がついているのは必須項目です
      </p>

      <%# バリデーションエラー表示用のパーシャルを読込 %>
      <%= render 'shared/error_messages', object: f.object %>
      <div>
        <%= f.label :label, class: "block text-gray-700 font-semibold mb-2" do %>
          ラベル<span class="text-red-600">*</span>
        <% end %>
        <%= f.text_field :label, 
            placeholder: 'アラーム', 
            class: "w-full px-4 py-2 border border-emerald-200 rounded focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :scheduled_at, class: "block text-gray-700 font-semibold mb-2" do %>
          日時<span class="text-red-600">*</span>
          
        <% end %>
        <%= f.datetime_field :scheduled_at, 
            class: "w-full px-4 py-2 border border-emerald-200 rounded focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent" %>
        <span class="text-xs text-gray-500 font-normal ml-2">(未来の日時のみ可)</span>
      </div>

      <div class="flex items-center space-x-4 pt-4">
        <%= f.submit 'アラームを作成', 
            class: "px-6 py-2 bg-emerald-600 text-white rounded hover:bg-emerald-700 transition font-semibold cursor-pointer" %>
        <%= link_to 'キャンセル', alarms_path, 
            class: "px-6 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400 transition font-semibold" %>
      </div>
    <% end %>
  </div>
</div>
