<%# app/views/alarms/new.html.erb %>

<%= turbo_frame_tag "dialog" do %>
    <dialog data-controller="dialog"
            data-action="click->dialog#clickOutside"
            class="fixed inset-0 mx-auto mt-20 rounded-xl shadow-lg p-6 w-11/12 max-w-2xl backdrop:bg-black/40 dark:bg-gray-800 bg-white">

      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">アラームを作成</h2>
        <button data-action="click->dialog#close"
                type="button"
                class="text-gray-400 hover:text-gray-600 transition">✕</button>
      </div>

      <%= render 'form', alarm: @alarm %>

    </dialog>

    
<% end %>