<%# アラームストップ画面 %>

<%# アラームストップ時のバリデーションエラーの表示 %>
<% if @alarm_log&.errors&.any? %>
  <%= render 'shared/error_messages', object: @alarm_log %>
<% end %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <div class="flex justify-between items-center pb-4 border-b-2 border-emerald-500 mb-8">
      <h1 class="text-3xl font-bold text-gray-900">アラームストップ画面</h1>
      <% if @alarms.present? %>
        <%= link_to new_alarm_path, 
                    class: "bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-6 py-2.5 rounded-lg transition flex items-center gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
          アラームを作成
        <% end %>
      <% end %>
    </div>
    
    <div class="text-sm text-gray-600 mb-6">
      ※一日以上先または一日以上前のアラームは表示されません
    </div>
    
    <% if @alarms.present? %>
      <%# ストップ可能なアラームが存在する場合 %>
      <%= render 'alarms/pending/alarm_list', alarms: @alarms %>
    <% else %>
      <%# ストップ可能なアラームが存在しない場合 %>
      <%= render 'alarms/pending/no_alarms_message' %>
    <% end %>
  </div>
</div>


