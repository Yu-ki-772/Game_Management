<%# app/views/alarms/pending.html.erb %>
<% if @alarm_log&.errors&.any? %>
  <%= render 'shared/error_messages', object: @alarm_log %>
<% end %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <%= render 'alarms/navigation' %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between pb-5 border-b border-gray-200 dark:border-gray-700 mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">アラームストップ</h1>
    <% if @alarms.present? %>
      <%= link_to new_alarm_path,
          class: "inline-flex items-center justify-center gap-2 sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-2 rounded-lg transition text-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 5l0 14" /><path d="M5 12l14 0" />
        </svg>
        アラームを作成
      <% end %>
    <% end %>
  </div>

  <p class="text-xs text-gray-400 dark:text-gray-500 mb-6">
    一日以上先または一日以上前のアラームは表示されません
  </p>

  <% if @alarm_memberships.present? %>
    <%= render 'alarms/pending/alarm_list',
           alarms: @alarms,
           alarm_memberships: @alarm_memberships %>
  <% else %>
    <%= render 'alarms/pending/no_alarms_message' %>
  <% end %>
</div>