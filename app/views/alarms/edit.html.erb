<%# app/views/alarms/edit.html.erb %>

<%= turbo_frame_tag "dialog" do %>
    <dialog data-controller="dialog"
            data-action="click->dialog#clickOutside turbo:before-cache@window->dialog#beforeCache"
            class="fixed inset-0 mx-auto mt-20 rounded-xl shadow-lg p-6 w-11/12 max-w-2xl backdrop:bg-black/40 bg-white dark:bg-gray-800">

      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">アラームを編集</h2>
        <button data-action="click->dialog#close"
                type="button"
                class="text-gray-400 hover:text-gray-600 transition">✕</button>
      </div>

      <%= render 'form', alarm: @alarm %>

      <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
        <%= button_to alarm_path(@alarm),
            method: :delete,
            data: { turbo_confirm: '本当に削除しますか?', turbo_frame: "_top" },
            class: "px-5 py-2 bg-red-50 dark:bg-red-900/30 hover:bg-red-100 dark:hover:bg-red-900/50
                    text-red-600 dark:text-red-400 text-xs font-semibold rounded-md
                    border border-red-200 dark:border-red-800 transition cursor-pointer" do %>
          削除
        <% end %>
      </div>

    </dialog>

<% end %>