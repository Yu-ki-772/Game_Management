<%# app/views/alarms/edit.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%# ナビゲーション %>
  <%= render 'alarms/navigation' %>

  <div class="mb-4">
    <%= link_to request.referer || alarms_path,
        class: "inline-flex items-center text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      戻る
    <% end %>
  </div>

  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3 pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">アラームを編集</h1>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 max-w-2xl">
    <%= form_with model: @alarm, class: "space-y-6" do |f| %>

      <p class="text-sm text-gray-500 dark:text-gray-400">
        <span class="text-red-500">*</span> は必須項目です
      </p>

      <%= render 'shared/error_messages', object: f.object %>

      <div>
        <%= f.label :label, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
          ラベル <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :label,
            placeholder: 'アラーム',
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    placeholder-gray-400 dark:placeholder-gray-500
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <div>
        <%= f.label :started_at, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
          開始時刻
          <span class="text-xs font-normal text-gray-500 dark:text-gray-400 ml-1">(任意)</span>
        <% end %>
        <%= f.datetime_field :started_at,
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1.5 ml-1">
          アラームが有効になる開始時刻を設定できます（省略可）
        </p>
      </div>

      <div>
        <%= f.label :scheduled_at, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
          アラーム日時 <span class="text-red-500">*</span>
        <% end %>
        <%= f.datetime_field :scheduled_at,
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1.5 ml-1">アラームが鳴る日時（未来の日時のみ指定可能）</p>
      </div>

      <div>
        <%= f.label :reminder_minutes, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
          事前リマインダー
          <span class="text-xs font-normal text-gray-500 dark:text-gray-400 ml-1">(任意)</span>
        <% end %>
        <%= f.select :reminder_minutes,
            [['なし', nil], ['5分前', 5], ['10分前', 10], ['15分前', 15], ['30分前', 30], ['1時間前', 60]],
            { include_blank: false },
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit '更新',
            class: "px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition cursor-pointer" %>
        <%= link_to 'キャンセル', request.referer || alarms_path,
            class: "px-5 py-2 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600
                    text-gray-600 dark:text-gray-300 text-sm font-semibold rounded-lg
                    border border-gray-200 dark:border-gray-600 transition" %>
      </div>
    <% end %>

    <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
      <%= button_to alarm_path(@alarm),
          method: :delete,
          data: { turbo_confirm: '本当に削除しますか?' },
          class: "px-5 py-2 bg-red-50 dark:bg-red-900/30 hover:bg-red-100 dark:hover:bg-red-900/50
                  text-red-600 dark:text-red-400 text-xs font-semibold rounded-md
                  border border-red-200 dark:border-red-800 transition cursor-pointer" do %>
        削除
      <% end %>
    </div>
  </div>
</div>