<%# 解除可能なアラーム一覧の表示用のパーシャル %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
  <% alarms.each do |alarm| %>
    <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-lg transition h-full flex flex-col">
      <div class="text-2xl font-bold text-gray-900 mb-2 text-center">
        <%# 設定時刻 %>
        <%= l(alarm.scheduled_at, format: :short) %>
      </div>
      
      <div class="text-base text-gray-600 text-center mb-3 flex-1 flex items-center justify-center">
        <%= alarm.label %>
      </div>
      
      <div class="flex flex-col space-y-1.5">
        <%= button_to unlock_alarm_path(alarm),
            method: :patch,
            class: "px-3 py-1.5 bg-emerald-600 text-white rounded hover:bg-emerald-700 transition font-semibold text-center text-sm" do %>
          解除
        <% end %>

        <%= button_to alarm_path(alarm),
            method: :delete,
            data: { turbo_confirm: '本当に削除しますか?' },
            class: "px-3 py-1.5 bg-red-700 text-white rounded hover:bg-red-800 transition font-semibold text-center text-sm" do %>
          削除
        <% end %>
      </div>
    </div>
  <% end %>
</div>