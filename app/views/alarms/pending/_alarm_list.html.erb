<%# ストップ可能なアラーム一覧の表示用のパーシャル %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% alarms.each do |alarm| %>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 flex flex-col gap-4 hover:shadow-md hover:border-emerald-100 transition">

      <%# 時間・ラベル %>
      <div>
        <p class="text-2xl font-bold text-gray-900 mb-1">
          <%= l(alarm.scheduled_at, format: :short) %>
        </p>
        <p class="text-sm text-gray-500 truncate"><%= alarm.label %></p>
      </div>

      <%= button_to unlock_alarm_path(alarm),
          method: :patch,
          class: "w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-lg transition" do %>
        ストップ
      <% end %>

      <%= button_to alarm_path(alarm),
          method: :delete,
          data: { turbo_confirm: '本当に削除しますか?' },
          class: "w-full py-1.5 text-xs text-gray-400 hover:text-red-500 transition text-center" do %>
        削除
      <% end %>

    </div>
  <% end %>
</div>