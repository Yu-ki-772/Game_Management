<div class="max-w-7xl mx-auto px-4 py-8">
  <%= render 'alarms/navigation' %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between pb-5 border-b border-gray-200 mb-8">
    <h1 class="text-2xl font-bold text-gray-900">アラーム一覧</h1>

    <%= link_to new_alarm_path,
        class: "inline-flex items-center justify-center gap-2 sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-2 rounded-lg transition text-sm" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M12 5l0 14" /><path d="M5 12l14 0" />
      </svg>
      アラームを作成
    <% end %>
  </div>

  <% if @memberships.present? %>
    <%= render 'alarms/index/alarm_list', memberships: @memberships %>
  <% else %>
    <%= render 'alarms/index/no_alarms_message' %>
  <% end %>

</div>