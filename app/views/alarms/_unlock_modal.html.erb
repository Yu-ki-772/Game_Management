<%# app/views/alarms/_unlock_modal.html.erb %>
<div data-controller="modal"
     data-modal-alarm-log-id-value="<%= alarm_log.id %>"
     data-action="turbo:before-cache@window->modal#beforeCache"
     class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">

  <div data-action="click->modal#close"
       class="absolute inset-0 bg-black/40"></div>

  <%# モーダル本体 %>
  <div class="relative bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 w-11/12 max-w-sm mx-4">

    <button data-action="click->modal#close"
            title="閉じる"
            class="absolute top-4 right-4 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition"
            type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
      </svg>
    </button>

    <%# タイトル %>
    <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-5">
      アラームをストップしました！
    </h2>

    <%# 終了予定時刻に対する時間に応じたメッセージ %>
    <% if alarm_log.minutes_to_unlock < 0 %>
      <p class="text-sm text-emerald-600 dark:text-emerald-400 font-medium mb-5">
        🎉 早めに離脱できたね！おめでとう！
      </p>
    <% elsif alarm_log.minutes_to_unlock.between?(1, 60) %>
      <p class="text-sm text-amber-500 dark:text-amber-400 font-medium mb-5">
        ⏰ 少し遅くなっちゃったね。次は早めに離脱しよう！
      </p>
    <% elsif alarm_log.minutes_to_unlock > 60 %>
      <p class="text-sm text-red-500 dark:text-red-400 font-medium mb-5">
        😓 だいぶ遅くなっちゃったね。次こそ早めに切り上げよう！
      </p>
    <% else %>
      <div class="mb-5"></div><%# タイトル下のスペース調整 %>
    <% end %>

    <%# 記録内容 %>
    <div class="bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-4 mb-6">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">終了予定時刻との時間差</p>
      <p class="text-3xl font-bold text-gray-900 dark:text-gray-100">
        <%= format_minutes_defer(alarm_log.minutes_to_unlock) %>
      </p>

      <%# play_durationが存在する場合のみ表示 %>
      <% if alarm_log.play_duration.present? %>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 mb-1">プレイ時間</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-gray-100">
          <%= format_play_duration(alarm_log.play_duration) %>
        </p>
      <% end %>
    </div>

    <%# シェアボタン %>
    <%= link_to x_share_url_for_alarm_log(alarm_log),
        target: "_blank",
        rel: "noopener noreferrer",
        class: "flex items-center justify-center gap-2 w-full py-2.5
                bg-gray-900 hover:bg-gray-700
                dark:bg-gray-700 dark:hover:bg-gray-600
                text-white text-sm font-semibold rounded-lg transition" do %>
      <%= image_tag "x_logo_for_light.png", class: "h-4 dark:hidden" %>
      <%= image_tag "x_logo_for_dark.png", class: "h-4 hidden dark:block" %>

      <span>でシェア</span>
    <% end %>
  </div>
</div>
