<%# app/views/alarms/_unlock_modal.html.erb %>
<div data-controller="unlock_modal"
     data-unlock_modal-alarm-log-id-value="<%= alarm_log.id %>"
     data-action="turbo:before-cache@window->unlock_modal#beforeCache"
     class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">

  <%# オーバーレイ背景 %>
  <div data-action="click->unlock_modal#close"
       class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>

  <%#
    モーダル本体。
    bg-gray-800 → bg-gray-950 に修正（確定トークン）。
    shadow は floating 要素として例外的に維持。
    border を追加してトークンに揃える。
  %>
  <div class="relative
              bg-white dark:bg-gray-950
              border border-gray-200 dark:border-gray-800
              rounded-xl shadow-lg shadow-black/10 dark:shadow-black/40
              p-6 w-11/12 max-w-sm mx-4">

    <%# 閉じるボタン %>
    <button data-action="click->unlock_modal#close"
            title="閉じる"
            class="absolute top-4 right-4
                   text-gray-400 dark:text-gray-500
                   hover:text-gray-600 dark:hover:text-gray-300
                   transition-colors"
            type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
      </svg>
    </button>

    <%# タイトル：tracking-tight を付けて他のページタイトルと統一 %>
    <h2 class="text-lg font-bold tracking-tight text-gray-900 dark:text-white mb-4">
      アラームをストップしました！
    </h2>

    <%#
      時間に応じたメッセージ。
      エメラルド：「早め離脱＝完了・成功」→ 維持（意味のある色）。
      アンバー：色体系から除外済み → gray に変更してメッセージで温度感を表現。
      赤：「遅れ＝緊急・問題」→ 維持（意味のある色）。
    %>
    <% if alarm_log.minutes_to_unlock < 0 %>
      <p class="text-sm font-medium mb-5
                text-emerald-600 dark:text-emerald-400">
        🎉 早めに離脱できたね！おめでとう！
      </p>
    <% elsif alarm_log.minutes_to_unlock.between?(1, 60) %>
      <%#
        アンバーを廃止。グレーでニュートラルに表現し、
        絵文字と文言で「少し遅れ」の温度感を伝える。
      %>
      <p class="text-sm font-medium mb-5
                text-gray-500 dark:text-gray-400">
        ⏰ 少し遅くなっちゃったね。次は早めに離脱しよう！
      </p>
    <% elsif alarm_log.minutes_to_unlock > 60 %>
      <p class="text-sm font-medium mb-5
                text-red-500 dark:text-red-400">
        😓 だいぶ遅くなっちゃったね。次こそ早めに切り上げよう！
      </p>
    <% else %>
      <div class="mb-5"></div>
    <% end %>

    <%#
      記録内容カード。
      bg-gray-700 → bg-gray-900 に修正（確定トークン）。
      border を追加。
    %>
    <div class="bg-gray-50 dark:bg-gray-900
                border border-gray-200 dark:border-gray-800
                rounded-xl px-4 py-4 mb-5">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">
        引き延ばし時間
      </p>
      <p class="text-3xl font-bold tabular-nums tracking-tight
                text-gray-900 dark:text-white">
        <%= alarm_log.minutes_to_unlock %>
      </p>

      <% if alarm_log.play_duration.present? %>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 mb-1">
          プレイ時間
        </p>
        <p class="text-3xl font-bold tabular-nums tracking-tight
                  text-gray-900 dark:text-white">
          <%= format_play_duration(alarm_log.play_duration) %>
        </p>
      <% end %>
    </div>

    <%#
      X シェアボタン。
      独自のダークグレーパターン → プライマリボタンの反転パターンに統一。
      （bg-gray-900 dark:bg-white / text-white dark:text-gray-900）
    %>
    <%= link_to x_share_url_for_alarm_log(alarm_log),
        target: "_blank",
        rel: "noopener noreferrer",
        class: "flex items-center justify-center gap-2 w-full py-2.5
                bg-gray-900 dark:bg-white
                hover:bg-gray-700 dark:hover:bg-gray-200
                text-white dark:text-gray-900
                text-sm font-semibold rounded-xl transition-colors" do %>
      <%= image_tag "x_logo_for_light.png", class: "h-4 hidden dark:block" %>
      <%= image_tag "x_logo_for_dark.png",  class: "h-4 dark:hidden" %>
      <span>でシェア</span>
    <% end %>
  </div>
</div>