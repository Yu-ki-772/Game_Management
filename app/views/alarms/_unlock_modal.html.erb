<div data-controller="modal" 
     data-modal-alarm-log-id-value="<%= alarm_log.id %>"
     data-action="turbo:before-cache@window->modal#close"
     class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">
  
  <%# モーダルの外側を押したときに、モーダルが閉じる %>
  <div data-action="click->modal#close" 
       class="absolute inset-0 bg-black/50"></div>
  
  <%# モーダル本体 %>
  <div class="relative bg-white rounded shadow p-6 w-11/12 max-w-md">
    
    <button data-action="click->modal#close" 
            title="閉じる"
            class="absolute top-2 right-5 text-gray-500 hover:text-gray-700 text-2xl"
            type="button">
      &times;
    </button>
    
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      アラームを解除しました!
    </h2>
    
    <%# アラームのラベルの表示 %>
    <p class="text-base font-medium text-gray-600 mb-2">
      <%= alarm_log.alarm.label %>
    </p>
    
    <%# 記録の表示 %>
    <p class="text-lg font-semibold text-gray-900 mb-6">
      <%= format_minutes_defer(alarm_log.minutes_to_unlock) %>
    </p>
    
    <%= link_to x_share_url_for_alarm_log(alarm_log), 
                target: "_blank", 
                rel: "noopener noreferrer",
                class: "flex items-center justify-center gap-2 w-full py-3 bg-emerald-600 text-white rounded hover:bg-emerald-700 cursor-pointer" do %>
      <%= image_tag "x_logo.png", class: "h-5" %>
      <span>でシェア</span>
    <% end %>
  </div>
</div>
