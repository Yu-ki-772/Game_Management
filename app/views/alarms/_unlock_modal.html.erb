<div data-controller="modal"
     data-modal-alarm-log-id-value="<%= alarm_log.id %>"
     data-action="turbo:before-cache@window->modal#beforeCache"
     class="fixed inset-0 z-50 flex items-center justify-center opacity-0 pointer-events-none">

  <div data-action="click->modal#close"
       class="absolute inset-0 bg-black/40"></div>

  <%# モーダル本体 %>
  <div class="relative bg-white rounded-xl shadow-lg p-6 w-11/12 max-w-sm mx-4">

    <button data-action="click->modal#close"
            title="閉じる"
            class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition"
            type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
      </svg>
    </button>

    <%# タイトル %>
    <h2 class="text-lg font-bold text-gray-900 mb-5">
      アラームをストップしました！
    </h2>

    <%# 記録内容 %>
    <div class="bg-gray-50 rounded-lg px-4 py-4 mb-6">
      <p class="text-xs text-gray-500 mb-1">終了予定時刻との時間差</p>
      <p class="text-3xl font-bold text-gray-900">
        <%= format_minutes_defer(alarm_log.minutes_to_unlock) %>
      </p>

      <%# play_durationが存在する場合のみ表示 %>
      <% if alarm_log.play_duration.present? %>
        <p class="text-xs text-gray-500 mt-3 mb-1">プレイ時間</p>
        <p class="text-3xl font-bold text-gray-900">
          <%= format_play_duration(alarm_log.play_duration) %>
        </p>
      <% end %>
    </div>

    <%# シェアボタン %>
    <%= link_to x_share_url_for_alarm_log(alarm_log),
        target: "_blank",
        rel: "noopener noreferrer",
        class: "flex items-center justify-center gap-2 w-full py-2.5 bg-gray-900 hover:bg-gray-700 text-white text-sm font-semibold rounded-lg transition" do %>
      <%= image_tag "x_logo.png", class: "h-4 brightness-0 invert" %>
      <span>でシェア</span>
    <% end %>
  </div>
</div>