<%# app/views/pages/privacy_policy.html.erb %>
<div class="flex flex-col h-full -mx-4 -my-6">

  <div class="flex-1 overflow-y-auto px-4 pt-6 pb-12">
    <div class="max-w-lg mx-auto space-y-6">

      <%# タイトルブロック %>
      <div class="border-b border-gray-200 dark:border-gray-800 pb-5">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100 tracking-tight">
          プライバシーポリシー
        </h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-500">
          発効日：2026年3月12日 &nbsp;／&nbsp; Game Exit
        </p>
      </div>

      <%# 1. 取得する情報 %>
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md
                       bg-gray-900 dark:bg-white
                       text-white dark:text-gray-900
                       text-sm font-bold shrink-0">1</span>
          取得する情報
        </h2>
        <div class="bg-gray-50 dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-base text-gray-700 dark:text-gray-400 leading-relaxed">
            本サービスでは、以下の情報を取得します。
          </p>
          <ul class="mt-3 space-y-1.5 text-base text-gray-700 dark:text-gray-400">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              メールアドレス
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              ユーザー名
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              アラーム機能を通じたゲームのプレイ時間の記録
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              ゲーム時間管理度診断の回答内容
            </li>
          </ul>
        </div>
      </section>

      <%# 2. 利用目的 %>
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md
                       bg-gray-900 dark:bg-white
                       text-white dark:text-gray-900
                       text-sm font-bold shrink-0">2</span>
          利用目的
        </h2>
        <div class="bg-gray-50 dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-base text-gray-700 dark:text-gray-400 leading-relaxed">
            取得した情報は、以下の目的で利用します。
          </p>
          <ul class="mt-3 space-y-1.5 text-base text-gray-700 dark:text-gray-400">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              アカウント管理のため
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              プレイ時間・履歴の記録・表示のため
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              診断結果の表示のため
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              サービス改善のため
            </li>
          </ul>
        </div>
      </section>

      <%# 3. 第三者提供 %>
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md
                       bg-gray-900 dark:bg-white
                       text-white dark:text-gray-900
                       text-sm font-bold shrink-0">3</span>
          第三者提供について
        </h2>
        <div class="bg-gray-50 dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-base text-gray-700 dark:text-gray-400 leading-relaxed">
            取得した個人情報を、本人の同意なく第三者へ提供することはありません。ただし、法令に基づく場合を除きます。
          </p>
        </div>
      </section>

      <%# 4. データの削除 %>
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md
                       bg-gray-900 dark:bg-white
                       text-white dark:text-gray-900
                       text-sm font-bold shrink-0">4</span>
          データの削除について
        </h2>
        <div class="bg-gray-50 dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-base text-gray-700 dark:text-gray-400 leading-relaxed">
            ユーザーが退会された場合、アカウントおよび関連データは削除されます。削除後の復元はできません。
          </p>
        </div>
      </section>

      <%# 5. セキュリティ %>
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md
                       bg-gray-900 dark:bg-white
                       text-white dark:text-gray-900
                       text-sm font-bold shrink-0">5</span>
          セキュリティについて
        </h2>
        <div class="bg-gray-50 dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-base text-gray-700 dark:text-gray-400 leading-relaxed">
            本サービスでは、不正アクセスや情報漏えいを防ぐため、合理的なセキュリティ対策を講じています。ただし、完全なセキュリティを保証するものではありません。
          </p>
        </div>
      </section>

      <%# 6. ポリシーの変更 %>
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-md
                       bg-gray-900 dark:bg-white
                       text-white dark:text-gray-900
                       text-sm font-bold shrink-0">6</span>
          プライバシーポリシーの変更について
        </h2>
        <div class="bg-gray-50 dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-base text-gray-700 dark:text-gray-400 leading-relaxed">
            本ポリシーは必要に応じて更新される場合があります。変更後もサービスをご利用いただいた場合、変更に同意したものとみなします。
          </p>
        </div>
      </section>

      <%# フッター %>
      <div class="pt-2 border-t border-gray-200 dark:border-gray-800">
        <p class="text-sm text-gray-600 dark:text-gray-500 text-right">
          本ポリシーは2026年3月12日より有効です。
        </p>
      </div>

    </div>
  </div>

</div>