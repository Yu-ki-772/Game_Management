<%# app/views/pages/terms.html.erb %>
<div class="flex flex-col h-full -mx-4 -my-6">

  <%# ── ヘッダー ────────────────────────────────────────────────── %>
  <div class="shrink-0 sticky top-0 z-10
              bg-white/90 dark:bg-gray-900/90 backdrop-blur
              border-b border-gray-100 dark:border-gray-800
              px-5 py-3">
    <div class="max-w-lg mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <%= link_to root_path,
              class: "w-8 h-8 flex items-center justify-center rounded-md
                      text-gray-400 dark:text-gray-500
                      hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">利用規約</span>
      </div>
    </div>
  </div>


  <%# ── メインコンテンツ ────────────────────────────────────────── %>
  <div class="flex-1 overflow-y-auto px-4 pt-6 pb-12">
    <div class="max-w-lg mx-auto space-y-6">

      <%# タイトルブロック %>
      <div class="border-b border-gray-200 dark:border-gray-700 pb-5">
        <h1 class="text-lg font-bold text-gray-800 dark:text-gray-100 tracking-tight">
          利用規約
        </h1>
        <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">
          発効日：2026年3月12日 &nbsp;／&nbsp; Game Exit
        </p>
      </div>


      <%# 1. サービスの目的 %>
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded
                       bg-emerald-500 text-white text-xs font-bold shrink-0">1</span>
          サービスの目的
        </h2>
        <div class="bg-white dark:bg-gray-900
                    border border-gray-100 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            本サービスは、ゲームのプレイ時間を記録・管理し、ゲームとの向き合い方を振り返るためのWebサービスです。なお、本サービスはゲーム依存症の医療診断や治療を行うものではありません。体調や生活に不安がある場合は、必ず医療機関へご相談ください。
          </p>
        </div>
      </section>


      <%# 2. 禁止事項 %>
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded
                       bg-emerald-500 text-white text-xs font-bold shrink-0">2</span>
          禁止事項
        </h2>
        <div class="bg-white dark:bg-gray-900
                    border border-gray-100 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            以下の行為は禁止します。
          </p>
          <ul class="mt-3 space-y-1.5 text-sm text-gray-600 dark:text-gray-400">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              他のユーザーへの迷惑行為
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              サービスへの不正アクセス・改ざん
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              法令に違反する行為
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 dark:bg-gray-600 shrink-0"></span>
              その他、サービス提供者が不適切と判断する行為
            </li>
          </ul>
        </div>
      </section>


      <%# 3. 知的財産権 %>
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded
                       bg-emerald-500 text-white text-xs font-bold shrink-0">3</span>
          知的財産権について
        </h2>
        <div class="bg-white dark:bg-gray-900
                    border border-gray-100 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            本サービスのコンテンツおよびデザインを無断で複製・転用することを禁じます。
          </p>
        </div>
      </section>


      <%# 4. 免責事項 %>
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded
                       bg-emerald-500 text-white text-xs font-bold shrink-0">4</span>
          免責事項
        </h2>
        <div class="bg-white dark:bg-gray-900
                    border border-gray-100 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            本サービスは、できる限り安定した運営に努めますが、不具合や一時的な停止が発生する場合があります。運営者に故意または重大な過失がある場合を除き、本サービスの利用により生じた損害については責任を負いかねます。また、サービスの正確性・継続性を保証するものではありません。特に診断結果はあくまで参考情報であり、医療的な根拠を持つものではないことをご理解ください。
          </p>
        </div>
      </section>


      <%# 5. 規約の変更 %>
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded
                       bg-emerald-500 text-white text-xs font-bold shrink-0">5</span>
          規約の変更について
        </h2>
        <div class="bg-white dark:bg-gray-900
                    border border-gray-100 dark:border-gray-800
                    rounded-xl px-5 py-4">
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            本規約は必要に応じて更新される場合があります。変更後もサービスをご利用いただいた場合、変更に同意したものとみなします。
          </p>
        </div>
      </section>


      <%# 発効日 %>
      <div class="pt-2 border-t border-gray-100 dark:border-gray-800">
        <p class="text-xs text-gray-400 dark:text-gray-600 text-right">
          本規約は2026年3月12日より有効です。
        </p>
      </div>

    </div>
  </div>

</div>
