<%# app/views/pages/others.html.erb %>
<div class="flex flex-col h-full -mx-4 -my-6">

  <%# ヘッダー：border-gray-100 → border-gray-200 %>
  <div class="shrink-0 sticky top-0 z-10
              bg-white/90 dark:bg-gray-900/90 backdrop-blur
              border-b border-gray-200 dark:border-gray-800
              px-5 py-3">
    <div class="max-w-lg mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">その他</span>
      </div>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto px-4 pt-6 pb-12">
    <div class="max-w-lg mx-auto space-y-6">

      <%# 規約・ポリシー セクション %>
      <section class="space-y-3">
        <h2 class="text-base font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          規約・ポリシー
        </h2>

        <%# border-gray-100 → border-gray-200、divide-gray-100 → divide-gray-200 %>
        <div class="bg-white dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl overflow-hidden
                    divide-y divide-gray-200 dark:divide-gray-800">

          <%# 利用規約 %>
          <%= link_to terms_path,
                class: "flex items-center justify-between px-5 py-4
                        hover:bg-gray-50 dark:hover:bg-gray-800/50
                        transition-colors duration-100 group" do %>
            <div class="flex items-center gap-3">
              <%# アイコンコンテナ：ナビゲーション項目なのでグレー系に %>
              <span class="w-8 h-8 rounded-md
                           bg-gray-50 dark:bg-gray-800
                           border border-gray-200 dark:border-gray-700
                           flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-gray-400 dark:text-gray-500"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </span>
              <div>
                <p class="text-sm font-medium text-gray-700 dark:text-gray-200">利用規約</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">Game Exit の利用規約を確認できます</p>
              </div>
            </div>
            <svg class="w-4 h-4 text-gray-300 dark:text-gray-600
                        group-hover:text-gray-400 dark:group-hover:text-gray-400
                        transition-colors duration-100 shrink-0"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>

          <%# プライバシーポリシー %>
          <%= link_to privacy_policy_path,
                class: "flex items-center justify-between px-5 py-4
                        hover:bg-gray-50 dark:hover:bg-gray-800/50
                        transition-colors duration-100 group" do %>
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-md
                           bg-gray-50 dark:bg-gray-800
                           border border-gray-200 dark:border-gray-700
                           flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-gray-400 dark:text-gray-500"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </span>
              <div>
                <p class="text-sm font-medium text-gray-700 dark:text-gray-200">プライバシーポリシー</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">個人情報の取り扱いについて確認できます</p>
              </div>
            </div>
            <svg class="w-4 h-4 text-gray-300 dark:text-gray-600
                        group-hover:text-gray-400 dark:group-hover:text-gray-400
                        transition-colors duration-100 shrink-0"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>

        </div>
      </section>

      <%# サポート セクション %>
      <section class="space-y-3">
        <h2 class="text-base font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          サポート
        </h2>

        <div class="bg-white dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl overflow-hidden">

          <%= link_to new_bug_report_path,
                class: "flex items-center justify-between px-5 py-4
                        hover:bg-gray-50 dark:hover:bg-gray-800/50
                        transition-colors duration-100 group" do %>
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-md
                           bg-gray-50 dark:bg-gray-800
                           border border-gray-200 dark:border-gray-700
                           flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-gray-400 dark:text-gray-500"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </span>
              <div>
                <p class="text-sm font-medium text-gray-700 dark:text-gray-200">不具合報告</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">問題や不具合を報告できます</p>
              </div>
            </div>
            <svg class="w-4 h-4 text-gray-300 dark:text-gray-600
                        group-hover:text-gray-400 dark:group-hover:text-gray-400
                        transition-colors duration-100 shrink-0"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>

        </div>
      </section>

      <%# アカウント セクション %>
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          アカウント
        </h2>

        <div class="bg-white dark:bg-gray-900
                    border border-gray-200 dark:border-gray-800
                    rounded-xl overflow-hidden">
          <div class="px-5 py-4">
            <p class="text-xs text-gray-400 dark:text-gray-500 leading-relaxed mb-4">
              退会するとすべてのデータが完全に削除され、復元することはできません。
              ご注意の上でお手続きください。
            </p>
            <%# 退会ボタン：デストラクティブアクションとして赤を維持 %>
            <%= button_to user_registration_path,
                  method: :delete,
                  data: { turbo_confirm: "本当に退会しますか？\nこの操作は取り消せません。" },
                  class: "flex items-center gap-1.5
                          px-3 py-1.5 rounded-md
                          text-xs text-red-400 dark:text-red-500
                          hover:text-red-600 dark:hover:text-red-400
                          hover:bg-red-50 dark:hover:bg-red-900/20
                          transition-colors duration-100" do %>
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              退会する
            <% end %>
          </div>
        </div>
      </section>

      <%# フッター：border-gray-100 → border-gray-200 %>
      <div class="pt-2 border-t border-gray-200 dark:border-gray-800">
        <p class="text-xs text-gray-400 dark:text-gray-600 text-center">
          Game Exit &copy; <%= Date.current.year %>
        </p>
      </div>

    </div>
  </div>

</div>