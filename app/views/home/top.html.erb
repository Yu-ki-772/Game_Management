<%# app/views/home/top.html.erb %>
<%#
  Vercel 風の変更点：
  - ヒーローセクション：余白を広げ、テキストを大きく、装飾を最小限に
  - ボタン：bg-gray-900/white の単色ボタンに（エメラルドは CTAのみ節制して使う）
  - フィーチャーカード：border-2 → border-1、shadow 廃止、hover は背景色変化のみ
  - h-48 の固定高さを廃止してコンテンツ高さに委ねる
%>

<%# ストップ可能なアラームバナー %>
<% if user_signed_in? && @stoppable_alarms_count&.positive? %>
  <%= link_to pending_alarms_path,
      class: "flex items-center gap-3 w-full px-4 py-3 mb-6
              bg-amber-50 dark:bg-amber-950/50
              border border-amber-200 dark:border-amber-800
              rounded-lg
              text-amber-700 dark:text-amber-400
              hover:bg-amber-100 dark:hover:bg-amber-950
              transition-colors" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M12 9v4" />
      <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214
               a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536
               a1.914 1.914 0 0 0 -3.274 0z" />
      <path d="M12 16h.01" />
    </svg>
    <span class="text-sm font-medium flex-1">
      ストップできるアラームが <%= @stoppable_alarms_count %> 件あります
    </span>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-50">
      <path d="M5 12l14 0" />
      <path d="M15 16l4 -4" />
      <path d="M15 8l4 4" />
    </svg>
  <% end %>
<% end %>

<%# 未ログイン時のヒーローセクション %>
<% unless user_signed_in? %>
  <div class="px-4 py-24 text-center">
    <div class="flex items-center justify-center gap-3 mb-10">
      <%= image_tag "logo_mark.png", class: "h-10" %>
      <%= image_tag "name_logo.png", class: "h-10" %>
    </div>

    <h1 class="text-4xl md:text-6xl font-bold
               text-gray-900 dark:text-white
               tracking-tight mb-6">
      ゲーム時間をスマートに
    </h1>

    <p class="text-lg md:text-xl
              text-gray-500 dark:text-gray-400
              max-w-xl mx-auto mb-10">
      適切なタイミングでのプレイ終了をサポート。
    </p>

    <div class="flex justify-center">
      <%# Vercel 風：白背景では黒ボタン、ダークでは白ボタン %>
      <%= link_to new_user_session_path,
          class: "inline-flex items-center gap-2 px-6 py-2.5
                  bg-gray-900 dark:bg-white
                  text-white dark:text-gray-900
                  text-sm font-semibold rounded-md
                  hover:bg-gray-700 dark:hover:bg-gray-100
                  transition-colors" do %>
        <span>ログイン</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5 12l14 0" />
          <path d="M15 16l4 -4" />
          <path d="M15 8l4 4" />
        </svg>
      <% end %>
    </div>
  </div>
<% end %>

<%# 機能紹介セクション %>
<div class="py-12">

  <%# セクション見出し：Vercel 風のシンプルな区切り %>
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
      Features
    </h2>
    <%# ログイン時のクイックアクションボタン群 %>
    <% if user_signed_in? %>
      <div class="flex items-center gap-2">
        <%= link_to new_alarm_path,
            data: { turbo_frame: "dialog" },
            class: "inline-flex items-center gap-1.5 px-3 py-1.5
                    bg-emerald-600 hover:bg-emerald-700
                    text-white text-xs font-semibold rounded-md
                    transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4v16m8-8H4"/>
          </svg>
          アラームを作成
        <% end %>

        <%= link_to new_diagnosis_result_path,
            class: "inline-flex items-center gap-1.5 px-3 py-1.5
                    bg-white dark:bg-gray-950
                    border border-gray-200 dark:border-gray-800
                    text-gray-700 dark:text-gray-300
                    text-xs font-semibold rounded-md
                    hover:bg-gray-50 dark:hover:bg-gray-900
                    transition-colors" do %>
          診断
        <% end %>
      </div>
    <% end %>
  </div>

  <%# フィーチャーカードグリッド %>
  <%#
    Vercel 風カードの設計：
    - border は1px の細線のみ（border-2 を廃止）
    - shadow なし（ボーダーだけで区切る）
    - hover は背景色の微妙な変化のみ
    - 固定高さ h-48 を廃止してコンテンツに委ねる
    - アイコンカラーはエメラルドを維持（ブランドの一貫性）
  %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">

    <%= link_to alarms_path, class: "block group" do %>
      <div class="h-full border border-gray-200 dark:border-gray-800 rounded-lg p-5
                  bg-white dark:bg-gray-950
                  hover:bg-gray-50 dark:hover:bg-gray-900
                  hover:border-gray-300 dark:hover:border-gray-700
                  transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             class="text-emerald-600 dark:text-emerald-500 mb-4">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5 13a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
          <path d="M12 10l0 3l2 0" />
          <path d="M7 4l-2.75 2" />
          <path d="M17 4l2.75 2" />
        </svg>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">
          アラーム
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
          終了予定時刻を設定。
        </p>
      </div>
    <% end %>

    <%= link_to pending_alarms_path, class: "block group" do %>
      <div class="h-full border border-gray-200 dark:border-gray-800 rounded-lg p-5
                  bg-white dark:bg-gray-950
                  hover:bg-gray-50 dark:hover:bg-gray-900
                  hover:border-gray-300 dark:hover:border-gray-700
                  transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             class="text-emerald-600 dark:text-emerald-500 mb-4">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7.587 7.566a7 7 0 1 0 9.833 9.864m1.35 -2.645a7 7 0 0 0 -8.536 -8.56" />
          <path d="M12 12v1h1" />
          <path d="M5.261 5.265l-1.011 .735" />
          <path d="M17 4l2.75 2" />
          <path d="M3 3l18 18" />
        </svg>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">
          アラームをストップ
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          アラームをストップして記録を作成。
        </p>
      </div>
    <% end %>

    <%= link_to alarm_logs_path, class: "block group" do %>
      <div class="h-full border border-gray-200 dark:border-gray-800 rounded-lg p-5
                  bg-white dark:bg-gray-950
                  hover:bg-gray-50 dark:hover:bg-gray-900
                  hover:border-gray-300 dark:hover:border-gray-700
                  transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             class="text-emerald-600 dark:text-emerald-500 mb-4">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" />
          <path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
          <path d="M9 17v-4" />
          <path d="M12 17v-1" />
          <path d="M15 17v-2" />
        </svg>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">
          記録
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          プレイ時間の節制の記録確認。
        </p>
      </div>
    <% end %>

    <%= link_to message_templates_path, class: "block group" do %>
      <div class="h-full border border-gray-200 dark:border-gray-800 rounded-lg p-5
                  bg-white dark:bg-gray-950
                  hover:bg-gray-50 dark:hover:bg-gray-900
                  hover:border-gray-300 dark:hover:border-gray-700
                  transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             class="text-emerald-600 dark:text-emerald-500 mb-4">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 11v.01" />
          <path d="M8 11v.01" />
          <path d="M16 11v.01" />
          <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3l12 0" />
        </svg>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">
          定型文
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray.400">
          終了したい時、ゲーム仲間へのメッセージを考える手間を省略。
        </p>
      </div>
    <% end %>

    <%= link_to new_diagnosis_result_path, class: "block group" do %>
      <div class="h-full border border-gray-200 dark:border-gray-800 rounded-lg p-5
                  bg-white dark:bg-gray-950
                  hover:bg-gray-50 dark:hover:bg-gray-900
                  hover:border-gray-300 dark:hover:border-gray-700
                  transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             class="text-emerald-600 dark:text-emerald-500 mb-4">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M9 11l3 3l8 -8" />
          <path d="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9" />
        </svg>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">
          ゲーム時間管理度診断
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          ゲームとの関わり方を4つの軸で振り返り、より充実したゲームライフへ。
        </p>
      </div>
    <% end %>

  </div>
</div>