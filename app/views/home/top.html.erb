<% unless user_signed_in? %>
  <div class="px-4 py-16 text-center">
    <div class="flex items-center justify-center gap-4 mb-8">
      <%# アイコンロゴ %>
      <%= image_tag "logo_mark.png", class: "h-12" %>
      
      <%# テキストロゴ %>
      <%= image_tag "name_logo.png", class: "h-12" %>
    </div>
    
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
      ゲーム時間をスマートに
    </h1>
    
    <div class="max-w-2xl mx-auto">
      <p class="text-lg md:text-xl text-gray-600 mb-8">
        適切なタイミングでのプレイ終了をサポート。
      </p>
      
      <div class="flex justify-center">
        <%= link_to new_user_session_path, 
            class: "inline-flex items-center gap-3 px-8 py-3 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition text-lg font-semibold shadow-sm" do %>
          <span>ログイン</span>
          <%# 矢印マーク %>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M5 12l14 0" />
            <path d="M15 16l4 -4" />
            <path d="M15 8l4 4" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%# 機能紹介セクション %>
<div class="py-12">
  <h2 class="text-2xl md:text-3xl font-bold pb-4 border-b-2 border-emerald-500 mb-8">Features</h2>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    <%= link_to alarms_path, class: "block group" do %>
      <div class="border-2 border-gray-200 rounded-lg p-6 hover:border-emerald-500 bg-white hover:shadow-lg transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5 13a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
          <path d="M12 10l0 3l2 0" />
          <path d="M7 4l-2.75 2" />
          <path d="M17 4l2.75 2" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
          アラーム
        </h3>
        <p class="text-sm md:text-base text-gray-600 mb-3">
          終了予定時刻を設定。
        </p>
        <p class="text-emerald-600 text-xs md:text-sm">
          ※ 通知はメールで送信されます
        </p>
      </div>
    <% end %>

    <%= link_to pending_alarms_path, class: "block group" do %>
      <div class="border-2 border-gray-200 rounded-lg p-6 hover:border-emerald-500 bg-white hover:shadow-lg transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7.587 7.566a7 7 0 1 0 9.833 9.864m1.35 -2.645a7 7 0 0 0 -8.536 -8.56" />
          <path d="M12 12v1h1" />
          <path d="M5.261 5.265l-1.011 .735" />
          <path d="M17 4l2.75 2" />
          <path d="M3 3l18 18" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
          アラームをストップ
        </h3>
        <p class="text-sm md:text-base text-gray-600">
          アラームをストップして記録を作成。
        </p>
      </div>
    <% end %>

    <%= link_to alarm_logs_path, class: "block group" do %>
      <div class="border-2 border-gray-200 rounded-lg p-6 hover:border-emerald-500 bg-white hover:shadow-lg transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" />
          <path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
          <path d="M9 17v-4" />
          <path d="M12 17v-1" />
          <path d="M15 17v-2" />
          <path d="M12 17v-1" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
          記録
        </h3>
        <p class="text-sm md:text-base text-gray-600">
          プレイ時間の節制の記録確認。
        </p>
      </div>
    <% end %>

    <%= link_to message_templates_path, class: "block group" do %>
      <div class="border-2 border-gray-200 rounded-lg p-6 hover:border-emerald-500 bg-white hover:shadow-lg transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 11v.01" />
          <path d="M8 11v.01" />
          <path d="M16 11v.01" />
          <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3l12 0" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
          定型文
        </h3>
        <p class="text-sm md:text-base text-gray-600">
          終了したい時、ゲーム仲間へのメッセージを考える手間を省略。
        </p>
      </div>
    <% end %>

    <%# 振り返りメモ %>
    <%= link_to reflection_notes_path, class: "block group" do %>
      <div class="border-2 border-gray-200 rounded-lg p-6 hover:border-emerald-500 bg-white hover:shadow-lg transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18" />
          <path d="M13 8l2 0" />
          <path d="M13 12l2 0" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
          振り返りメモ
        </h3>
        <p class="text-sm md:text-base text-gray-600">
          時間管理の振り返りをメモ。
        </p>
      </div>
    <% end %>

  </div>
</div>
