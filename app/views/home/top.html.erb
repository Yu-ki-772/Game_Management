<%# app/views/home/top.html.erb %>

<%# ストップ可能なアラームがあるときだけバナーを表示 %>
<% if user_signed_in? && @stoppable_alarms_count&.positive? %>
  <%= link_to pending_alarms_path,
      class: "flex items-center gap-3 w-full px-4 py-3 mb-6
              bg-amber-50 dark:bg-amber-900/30
              border border-amber-300 dark:border-amber-700
              rounded-lg
              text-amber-700 dark:text-amber-300
              hover:bg-amber-100 dark:hover:bg-amber-900/50
              transition" do %>

    <%# 警告アイコン %>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
         viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="shrink-0">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M12 9v4" />
      <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214
               a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536
               a1.914 1.914 0 0 0 -3.274 0z" />
      <path d="M12 16h.01" />
    </svg>

    <span class="font-semibold text-sm flex-1">
      ストップできるアラームが <%= @stoppable_alarms_count %> 件あります。
    </span>

    <%# 右矢印アイコン %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
         viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="shrink-0">
      <path d="M5 12l14 0" />
      <path d="M15 16l4 -4" />
      <path d="M15 8l4 4" />
    </svg>
  <% end %>
<% end %>

<%# 未ログイン時のヒーローセクション %>
<% unless user_signed_in? %>
  <div class="px-4 py-16 text-center">
    <div class="flex items-center justify-center gap-4 mb-8">
      <%# アイコンロゴ %>
      <%= image_tag "logo_mark.png", class: "h-12" %>
      <%# テキストロゴ %>
      <%= image_tag "name_logo.png", class: "h-12" %>
    </div>

    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-6">
      ゲーム時間をスマートに
    </h1>

    <div class="max-w-2xl mx-auto">
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-8">
        適切なタイミングでのプレイ終了をサポート。
      </p>

      <div class="flex justify-center">
        <%= link_to new_user_session_path,
            class: "inline-flex items-center gap-3 px-8 py-3 bg-emerald-600 text-white
                    rounded-lg hover:bg-emerald-700 transition text-lg font-semibold shadow-sm" do %>
          <span>ログイン</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M5 12l14 0" />
            <path d="M15 16l4 -4" />
            <path d="M15 8l4 4" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%# 機能紹介セクション %>
<div class="py-12">
  <h2 class="text-2xl md:text-3xl font-bold pb-4 border-b-2 border-emerald-500
             text-gray-900 dark:text-gray-100 mb-8">
    Features
  </h2>

  <%# ログイン時のみアラーム作成・振り返りメモ作成ボタンを表示 %>
  <% if user_signed_in? %>
    <div class="flex flex-wrap gap-3 mb-8">
      <%= link_to new_alarm_path,
          class: "inline-flex items-center gap-3 px-6 py-3 bg-emerald-600 text-white
                  rounded-lg hover:bg-emerald-700 transition font-semibold shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5 13a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
          <path d="M12 10l0 3l2 0" />
          <path d="M7 4l-2.75 2" />
          <path d="M17 4l2.75 2" />
        </svg>
        <span>アラームを作成</span>
      <% end %>

      <%= link_to new_reflection_note_path,
          class: "inline-flex items-center gap-3 px-6 py-3 bg-emerald-600 text-white
                  rounded-lg hover:bg-emerald-700 transition font-semibold shadow-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-notebook">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18" />
          <path d="M13 8l2 0" />
          <path d="M13 12l2 0" />
        </svg>
        <span>振り返りメモを作成</span>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    <%= link_to alarms_path, class: "block group" do %>
      <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6
                  hover:border-emerald-500 dark:hover:border-emerald-500
                  bg-white dark:bg-gray-800
                  hover:shadow-lg dark:hover:shadow-gray-900/50
                  transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 dark:text-emerald-400 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5 13a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
          <path d="M12 10l0 3l2 0" />
          <path d="M7 4l-2.75 2" />
          <path d="M17 4l2.75 2" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          アラーム
        </h3>
        <p class="text-sm md:text-base text-gray-600 dark:text-gray-400 mb-3">
          終了予定時刻を設定。
        </p>
        <p class="text-emerald-600 dark:text-emerald-400 text-xs md:text-sm">
          ※ 通知はメールで送信されます
        </p>
      </div>
    <% end %>

    <%= link_to pending_alarms_path, class: "block group" do %>
      <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6
                  hover:border-emerald-500 dark:hover:border-emerald-500
                  bg-white dark:bg-gray-800
                  hover:shadow-lg dark:hover:shadow-gray-900/50
                  transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 dark:text-emerald-400 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7.587 7.566a7 7 0 1 0 9.833 9.864m1.35 -2.645a7 7 0 0 0 -8.536 -8.56" />
          <path d="M12 12v1h1" />
          <path d="M5.261 5.265l-1.011 .735" />
          <path d="M17 4l2.75 2" />
          <path d="M3 3l18 18" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          アラームをストップ
        </h3>
        <p class="text-sm md:text-base text-gray-600 dark:text-gray-400">
          アラームをストップして記録を作成。
        </p>
      </div>
    <% end %>

    <%= link_to alarm_logs_path, class: "block group" do %>
      <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6
                  hover:border-emerald-500 dark:hover:border-emerald-500
                  bg-white dark:bg-gray-800
                  hover:shadow-lg dark:hover:shadow-gray-900/50
                  transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 dark:text-emerald-400 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" />
          <path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
          <path d="M9 17v-4" />
          <path d="M12 17v-1" />
          <path d="M15 17v-2" />
          <path d="M12 17v-1" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          記録
        </h3>
        <p class="text-sm md:text-base text-gray-600 dark:text-gray-400">
          プレイ時間の節制の記録確認。
        </p>
      </div>
    <% end %>

    <%= link_to message_templates_path, class: "block group" do %>
      <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6
                  hover:border-emerald-500 dark:hover:border-emerald-500
                  bg-white dark:bg-gray-800
                  hover:shadow-lg dark:hover:shadow-gray-900/50
                  transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 dark:text-emerald-400 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 11v.01" />
          <path d="M8 11v.01" />
          <path d="M16 11v.01" />
          <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3l12 0" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          定型文
        </h3>
        <p class="text-sm md:text-base text-gray-600 dark:text-gray-400">
          終了したい時、ゲーム仲間へのメッセージを考える手間を省略。
        </p>
      </div>
    <% end %>

    <%= link_to reflection_notes_path, class: "block group" do %>
      <div class="border-2 border-gray-200 dark:border-gray-700 rounded-lg p-6
                  hover:border-emerald-500 dark:hover:border-emerald-500
                  bg-white dark:bg-gray-800
                  hover:shadow-lg dark:hover:shadow-gray-900/50
                  transition h-48">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 dark:text-emerald-400 mb-3">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18" />
          <path d="M13 8l2 0" />
          <path d="M13 12l2 0" />
        </svg>
        <h3 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          振り返りメモ
        </h3>
        <p class="text-sm md:text-base text-gray-600 dark:text-gray-400">
          時間管理の振り返りをメモ。
        </p>
      </div>
    <% end %>
  </div>
</div>