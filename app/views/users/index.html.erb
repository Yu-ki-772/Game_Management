<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">
    ユーザー一覧
  </h1>
  
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
    <p class="text-blue-800">
      <% if params[:q].present? %>
        検索結果: <span class="font-semibold"><%= @search_count %></span>件
      
      <% end %>
    </p>
  </div>
  
  <%= search_form_for @q, url: users_path, method: :get,
      html: { class: 'bg-white shadow-md rounded-lg p-6 mb-8' } do |f| %>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div>
        <%= f.label :name_cont, 'ユーザネーム', 
            class: 'block text-sm font-medium text-gray-700 mb-2' %>
        <%= f.search_field :name_cont, 
            placeholder: '例: 山田太郎',
            class: 'w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500' %>
      </div>
    </div>
    
    <div class="flex space-x-3">
      <%= f.submit '検索',
          class: 'px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %>
      <%= link_to 'クリア', users_path,
          class: 'px-6 py-2 bg-gray-200 text-gray-700 font-medium rounded-lg hover:bg-gray-300' %>
    </div>
  <% end %>

  <%# ページネーション用 %>
  <div class="mt-8">
    <%== @pagy.series_nav %>
  </div>
  
  <div class="space-y-4">
    <% if @users.any? %>
      <% @users.each do |user| %>
        <% next if user == current_user %>
        
        <% pending_request_from_user = @pending_requests_hash[user.uuid] %>
        <% existing_friendship = @friendships_hash[user.uuid] %>
        
        
        <div class="bg-white shadow-md rounded-lg overflow-hidden hover:shadow-lg transition-shadow duration-200">
          <div class="flex items-center p-4">
            <%= link_to user_path(user), class: "flex items-center flex-1 min-w-0" do %>
              <div class="flex-shrink-0">
                <% if user.avatar.attached? %>
                  <%= image_tag user.avatar.variant(resize_to_fill: [80, 80]), 
                                class: "h-20 w-20 rounded-full object-cover border-2 border-gray-200" %>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" /></svg>
  
                <% end %>
              </div>
              
              <div class="ml-4 flex-1 min-w-0">
                <h3 class="text-lg font-semibold text-gray-900 truncate">
                  <%= user.name %>
                </h3>
              
              </div>
            <% end %>
            
            <div class="flex-shrink-0 ml-4">
              <% if pending_request_from_user.present? %>
                <%= button_to "フレンド申請を承認", 
                              friendship_path(pending_request_from_user),
                              method: :patch,
                              params: { action_type: 'accept' },
                              class: "px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors duration-200"
                              %>
              
              <% elsif existing_friendship.nil? %>
                <%= button_to "フレンド申請", 
                              friendships_path,
                              method: :post,
                              params: { friend_uuid: user.uuid },
                              class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200"
                               %>
              
              <% else %>
                <% if existing_friendship&.accepted? %>
                  <span class="px-4 py-2 bg-green-100 text-green-800 text-sm font-medium rounded-lg">
                    フレンドです
                  </span>
                <% elsif existing_friendship&.user_uuid == current_user.uuid %>
                  <span class="px-4 py-2 bg-blue-100 text-blue-800 text-sm font-medium rounded-lg">
                    申請済み
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      
    <% else %>
      <div class="bg-white shadow-md rounded-lg p-12 text-center">
        <p class="text-gray-500">
          検索条件に一致するユーザーが見つかりませんでした
        </p>
      </div>
    <% end %>
  </div>
  
  <%# ページネーション用 %>
  <div class="mt-8">
    <%== @pagy.series_nav %>
  </div>
</div>