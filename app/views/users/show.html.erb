<%# app/views/users/show.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%# 戻るリンク：ホバーは emerald ではなくグレー系に %>
  <%= link_to request.referer || users_path,
        class: "inline-flex items-center gap-1 text-base
                text-gray-700 dark:text-gray-500
                hover:text-gray-700 dark:hover:text-gray-300
                transition-colors duration-100 mb-6" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    戻る
  <% end %>

  <%# セクション区切り：border トークンを統一 %>
  <div class="pb-5 border-b border-gray-200 dark:border-gray-800 mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">プロフィール</h1>
  </div>

  <%# カード：shadow-sm 削除、bg・border をトークンに合わせる %>
  <div class="bg-white dark:bg-gray-900 rounded-xl
              border border-gray-300 dark:border-gray-800
              p-6 max-w-lg">

    <%# アバター + 名前 %>
    <div class="flex items-center gap-5 mb-6">
      <div class="shrink-0">
        <% if @user.avatar_image? %>
          <%= image_tag @user.avatar,
              class: "w-20 h-20 rounded-full object-cover
                      border border-gray-200 dark:border-gray-800" %>
        <% else %>
          <%# アバターSVGをヘッダーと統一（頭+肩パス、stroke-width="2"） %>
          <div class="w-20 h-20 rounded-full
                      bg-gray-50 dark:bg-gray-800
                      border border-gray-200 dark:border-gray-800
                      flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"
                 class="text-gray-400 dark:text-gray-500">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
              <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
            </svg>
          </div>
        <% end %>
      </div>

      <div class="flex-1 min-w-0">
        <p class="text-xl font-bold text-gray-900 dark:text-gray-100 truncate">
          <%= @user.name %>
        </p>
        <% if @user == current_user %>
          <p class="text-sm text-gray-500 dark:text-gray-500 truncate">
            <%= @user.email %>
          </p>
        <% end %>
      </div>
    </div>

    <%# 自己紹介：bg・rounded をトークンに合わせる %>
    <% if @user.description.present? %>
      <div class="bg-gray-50 dark:bg-gray-800 rounded-md px-4 py-3 mb-6
                  border border-gray-200 dark:border-gray-800">
        <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <%= @user.description %>
        </p>
      </div>
    <% end %>

    <%# アクションボタン：border・rounded・bg をトークンに合わせる %>
    <div class="pt-4 border-t border-gray-200 dark:border-gray-800">
      <% if @user == current_user %>
        <%# セカンダリボタンパターン %>
        <%= link_to edit_user_registration_path,
            class: "inline-flex items-center gap-2 px-4 py-1.5
                    bg-white dark:bg-gray-950
                    hover:bg-gray-100 dark:hover:bg-gray-900
                    text-gray-600 dark:text-gray-300
                    text-base font-semibold rounded-md
                    border border-gray-200 dark:border-gray-800
                    transition-colors duration-100" do %>
          編集
        <% end %>

      <% else %>
        <div id="friendship_action_<%= @user.uuid %>">
          <%= render 'users/friendship_action',
              user: @user,
              pending_request_from_user: @pending_request_from_user,
              existing_friendship: @existing_friendship %>
        </div>
      <% end %>
    </div>

  </div>
</div>