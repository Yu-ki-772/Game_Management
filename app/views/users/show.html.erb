<%# app/views/users/show.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%# 戻るリンク %>
  <%= link_to request.referer || users_path,
        class: "inline-flex items-center gap-1 text-sm text-gray-400 dark:text-gray-500
                hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors mb-6" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    戻る
  <% end %>

  <div class="pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">プロフィール</h1>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 max-w-lg">

    <%# アバター + 名前 %>
    <div class="flex items-center gap-5 mb-6">
      <div class="shrink-0">
        <% if @user.avatar_image? %>
          <%= image_tag @user.avatar,
              class: "w-20 h-20 rounded-full object-cover border border-gray-200 dark:border-gray-600" %>
        <% else %>
          <div class="w-20 h-20 rounded-full bg-gray-100 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                 class="text-gray-400 dark:text-gray-500">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
              <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
              <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
            </svg>
          </div>
        <% end %>
      </div>

      <div class="flex-1 min-w-0">
        <p class="text-lg font-bold text-gray-900 dark:text-gray-100 truncate"><%= @user.name %></p>
        <% if @user == current_user %>
          <p class="text-sm text-gray-400 dark:text-gray-500 truncate"><%= @user.email %></p>
        <% end %>
      </div>
    </div>

    <%# 自己紹介 %>
    <% if @user.description.present? %>
      <div class="bg-gray-50 dark:bg-gray-700 rounded-lg px-4 py-3 mb-6">
        <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed"><%= @user.description %></p>
      </div>
    <% end %>

    <%# アクションボタン等 %>
    <div class="pt-4 border-t border-gray-100 dark:border-gray-700">
      <% if @user == current_user %>
        <%= link_to edit_user_registration_path,
            class: "inline-flex items-center gap-2 px-5 py-2
                    bg-white dark:bg-gray-700
                    hover:bg-gray-50 dark:hover:bg-gray-600
                    text-gray-600 dark:text-gray-300
                    text-sm font-semibold rounded-lg
                    border border-gray-200 dark:border-gray-600 transition" do %>
          編集
        <% end %>

      <% else %>
        <div id="friendship_action_<%= @user.uuid %>">
          <%= render 'users/friendship_action',
          user: @user,
          pending_request_from_user: @pending_request_from_user,
          existing_friendship: @existing_friendship %>
        </div>
      <% end %>
    </div>

  </div>
</div>