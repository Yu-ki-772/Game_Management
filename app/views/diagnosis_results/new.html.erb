<%# app/views/diagnosis/new.html.erb %>
<div data-controller="diagnosis-form" class="flex flex-col h-full -mx-4 -my-6">

  <%= form_with url: diagnosis_results_path, method: :post,
        id: "diagnosis-form",
        class: "flex-1 overflow-y-auto px-4 pt-6 pb-6 space-y-4" do |f| %>

    <%# 戻るリンク %>
    <div>
      <%= link_to root_path,
          class: "inline-flex items-center gap-1.5 text-sm
                  text-gray-400 dark:text-gray-500
                  hover:text-gray-700 dark:hover:text-gray-200
                  transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        ホームに戻る
      <% end %>
    </div>

    <%# ── ページヘッダー ── %>
    <div class="pb-5 border-b border-gray-200 dark:border-gray-800">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
        ゲーム時間管理度診断
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-500 mt-1">
        全8問・1〜2分で完了します
      </p>
    </div>

    <%# リード文 %>
    <div class="bg-white dark:bg-gray-950
                border border-gray-200 dark:border-gray-800
                rounded-xl px-5 py-4">
      <p class="text-base text-gray-500 dark:text-gray-400 leading-relaxed">
        この診断では、あなたのゲームとの関わり方を4つの軸で振り返ります。
        直感で正直に答えてください。
      </p>
    </div>

    <% axis_badge_class = "inline-flex items-center gap-1.5 text-lg font-semibold
                           text-gray-600 dark:text-gray-400
                           bg-gray-100 dark:bg-gray-800
                           border border-gray-200 dark:border-gray-700
                           px-2.5 py-1 rounded-full" %>

    <%# 軸① やめる力 %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="<%= axis_badge_class %>">🎮 軸① やめる力</span>
      </div>
      <%= render "question", qnum: "Q1", name: "answers[q1]",
            text: "プレイをやめようと決めたとき、実際にやめられることが多いですか？" %>
    </div>

    <%# 軸② 生活への影響 %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="<%= axis_badge_class %>">🌿 軸② 生活への影響</span>
      </div>
      <%= render "question", qnum: "Q2", name: "answers[q2]",
            text: "ゲームが原因で、十分な睡眠が取れなかったと感じることがありますか？" %>
      <%= render "question", qnum: "Q3", name: "answers[q3]",
            text: "勉強・仕事・家事など、やるべきことへの支障が出ていると感じることがありますか？" %>
      <%= render "question", qnum: "Q4", name: "answers[q4]",
            text: "ゲーム中に、食事や休憩を後回しにしてしまうことがありますか？" %>
    </div>

    <%# 軸③ プレイの充実度 %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="<%= axis_badge_class %>">⭐ 軸③ プレイの充実度</span>
      </div>
      <%= render "question", qnum: "Q5", name: "answers[q5]",
            text: "ゲームを終えた後、満足感や達成感を感じることが多いですか？" %>
      <%= render "question", qnum: "Q6", name: "answers[q6]",
            text: "特にやりたいゲームがなくても、なんとなくゲームを起動することがありますか？" %>
    </div>

    <%# 軸④ 振り返り力 %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="<%= axis_badge_class %>">🎯 軸④ 振り返り力</span>
      </div>
      <%= render "question", qnum: "Q7", name: "answers[q7]",
            text: "自分がどのくらいの頻度・時間ゲームをしているか、おおよそ把握できていると思いますか？" %>
      <%= render "question", qnum: "Q8", name: "answers[q8]",
            text: "ゲームを終えた後、今日どのくらいプレイしたか意識することがありますか？" %>
    </div>

    <p class="text-center text-sm text-gray-600 dark:text-gray-600 leading-relaxed">
      回答はあなたのゲームライフ改善のためにのみ使用されます。
    </p>

  <% end %>

  <%# フッター %>
  <div class="shrink-0 bg-white/90 dark:bg-gray-900/90 backdrop-blur
              border-t border-gray-200 dark:border-gray-800
              px-4 py-3">
    <div class="max-w-lg mx-auto space-y-2">

      <div class="flex items-center gap-2">
        <div class="flex-1 h-1.5 bg-gray-100 dark:bg-gray-800 rounded-full">
          <div data-diagnosis-form-target="bar"
               class="h-full rounded-full transition-all duration-300
                      bg-emerald-400 dark:bg-emerald-500"
               style="width: 0%"></div>
        </div>
        <span data-diagnosis-form-target="footerCounter"
              class="text-base tabular-nums text-gray-600 dark:text-gray-500 shrink-0">
          0 / 8
        </span>
      </div>

      <button type="submit"
              form="diagnosis-form"
              disabled
              data-diagnosis-form-target="submit"
              data-turbo-submits-with="診断中..."
              class="w-full px-4 py-3 text-base font-semibold rounded-md
                     bg-gray-900 dark:bg-white
                     text-white dark:text-gray-900
                     hover:bg-gray-700 dark:hover:bg-gray-300
                     disabled:opacity-60 disabled:cursor-not-allowed
                     transition-colors duration-100">
        診断結果を見る
      </button>

    </div>
  </div>

</div>