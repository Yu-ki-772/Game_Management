<%# app/views/diagnosis_results/new.html.erb %>
<div data-controller="diagnosis-form" class="flex flex-col h-full -mx-4 -my-6">

  <%# ヘッダー %>
  <div class="shrink-0 sticky top-0 z-10
                 bg-white/90 dark:bg-gray-900/90 backdrop-blur
                 border-b border-gray-100 dark:border-gray-800
                 px-5 py-3">
    <div class="max-w-lg mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <%= link_to root_path,
              class: "w-8 h-8 flex items-center justify-center rounded-md
                      text-gray-400 dark:text-gray-500
                      hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">ゲーム時間診断</span>
      </div>
      <span data-diagnosis-form-target="counter"
            class="text-xs tabular-nums text-gray-400 dark:text-gray-500">
        0 / 10 回答済み
      </span>
    </div>
  </div>


  <%# ── メインフォーム ──────────────────────────────────────────────── %>
  <%= form_with url: diagnosis_results_path, method: :post,
        id: "diagnosis-form",
        class: "flex-1 overflow-y-auto px-4 pt-6 pb-6 space-y-4" do |f| %>

    <%# リード文 %>
    <div class="bg-white dark:bg-gray-900
                border border-gray-100 dark:border-gray-800
                rounded-2xl px-5 py-4">
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
        この診断では、あなたのゲームとの関わり方を4つの軸で振り返ります。
        直感で正直に答えてください。全10問、2〜3分で完了します。
      </p>
    </div>


    <%# ── 軸① コントロール感 ────────────────────────────────────── %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold
                     text-emerald-600 dark:text-emerald-400
                     bg-emerald-50 dark:bg-emerald-900/30
                     border border-emerald-200 dark:border-emerald-800
                     px-2.5 py-1 rounded-full">
          🎮 軸① コントロール感
        </span>
      </div>
      <%= render "question", qnum: "Q1", name: "answers[q1]",
            text: "プレイをやめようと思ったとき、予定通りにやめられていますか？" %>
      <%= render "question", qnum: "Q2", name: "answers[q2]",
            text: "「あと少しだけ」と思って、プレイを延長してしまうことがありますか？" %>
    </div>


    <%# ── 軸② 生活統合度 ────────────────────────────────────────── %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold
                     text-emerald-600 dark:text-emerald-400
                     bg-emerald-50 dark:bg-emerald-900/30
                     border border-emerald-200 dark:border-emerald-800
                     px-2.5 py-1 rounded-full">
          🌿 軸② 生活統合度
        </span>
      </div>
      <%= render "question", qnum: "Q3", name: "answers[q3]",
            text: "ゲームが原因で、十分な睡眠が取れなかったと感じることがありますか？" %>
      <%= render "question", qnum: "Q4", name: "answers[q4]",
            text: "勉強・仕事・家事など、日常のやるべきことに影響が出ていると感じることがありますか？" %>
      <%= render "question", qnum: "Q5", name: "answers[q5]",
            text: "大切な人（家族・友人など）と過ごす時間が、以前と比べて減ったと感じることがありますか？" %>
    </div>


    <%# ── 軸③ プレイの質 ────────────────────────────────────────── %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold
                     text-emerald-600 dark:text-emerald-400
                     bg-emerald-50 dark:bg-emerald-900/30
                     border border-emerald-200 dark:border-emerald-800
                     px-2.5 py-1 rounded-full">
          ⭐ 軸③ プレイの質
        </span>
      </div>
      <%= render "question", qnum: "Q6", name: "answers[q6]",
            text: "ゲームを終えた後、満足感や達成感を感じることが多いですか？" %>
      <%= render "question", qnum: "Q7", name: "answers[q7]",
            text: "特にやりたいゲームがなくても、なんとなくゲームを起動することがありますか？" %>
      <%= render "question", qnum: "Q8", name: "answers[q8]",
            text: "気分が落ち込んでいるときやストレスを感じているとき、それを紛らわすことが主な目的でゲームを起動することがありますか？" %>
    </div>


    <%# ── 軸④ 自己認識の一致度 ──────────────────────────────────── %>
    <div class="space-y-3">
      <div class="flex items-center gap-2 px-1">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold
                     text-emerald-600 dark:text-emerald-400
                     bg-emerald-50 dark:bg-emerald-900/30
                     border border-emerald-200 dark:border-emerald-800
                     px-2.5 py-1 rounded-full">
          🎯 軸④ 自己認識の一致度
        </span>
      </div>
      <%= render "question", qnum: "Q9", name: "answers[q9]",
            text: "プレイを始める前に決めた時間通りに、ゲームを終えられることが多いですか？" %>
      <%= render "question", qnum: "Q10", name: "answers[q10]",
            text: "プレイ時間が、自分の想定より大幅に長くなることがありますか？" %>
    </div>


    <p class="text-center text-xs text-gray-400 dark:text-gray-600 leading-relaxed">
      回答はあなたのゲームライフ改善のためにのみ使用されます。
    </p>

  <% end %>


  <%# ── フッター（進捗バー + 送信ボタン） ──────────────────────── %>
  <div class="shrink-0 bg-white/90 dark:bg-gray-900/90 backdrop-blur
              border-t border-gray-100 dark:border-gray-800
              px-4 py-3">
    <div class="max-w-lg mx-auto space-y-2">

      <div class="flex items-center gap-2">
        <div class="flex-1 h-1.5 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
          <div data-diagnosis-form-target="bar"
               class="h-full bg-emerald-400 dark:bg-emerald-500 rounded-full transition-all duration-300"
               style="width: 0%"></div>
        </div>
        <span data-diagnosis-form-target="footerCounter"
              class="text-xs tabular-nums text-gray-400 dark:text-gray-500 shrink-0">
          0 / 10
        </span>
      </div>

      <button type="submit"
              form="diagnosis-form"
              disabled
              data-diagnosis-form-target="submit"
              data-turbo-submits-with="診断中..."
              class="w-full px-4 py-3 text-sm font-semibold rounded-xl
                    text-white bg-emerald-500
                    disabled:opacity-60 disabled:cursor-not-allowed">
        診断結果を見る
      </button>

    </div>
  </div>

</div>
