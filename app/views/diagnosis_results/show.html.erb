<%# app/views/diagnosis_results/show.html.erb %>
<div>
  <main class="max-w-lg mx-auto px-4 py-6 space-y-3">

    <%# 戻るリンク %>
    <div>
      <%= link_to root_path,
          class: "inline-flex items-center gap-1.5 text-base
                  text-gray-600 dark:text-gray-500
                  transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        ホームに戻る
      <% end %>
    </div>

    <%# ── ページヘッダー ── %>
    <div class="pb-5 border-b border-gray-200 dark:border-gray-800">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
        診断結果
      </h1>
    </div>

    <%# ── ① スコアサマリーカード %>
    <div class="<%= zone_bg_class(@result) %> <%= zone_border_class(@result) %>
                border rounded-xl px-5 py-6">
      <span class="text-lg text-gray-700 dark:text-gray-500">総合スコア</span>
      <div class="flex items-baseline gap-1 mt-1 mb-3">
        <span class="text-7xl font-bold tabular-nums <%= zone_text_class(@result) %>">
          <%= @result.total_score %>
        </span>
        <span class="text-base text-gray-500 dark:text-gray-500">/ 100</span>
      </div>
      <span class="inline-flex items-center gap-1.5 w-fit text-base font-semibold
                   <%= zone_text_class(@result) %>
                   bg-white dark:bg-gray-900
                   <%= zone_border_class(@result) %> border
                   px-2.5 py-1 rounded-full">
        <span class="w-2 h-2 rounded-full <%= zone_dot_class(@result) %>"></span>
        <%= zone_label(@result) %>
      </span>
    </div>

    <%# ── ② 軸別スコア %>
    <div class="bg-white dark:bg-gray-900
                border border-gray-200 dark:border-gray-800
                rounded-xl px-5 py-4 space-y-4">
      <h2 class="text-xl font-medium text-gray-700 dark:text-gray-300">軸別スコア</h2>
      <% @result.axis_items.each do |axis| %>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-lg text-gray-700 dark:text-gray-300">
              <%= axis[:icon] %> <%= axis[:name] %>
            </span>
            <span class="text-base font-medium tabular-nums <%= zone_text_class(@result) %>">
              <%= axis[:score] %> / 25
            </span>
          </div>
          <div class="h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
            <div class="h-full <%= zone_bar_class(@result) %> rounded-full"
                 style="width: <%= (axis[:score] / 25.0 * 100).round %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <%# ── ③ 総評メッセージ %>
    <div class="bg-white dark:bg-gray-900
                border border-gray-200 dark:border-gray-800
                rounded-xl px-5 py-4 space-y-2">
      <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">
        <%= zone_headline(@result) %>
      </h2>
      <p class="text-base text-gray-500 dark:text-gray-400 leading-relaxed">
        <%= zone_message(@result) %>
      </p>
    </div>

    <%# ── ④ レッドゾーン警告 %>
    <% if @result.red? %>
      <div class="bg-red-50 dark:bg-red-900/20
                  border border-red-200 dark:border-red-900
                  rounded-xl px-5 py-4">
        <p class="text-base text-red-500 dark:text-red-400 leading-relaxed">
          ⚠ この診断は医療的な診断ではありません。
          心配な場合は、学校のカウンセラー・かかりつけ医・信頼できる大人への相談を検討してください。
        </p>
      </div>
    <% end %>

    <%# ── Xシェアボタン（診断結果がレッドゾーン以外の場合のみ表示）── %>
    <% unless @result.red? %>
      <%= link_to x_share_url_for_diagnosis(@result),
            target: "_blank",
            rel: "noopener noreferrer",
            class: "flex items-center justify-center gap-2 w-full py-2.5
                    bg-gray-900 dark:bg-white
                    hover:bg-gray-700 dark:hover:bg-gray-200
                    text-white dark:text-gray-900
                    text-base font-normal rounded-xl transition-colors" do %>
        <%= image_tag "x_logo_for_light.png", class: "h-4 hidden dark:block" %>
        <%= image_tag "x_logo_for_dark.png",  class: "h-4 dark:hidden" %>
        <span>でシェア</span>
      <% end %>
    <% end %>

    <%# ── アクションボタン %>
    <div class="flex gap-2">
      <%= link_to new_diagnosis_result_path,
            class: "flex-1 px-3 py-2.5 text-sm font-medium rounded-md border
                    text-center transition-colors duration-100
                    text-gray-800 dark:text-gray-400
                    border-gray-200 dark:border-gray-800
                    hover:bg-gray-100 dark:hover:bg-gray-800/50" do %>
        もう一度診断
      <% end %>
      <%= link_to root_path,
            class: "flex-1 px-3 py-2.5 text-sm font-medium rounded-md border
                    text-center transition-colors duration-100
                    text-gray-800 dark:text-gray-400
                    border-gray-200 dark:border-gray-800
                    hover:bg-gray-100 dark:hover:bg-gray-800/50" do %>
        ホームに戻る
      <% end %>
    </div>

  </main>
</div>