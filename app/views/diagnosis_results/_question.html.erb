<div class="bg-white dark:bg-gray-900
            border border-gray-200 dark:border-gray-800
            rounded-xl px-5 py-4 space-y-3">

  <div class="space-y-1">
    <span class="text-sm font-bold text-gray-500 dark:text-gray-500 tabular-nums">
      <%= qnum %>
    </span>
    <p class="text-base font-semibold text-gray-800 dark:text-gray-100 leading-relaxed">
      <%= text %>
    </p>
  </div>

  <div class="space-y-2">
    <% [[1, "ほぼいつも"], [2, "よくある"], [3, "たまにある"], [4, "あまりない"], [5, "ほとんどない"]].each do |value, label| %>
      <label class="group flex items-center gap-3 px-4 py-2.5
                    rounded-md border border-gray-200 dark:border-gray-800
                    bg-white dark:bg-gray-900
                    text-base text-gray-600 dark:text-gray-400
                    hover:border-gray-300 dark:hover:border-gray-700
                    hover:bg-gray-50 dark:hover:bg-gray-800/50
                    cursor-pointer transition-colors duration-150
                    has-[:checked]:bg-emerald-50 dark:has-[:checked]:bg-emerald-900/30
                    has-[:checked]:border-emerald-400 dark:has-[:checked]:border-emerald-700
                    has-[:checked]:text-emerald-600 dark:has-[:checked]:text-emerald-400">

        <%= radio_button_tag name, value, false,
              class: "sr-only",
              data: { action: "change->diagnosis-form#onSelect" } %>

        <%# 選択済み状態はエメラルドで表示 %>
        <span class="shrink-0 w-5 h-5 rounded-full border-2
                     border-gray-200 dark:border-gray-700
                     group-has-[:checked]:bg-emerald-400
                     group-has-[:checked]:border-emerald-400
                     flex items-center justify-center">
          <svg class="hidden group-has-[:checked]:block w-3 h-3 text-white"
               fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
          </svg>
        </span>

        <span><%= label %></span>
      </label>
    <% end %>
  </div>

</div>