<%# app/views/shared/_friendships_navigation.html.erb %>
<nav class="mb-4 sm:mb-6
            bg-white dark:bg-gray-950
            rounded-xl
            border border-gray-200 dark:border-gray-800
            p-1 flex gap-0.5">

  <%# フレンド %>
  <%= link_to friendships_path,
      class: "flex-shrink-0 flex items-center justify-center gap-1.5
              px-3 sm:px-3.5 py-2 rounded-md text-sm font-medium
              transition-colors duration-100
              #{current_page?(friendships_path) ?
                'bg-gray-900 dark:bg-white text-white dark:text-gray-900' :
                'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857
               M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857
               m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>
    <span class="hidden sm:inline">フレンド</span>
  <% end %>

  <%# 受信申請 %>
  <%= link_to pending_friendships_path,
      class: "flex-shrink-0 flex items-center justify-center gap-1.5
              px-3 sm:px-3.5 py-2 rounded-md text-sm font-medium
              transition-colors duration-100
              #{current_page?(pending_friendships_path) ?
                'bg-gray-900 dark:bg-white text-white dark:text-gray-900' :
                'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>
    <span class="hidden sm:inline">受信申請</span>
    <% if @pending_friendship_count&.positive? %>
      <span class="inline-flex items-center justify-center shrink-0
                   w-4 h-4 text-[10px] font-bold
                   text-white bg-red-500 rounded-full ring-2
                   #{current_page?(pending_friendships_path) ?
                     'ring-gray-900 dark:ring-white' :
                     'ring-white dark:ring-gray-950'}">
        <%= @pending_friendship_count > 9 ? "9+" : @pending_friendship_count %>
      </span>
    <% end %>
  <% end %>

  <%# ユーザー検索 %>
  <%= link_to users_path,
      class: "flex-shrink-0 flex items-center justify-center gap-1.5
              px-3 sm:px-3.5 py-2 rounded-md text-sm font-medium
              transition-colors duration-100
              #{current_page?(users_path) ?
                'bg-gray-900 dark:bg-white text-white dark:text-gray-900' :
                'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-800 dark:hover:text-gray-200'}" do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
         stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
      <path d="M16 19h6" />
      <path d="M19 16v6" />
      <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
    </svg>
    <span class="hidden sm:inline">ユーザー検索</span>
  <% end %>

</nav>