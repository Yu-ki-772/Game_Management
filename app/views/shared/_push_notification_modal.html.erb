<div id="push-notification-modal"
     data-controller="push-notification"
     data-push-notification-vapid-public-key-value="<%= ENV['VAPID_PUBLIC_KEY'] %>"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/20">

  <div class="bg-white rounded-lg shadow-xl p-6 w-80 max-w-full mx-4">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">
      通知の許可が必要です
    </h2>
    <p class="text-sm text-gray-600 mb-6">
      アラームの時間になったらブラウザで通知をお届けします。
      アラーム機能を使うには、通知を許可してください。
    </p>

    <button data-action="click->push-notification#subscribe"
            class="w-full px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition mb-2">
      通知を許可する
    </button>

    <button data-action="click->push-notification#closeModal"
            class="w-full px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition">
      後で
    </button>
  </div>
</div>