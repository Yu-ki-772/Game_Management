<%# app/views/shared/_push_notification_modal.html.erb %>
<div id="push-notification-modal"
     data-controller="push-notification"
     data-push-notification-vapid-public-key-value="<%= ENV['VAPID_PUBLIC_KEY'] %>"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/20">

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl p-6 w-80 max-w-full mx-4">
    <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-2">
      通知の許可が必要です
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
      アラームの時間になったらブラウザで通知をお届けします。
      アラーム機能を使うには、通知を許可してください。
    </p>

    <button data-action="click->push-notification#subscribe"
            class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition mb-2">
      通知を許可する
    </button>

    <button data-action="click->push-notification#closeModal"
            class="w-full px-4 py-2
                   bg-gray-100 dark:bg-gray-700
                   hover:bg-gray-200 dark:hover:bg-gray-600
                   text-gray-700 dark:text-gray-300
                   text-sm font-medium rounded-lg transition">
      後で
    </button>
  </div>
</div>