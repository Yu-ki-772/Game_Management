<%# app/views/shared/_push_notification_modal.html.erb %>
<div id="push-notification-modal"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 dark:bg-black/50">

  <div class="bg-white dark:bg-gray-900
              rounded-xl
              border border-gray-200 dark:border-gray-800
              p-6 w-80 max-w-full mx-4">

    <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-2">
      通知の許可が必要です
    </h2>
    <p class="text-base text-gray-700 dark:text-gray-500 mb-6">
      アラームの時間になったらブラウザで通知をお届けします。
      アラーム機能を使うには、通知を許可してください。
    </p>

    <div data-controller="push-notification"
         data-push-notification-vapid-public-key-value="<%= ENV['VAPID_PUBLIC_KEY'] %>"
         class="space-y-2">

      <%# id が必要な理由：subscribe() 完了後に hideElement("push-subscribe-btn") が
          このIDで要素を探して非表示にするため。idがないと購読後もボタンが残り続ける。 %>
      <button id="push-subscribe-btn"
              data-push-notification-target="subscribeBtn"
              data-action="click->push-notification#subscribe"
              class="w-full px-4 py-2 rounded-md
                     text-base font-semibold
                     text-white dark:text-gray-900
                     bg-gray-900 dark:bg-white
                     hover:bg-gray-700 dark:hover:bg-gray-300
                     transition-colors">
        通知をオンにする
      </button>

      <%# 赤は「緊急・エラー」として意味論的に正当 %>
      <p id="push-not-supported"
         class="hidden text-sm text-red-500 dark:text-red-400 leading-relaxed">
        現在の環境ではプッシュ通知を有効にできません。iOSでプッシュ通知を有効にしたい場合は、このアプリをホーム画面に追加してください。
      </p>

      <button data-action="click->push-notification#closeModal"
              class="w-full px-4 py-2 rounded-md
                     text-sm font-medium
                     text-gray-700 dark:text-gray-300
                     bg-white dark:bg-gray-950
                     border border-gray-200 dark:border-gray-800
                     hover:bg-gray-100 dark:hover:bg-gray-900
                     transition-colors">
        後で
      </button>

    </div>
  </div>
</div>