<%# app/views/shared/_footer.html.erb %>

<% if user_signed_in? %>
  <!-- ログイン時フッタ（各メニューにアクティブリンクを設定済み） -->
  <footer class="bg-white dark:bg-black
                 border-t border-gray-200 dark:border-gray-800
                 sticky bottom-0 z-50
                 transition-colors duration-200">
    <div class="container mx-auto px-2 max-w-7xl">
      <nav class="flex items-start justify-around pt-2 pb-5 pb-safe max-w-md mx-auto">

        <%# ── HOME ── %>
        <%= link_to root_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md
                    text-sm font-medium transition-colors
                    #{nav_link_class_for(paths: [root_path])}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
            <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
            <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
          </svg>
          <span>HOME</span>
        <% end %>

        <%# ── アラーム ── %>
        <%= link_to alarms_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md
                    text-sm font-medium transition-colors
                    #{nav_link_class_for(controllers: ['alarms', 'alarm_memberships'])}" do %>
          <div class="relative">
            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M5 13a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
              <path d="M12 10l0 3l2 0" />
              <path d="M7 4l-2.75 2" />
              <path d="M17 4l2.75 2" />
            </svg>
            <% if @stoppable_alarms_count&.positive? %>
              <span class="absolute -top-1 -right-1 flex items-center justify-center
                          h-4 w-4 rounded-full bg-red-500 text-white text-[10px] font-bold">
                <%= @stoppable_alarms_count > 9 ? "9+" : @stoppable_alarms_count %>
              </span>
            <% end %>
          </div>
          <span>アラーム</span>
        <% end %>

        <%# ── 記録 ── %>
        <%= link_to statistic_alarm_logs_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md
                    text-sm font-medium transition-colors
                    #{nav_link_class_for(controllers: ['alarm_logs'])}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" />
            <path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
            <path d="M9 17v-4" />
            <path d="M12 17v-1" />
            <path d="M15 17v-2" />
          </svg>
          <span>記録</span>
        <% end %>

        <%# ── 定型文 ── %>
        <%= link_to message_templates_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md
                    text-sm font-medium transition-colors
                    #{nav_link_class_for(controllers: ['message_templates'])}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M12 11v.01" />
            <path d="M8 11v.01" />
            <path d="M16 11v.01" />
            <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3l12 0" />
          </svg>
          <span>定型文</span>
        <% end %>

        <%# ── フレンド ── %>
        <%= link_to friendships_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md
                    text-sm font-medium transition-colors
                    #{nav_link_class_for(controllers: ['friendships'], paths: [users_path])}" do %>
          <div class="relative">
            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
              <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
            </svg>
            <% if @pending_friendship_count&.positive? %>
              <span class="absolute -top-1 -right-1 flex items-center justify-center
                          h-4 w-4 rounded-full bg-red-500 text-white text-[10px] font-bold">
                <%= @pending_friendship_count > 9 ? "9+" : @pending_friendship_count %>
              </span>
            <% end %>
          </div>
          <span>フレンド</span>
        <% end %>

      </nav>
    </div>
  </footer>

<% else %>
  <%# ── ログイン前フッター ── %>
  <footer class="bg-white dark:bg-black
                border-t border-gray-100 dark:border-gray-900
                transition-colors duration-200">
    <div class="max-w-lg mx-auto px-5 pt-4 pb-6 pb-safe
                flex flex-col items-center gap-2">
      <nav class="flex items-center gap-1">
        <%= link_to privacy_policy_path,
            class: "text-base text-gray-600 dark:text-gray-600
                    px-3 py-2 rounded-md
                    hover:bg-gray-100 dark:hover:bg-gray-900
                    transition-colors" do %>
          プライバシーポリシー
        <% end %>
        <%= link_to terms_path,
            class: "text-base text-gray-600 dark:text-gray-600
                    px-3 py-2 rounded-md
                    hover:bg-gray-100 dark:hover:bg-gray-900
                    transition-colors" do %>
          利用規約
        <% end %>
      </nav>
      <p class="text-sm text-gray-500 dark:text-gray-700">
        &copy; <%= Date.current.year %> Game Exit
      </p>
    </div>
  </footer>
<% end %>