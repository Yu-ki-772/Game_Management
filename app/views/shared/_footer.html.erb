<%# app/views/shared/_footer.html.erb %>
<!-- ログイン時のみ -->
<% if user_signed_in? %>
  <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700
                sticky bottom-0 z-50 shadow-[0_-1px_3px_rgba(0,0,0,0.05)]
                transition-colors duration-200">
    <div class="container mx-auto px-4 max-w-7xl">
      <nav class="flex items-center justify-around h-16">
        <%= link_to root_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md text-xs font-medium transition #{nav_link_class(root_path)}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
            <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
            <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
          </svg>
          <span>HOME</span>
        <% end %>

        <div data-controller="dropdown" class="relative">
          <button
            type="button"
            data-action="click->dropdown#toggle"
            class="flex flex-col items-center gap-1 px-3 py-2 rounded-md text-xs font-medium transition <%= dropdown_button_class([alarms_path, pending_alarms_path]) %>"
          >
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M5 13a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                <path d="M12 10l0 3l2 0" />
                <path d="M7 4l-2.75 2" />
                <path d="M17 4l2.75 2" />
              </svg>
              <%# ストップ可能なアラームがある場合のみバッジを表示 %>
              <% if @stoppable_alarms_count&.positive? %>
                <span class="absolute -top-1 -right-1 flex items-center justify-center h-4 w-4 rounded-full bg-red-500 text-white text-xs font-bold leading-none">
                  <%= @stoppable_alarms_count > 9 ? "9+" : @stoppable_alarms_count %>
                </span>
              <% end %>
            </div>
            <span>アラーム</span>
          </button>
          <%# ドロップダウン %>
          <div
            data-dropdown-target="menu"
            class="hidden absolute bottom-full left-0 mb-2 w-56 rounded-lg shadow-xl
                  bg-white dark:bg-gray-800
                  border border-gray-100 dark:border-gray-700
                  z-50 overflow-hidden">
            <div class="divide-y divide-gray-100 dark:divide-gray-700">
              <%= link_to alarms_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(alarms_path)} flex items-center gap-2" do %>
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                </svg>
                アラーム一覧
              <% end %>

              <%= link_to calendar_alarms_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(calendar_alarms_path)} flex items-center gap-2" do %>
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                カレンダー
              <% end %>

              <%= link_to pending_alarms_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(pending_alarms_path)} flex items-center justify-between" do %>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  アラームをストップ
                </div>
                <%# ストップ可能なアラームがある場合のみバッジを表示 %>
                <% if @stoppable_alarms_count&.positive? %>
                  <span class="flex items-center justify-center h-5 min-w-5 px-1 rounded-full bg-red-500 text-white text-xs font-bold">
                    <%= @stoppable_alarms_count > 9 ? "9+" : @stoppable_alarms_count %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <%# 記録 & 振り返りをまとめたドロップダウン %>
        <div data-controller="dropdown" class="relative">
          <button
            type="button"
            data-action="click->dropdown#toggle"
            class="flex flex-col items-center gap-1 px-3 py-2 rounded-md text-xs font-medium transition <%= dropdown_button_class([alarm_logs_path, reflection_notes_path]) %>"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" />
              <path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
              <path d="M9 17v-4" />
              <path d="M12 17v-1" />
              <path d="M15 17v-2" />
            </svg>
            <span>記録</span>
          </button>

          <%# ドロップダウン %>
          <div
            data-dropdown-target="menu"
            class="hidden absolute bottom-full left-0 mb-2 w-56 rounded-lg shadow-xl
                  bg-white dark:bg-gray-800
                  border border-gray-100 dark:border-gray-700
                  z-50 overflow-hidden">
            <div class="divide-y divide-gray-100 dark:divide-gray-700">

              <%# アラーム記録 %>
              <%= link_to alarm_logs_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(alarm_logs_path)} flex items-center gap-2" do %>
                <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-4M12 17v-1M15 17v-2" />
                </svg>
                アラーム記録
              <% end %>

              <%# 振り返りメモ %>
              <%= link_to reflection_notes_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(reflection_notes_path)} flex items-center gap-2" do %>
                <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 8l2 0M13 12l2 0" />
                </svg>
                振り返りメモ
              <% end %>

            </div>
          </div>
        </div>

        <%= link_to message_templates_path,
            class: "flex flex-col items-center gap-1 px-3 py-2 rounded-md text-xs font-medium transition #{nav_link_class(message_templates_path)}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M12 11v.01" />
            <path d="M8 11v.01" />
            <path d="M16 11v.01" />
            <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3l12 0" />
          </svg>
          <span>定型文</span>
        <% end %>

        <div data-controller="dropdown" class="relative">
          <button
            type="button"
            data-action="click->dropdown#toggle"
            class="flex flex-col items-center gap-1 px-3 py-2 rounded-md text-xs font-medium transition <%= dropdown_button_class([friendships_path, pending_friendships_path, users_path]) %>"
          >
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
              </svg>
              <%# フレンド申請の受信がある場合のみバッジを表示 %>
              <% if @pending_friendship_count&.positive? %>
                <span class="absolute -top-1 -right-1 flex items-center justify-center h-4 w-4 rounded-full bg-red-500 text-white text-xs font-bold leading-none">
                  <%= @pending_friendship_count > 9 ? "9+" : @pending_friendship_count %>
                </span>
              <% end %>
            </div>
            <span>フレンド</span>
          </button>
          <%# ドロップダウン %>
          <div
            data-dropdown-target="menu"
            class="hidden absolute bottom-full right-0 mb-2 w-56 max-w-[calc(100vw-2rem)] rounded-lg shadow-xl
                  bg-white dark:bg-gray-800
                  border border-gray-100 dark:border-gray-700
                  z-50 overflow-hidden">
            <div class="divide-y divide-gray-100 dark:divide-gray-700">
              <%= link_to friendships_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(friendships_path)} flex items-center gap-2" do %>
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                フレンド一覧
              <% end %>

              <%= link_to pending_friendships_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(pending_friendships_path)} flex items-center justify-between" do %>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                  </svg>
                  受信申請
                </div>
                <% if @pending_friendship_count&.positive? %>
                  <span class="flex items-center justify-center h-5 min-w-5 px-1 rounded-full bg-red-500 text-white text-xs font-bold">
                    <%= @pending_friendship_count > 9 ? "9+" : @pending_friendship_count %>
                  </span>
                <% end %>
              <% end %>

              <%= link_to users_path,
                  data: { action: "dropdown#close" },
                  class: "#{dropdown_item_class(users_path)} flex items-center gap-2" do %>
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                  <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                  <path d="M16 19h6" />
                  <path d="M19 16v6" />
                  <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
                </svg>
                ユーザー検索
              <% end %>
            </div>
          </div>
        </div>

      </nav>
    </div>
  </footer>
<% end %>