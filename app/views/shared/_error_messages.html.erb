<%# バリデーションエラー表示用のパーシャル %>
<% if object.errors.any? %>
  <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3" role="alert">
    <ul class="space-y-1">
      <% object.errors.full_messages.each do |message| %>
        <li class="text-xs text-red-600"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>