<%# app/views/shared/_header.html.erb %>
<header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700
               sticky top-0 z-50 shadow-sm transition-colors duration-200"
        data-controller="mobile-menu">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex items-center justify-between h-16">
      <div>
        <%= link_to root_path, class: "flex items-center no-underline" do %>
          <%# アイコンロゴ %>
          <%= image_tag "logo_mark.png", class: "h-8" %>
        <% end %>
      </div>

      <%# 右側: Xシェアボタン + テーマ切り替えボタン + ユーザーメニュー %>
      <div class="flex items-center gap-3">
        <%= link_to x_share_url,
            target: "_blank",
            rel: "noopener noreferrer",
            title: "Xでシェア",
            class: "p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition" do %>
          <%# ライトモード用 %>
          <%= image_tag "x_logo_for_light.png",
                class: "h-4 opacity-60 dark:hidden" %>

          <%# ダークモード用 %>
          <%= image_tag "x_logo_for_dark.png",
                class: "h-4 opacity-60 hidden dark:block" %>
        <% end %>
        <%# サイクルトグル %>
        <button
          data-action="click->theme#cycleTheme"
          data-theme-target="toggleButton"
          aria-label="テーマを切り替える"
          title="テーマを切り替える"
          class="p-2 rounded-lg text-gray-400 hover:text-gray-600
                 dark:text-gray-400 dark:hover:text-gray-200
                 hover:bg-gray-100 dark:hover:bg-gray-700
                 transition-colors duration-200">
          <span data-theme-target="icon" class="leading-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
              <path d="M12 3v18" />
              <path d="M12 14l7 -7" />
              <path d="M12 19l8.5 -8.5" />
              <path d="M12 9l4.5 -4.5" />
            </svg>
          </span>
        </button>

        <% if user_signed_in? %>
          <div data-controller="dropdown" class="relative">
            <button
              type="button"
              data-action="click->dropdown#toggle"
              class="flex items-center gap-2 p-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition"
            >
              <% if current_user.avatar_image? %>
                <%= image_tag current_user.avatar,
                              class: "rounded-full w-9 h-9 object-cover border-2 border-gray-200 dark:border-gray-600" %>
              <% else %>
                <div class="w-9 h-9 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500 dark:text-gray-300">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                  </svg>
                </div>
              <% end %>
            </button>
            <%# ドロップダウン %>
            <div
              data-dropdown-target="menu"
              class="hidden origin-top-right absolute right-0 mt-2 w-48 rounded-lg shadow-xl
                     bg-white dark:bg-gray-800
                     border border-gray-100 dark:border-gray-700
                     z-50 overflow-hidden"
            >
              <div class="divide-y divide-gray-100 dark:divide-gray-700">

                <%= link_to user_path(current_user),
                    data: { action: "dropdown#close" },
                    class: "flex items-center gap-2 px-4 py-2 text-sm
                            text-gray-700 dark:text-gray-200
                            hover:bg-gray-50 dark:hover:bg-gray-700 transition" do %>
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  プロフィール
                <% end %>

                <%= link_to notification_setting_path,
                    data: { action: "dropdown#close" },
                    class: "flex items-center gap-2 px-4 py-2 text-sm
                            text-gray-700 dark:text-gray-200
                            hover:bg-gray-50 dark:hover:bg-gray-700 transition" do %>
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                  </svg>
                  通知設定
                <% end %>

                <%= button_to destroy_user_session_path,
                    method: :delete,
                    data: { action: "dropdown#close" },
                    class: "flex items-center gap-2 w-full text-left px-4 py-2 text-sm
                            text-red-700 dark:text-red-400
                            hover:bg-red-50 dark:hover:bg-red-900/30 transition" do %>
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                  </svg>
                  ログアウト
                <% end %>

              </div>
            </div>
          </div>
        <% else %>
          <%# 非ログイン時の表示 %>
          <%= link_to 'ログイン', new_user_session_path,
              class: "px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md
                      hover:bg-emerald-700 transition" %>
        <% end %>
      </div>
    </div>
  </div>
</header>