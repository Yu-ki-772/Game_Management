<header class="bg-emerald-700 text-white">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between py-4">
      <%= link_to root_path, class: "flex items-center no-underline" do %>
        <%# アイコンロゴ %>
        <%= image_tag "logo_mark.png", class: "h-10" %>
      <% end %>
      
      <div class="flex items-center gap-6">
        <%# Xでシェアするボタン %>
        <%= link_to x_share_url, 
            target: "_blank", 
            rel: "noopener noreferrer",
            title: "Xでシェア",
            class: "hover:scale-105 transition" do %>
          <%= image_tag "x_logo.png", class: "h-5" %>
        <% end %>

        <% if user_signed_in? %>
          <!-- ログイン中の表示 -->
          <div data-controller="dropdown" class="relative">
            <button 
              type="button" 
              data-action="click->dropdown#toggle"
              class="flex items-center space-x-2 px-4 py-2 rounded hover:bg-emerald-600 transition"
            >
              <% if current_user.avatar_image? %>
                <div>
                  <%= image_tag current_user.avatar.variant(resize_to_fill: [64, 64]), 
                                class: "rounded-full w-10 h-10 object-cover border-2 border-gray-300" %>
                </div>
              <% end %>
            </button>
            <div
              data-dropdown-target="menu"
              class="hidden transition transform origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5"
            >
              <div class="py-1">
                <%= link_to user_path(current_user), 
                    data: { action: "dropdown#close" },
                    class: "block px-4 py-2 text-gray-700 hover:bg-emerald-50 transition" do %>
                  プロフィール
                <% end %>
                <%= button_to destroy_user_session_path, 
                    method: :delete,
                    data: { action: "dropdown#close" },
                    class: "block w-full text-left px-4 py-2 text-gray-700 hover:bg-emerald-50 transition" do %>
                  ログアウト
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <!-- 非ログイン時の表示 -->
          <div>
            <%= link_to 'ログイン', new_user_session_path, 
                class: "px-4 py-2 bg-white text-emerald-700 rounded hover:bg-emerald-50 transition font-semibold" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>