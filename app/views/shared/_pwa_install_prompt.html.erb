<%# app/views/shared/_pwa_install_prompt.html.erb %>
<div id="pwa-install-modal"
     data-controller="pwa-install"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 dark:bg-black/50">

  <div class="bg-white dark:bg-gray-900
              rounded-xl
              border border-gray-200 dark:border-gray-800
              p-6 w-80 sm:w-96 max-w-full mx-4">

    <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-1">
      アラーム通知をより確実に受け取るために
    </h2>
    <p class="text-base text-gray-700 dark:text-gray-500 mb-6">
      ホーム画面に追加すると、アプリを開いていないときでも通知が届きます。
    </p>

    <%# beforeinstallprompt が使えるブラウザ（Chrome・Edge等）向け %>
    <button id="pwa-install-btn"
            data-action="click->pwa-install#install"
            class="hidden w-full px-4 py-2 rounded-md mb-3
                   text-base font-semibold
                   text-white dark:text-gray-900
                   bg-gray-900 dark:bg-white
                   hover:bg-gray-700 dark:hover:bg-gray-300
                   transition-colors">
      ホーム画面に追加する
    </button>

    <%# Safari等、beforeinstallprompt が使えないブラウザ向けの手順案内 %>
    <div id="pwa-manual-guide"
         class="hidden mb-4
                rounded-md
                border border-gray-200 dark:border-gray-800
                bg-gray-50 dark:bg-gray-800
                px-4 py-3 space-y-2">
      <p class="text-base text-gray-700 dark:text-gray-300">
        <span class="text-lg font-semibold">iOS：</span>Safariの共有ボタン →「ホーム画面に追加」
      </p>
      <p class="text-base text-gray-700 dark:text-gray-300">
        <span class="text-lg font-semibold">Android：</span>Chromeのメニュー →「ホーム画面に追加」
      </p>
      <p class="text-base text-gray-700 dark:text-gray-300">
        <span class="text-lg font-semibold">PC：</span>アドレスバー右端のアイコン →「ホーム画面に追加」
      </p>
      <p class="text-sm text-gray-600 dark:text-gray-400 pt-2 border-t border-gray-200 dark:border-gray-700">
        ※手順が異なる場合は、お使いのブラウザのメニューからお試しください。
      </p>
    </div>

    <%# セカンダリ：ボーダーで区切るパターン %>
    <button data-action="click->pwa-install#close"
            class="w-full px-4 py-2 rounded-md
                   text-sm font-medium
                   text-gray-700 dark:text-gray-300
                   bg-white dark:bg-gray-950
                   border border-gray-200 dark:border-gray-800
                   hover:bg-gray-100 dark:hover:bg-gray-900
                   transition-colors">
      後で
    </button>

  </div>
</div>