<div class="max-w-7xl mx-auto px-4 py-8">

  <div class="pb-5 border-b border-gray-200 mb-8">
    <h1 class="text-2xl font-bold text-gray-900">フレンド一覧</h1>
  </div>

  <%# フレンド申請の通知 %>
  <% if @pending_count > 0 %>
    <%= link_to pending_friendships_path,
        class: "flex items-center gap-3 bg-emerald-50 border border-emerald-200 rounded-lg px-5 py-3 mb-6 hover:bg-emerald-100 transition" do %>
      <span class="inline-flex items-center justify-center w-6 h-6 bg-emerald-600 text-white text-xs font-bold rounded-full shrink-0">
        <%= @pending_count %>
      </span>
      <span class="text-sm text-emerald-700 font-medium">
        件のフレンド申請が届いています。確認しますか？
      </span>
    <% end %>
  <% end %>

  <% if @friends.any? %>

    <p class="text-sm text-gray-500 mb-4">
      <span class="font-semibold text-gray-700"><%= @friends.count %></span> 人のフレンドがいます
    </p>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <ul class="divide-y divide-gray-50">
        <% @friends.each do |friendship| %>
          <% friend = friendship.partner(current_user) %>
          <% next if friend.nil? %>

          <li class="flex items-center gap-4 px-5 py-4 hover:bg-gray-50 transition">

            <%# アバター + 名前 %>
            <%= link_to user_path(friend), class: "flex items-center gap-4 flex-1 min-w-0" do %>
              <div class="shrink-0">
                <% if friend.avatar.attached? %>
                  <%= image_tag friend.avatar,
                      class: "w-12 h-12 rounded-full object-cover border border-gray-200" %>
                <% else %>
                  <div class="w-12 h-12 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                         class="text-gray-400">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                      <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                      <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                    </svg>
                  </div>
                <% end %>
              </div>
              <span class="text-sm font-semibold text-gray-900 truncate"><%= friend.name %></span>
            <% end %>

            <%# 解除ボタン %>
            <%= button_to friendship_path(friendship),
                method: :delete,
                form: { data: { turbo_confirm: "本当に#{friend.name}さんとのフレンド関係を解除しますか？この操作は取り消せません。" } },
                class: "shrink-0 px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded-md border border-red-200 transition" do %>
              解除
            <% end %>

          </li>
        <% end %>
      </ul>
    </div>

  <% else %>

    <%# フレンドがいない場合 %>
    <div class="flex items-center justify-center py-20">
      <div class="max-w-md mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">まだフレンドがいません</h2>
        <p class="text-sm text-gray-500 mb-6">ユーザーを探してフレンド申請を送ってみましょう</p>
        <%= link_to users_path,
            class: "inline-flex items-center gap-2 px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition text-sm font-semibold" do %>
          ユーザーを探す
        <% end %>
      </div>
    </div>

  <% end %>

</div>