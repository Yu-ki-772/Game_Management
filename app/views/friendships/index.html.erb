<!-- app/views/friendships/index.html.erb -->
<div>
  <h1>フレンド一覧</h1>
  
  <% if @pending_count > 0 %>
    <div>
      <%= link_to pending_friendships_path do %>
        <span><%= @pending_count %></span>
        件のフレンド申請が届いています。確認しますか？
      <% end %>
    </div>
  <% end %>

  <% if @friends.any? %>
    <p>
      <%= @friends.count %>人のフレンドがいます
    </p>

    <% @friends.each do |friendship| %>
      <% friend = friendship.partner(current_user) %>
      <% next if friend.nil? %>
      
      <div>
        <%= link_to user_path(friend) do %>
          <div>
            <%# アバター画像 %>
            <div>
              <% if friend.avatar.attached? %>
                <%= image_tag friend.avatar.variant(resize_to_fill: [80, 80]) %>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" /></svg>
              <% end %>
            </div>

            <div>
              <strong><%= friend.name %></strong>
            </div>
          </div>
        <% end %>

        <div>
          <%= button_to "解除", 
                        friendship_path(friendship), 
                        method: :delete,
                        form: { 
                          data: { 
                            turbo_confirm: "本当に#{friend.name}さんとのフレンド関係を解除しますか？この操作は取り消せません。" 
                          } 
                        } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div>
      <p>まだフレンドがいません</p>
      <p>ユーザーを探してフレンド申請を送ってみましょう</p>
      <%= link_to "ユーザーを探す", users_path %>
    </div>
  <% end %>
</div>