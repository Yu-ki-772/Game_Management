<%# app/views/friendships/pending.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <%= render 'shared/friendships_navigation' %>

  <div class="pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">受け取ったフレンド申請</h1>
  </div>

  <% if @pending.any? %>

    <p class="text-sm text-red-600 dark:text-red-400 mb-4">
      <span class="font-semibold"><%= @pending.count %></span> 件の申請が届いています
    </p>

    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <ul class="divide-y divide-gray-50 dark:divide-gray-700">
        <% @pending.each do |pending| %>
          <li class="flex items-center gap-4 px-5 py-4 hover:bg-gray-50 dark:hover:bg-gray-700 transition">

            <%# アバター + 名前 %>
            <%= link_to user_path(pending.user), class: "flex items-center gap-4 flex-1 min-w-0" do %>
              <div class="shrink-0">
                <% if pending.user.avatar.attached? %>
                  <%= image_tag pending.user.avatar,
                      class: "w-12 h-12 rounded-full object-cover border border-gray-200 dark:border-gray-600" %>
                <% else %>
                  <div class="w-12 h-12 rounded-full bg-gray-100 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                         class="text-gray-400 dark:text-gray-500">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                      <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                      <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                    </svg>
                  </div>
                <% end %>
              </div>
              <span class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= pending.user.name %></span>
            <% end %>

            <%# 承認・拒否ボタン %>
            <div class="flex items-center gap-2 shrink-0">
              <%= button_to friendship_path(pending),
                  method: :patch,
                  params: { action_type: 'accept' },
                  class: "px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-md transition cursor-pointer" do %>
                承認
              <% end %>
              <%= button_to friendship_path(pending),
                  method: :patch,
                  params: { action_type: 'reject' },
                  class: "px-3 py-1.5
                          bg-white dark:bg-gray-700
                          hover:bg-gray-50 dark:hover:bg-gray-600
                          text-gray-600 dark:text-gray-300
                          text-xs font-semibold rounded-md
                          border border-gray-200 dark:border-gray-600
                          transition cursor-pointer" do %>
                拒否
              <% end %>
            </div>

          </li>
        <% end %>
      </ul>
    </div>

  <% else %>
    <%# フレンド申請が無い場合 %>

    <div class="flex items-center justify-center py-20">
      <div class="max-w-md mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">フレンド申請はありません</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">ユーザーを探してフレンド申請を送ってみましょう</p>
        <%= link_to users_path,
            class: "inline-flex items-center gap-2 px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition text-sm font-semibold" do %>
          ユーザーを探す
        <% end %>
      </div>
    </div>

  <% end %>

</div>