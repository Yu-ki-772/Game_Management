<!-- app/views/friendships/pending.html.erb -->
<div>
  <h1>受け取ったフレンド申請</h1>
  <% if @pending.any? %>
    <%# 申請がある場合 %>
    <p>
      <%= @pending.count %>件の申請が届いています
    </p>
    <% @pending.each do |pending| %>
      <div>
        <%= link_to user_path(pending.user) do %>
          <div>
            <div>
              <% if pending.user.avatar.attached? %>
                <%= image_tag pending.user.avatar.variant(resize_to_fill: [80, 80]) %>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" /></svg>
              <% end %>
            </div>

            <div>
              <strong><%= pending.user.name %></strong>
            </div>
          </div>
        <% end %>

        <div>
          <%= button_to "承認", 
                        friendship_path(pending), 
                        method: :patch,
                        params: { action_type: 'accept' },
                        class: "cursor-pointer" %>
          <%= button_to "拒否", 
                        friendship_path(pending), 
                        method: :patch,
                        params: { action_type: 'reject' },
                        class: "cursor-pointer" %>
        </div>
      </div>
    <% end %>
    
  <% else %>
    <%# 申請が無い場合 %>
    <div>
      <p>現在、フレンド申請はありません</p>
      <%= link_to "ユーザーを探す", users_path %>
    </div>
  <% end %>
</div>