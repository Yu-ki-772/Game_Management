<%# app/views/friendships/pending.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <%= render 'shared/friendships_navigation' %>

  <%# ── ページヘッダー ── %>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">受け取ったフレンド申請</h1>
    <p class="text-sm mt-1">
      <% if @pending.any? %>
        <span class="font-semibold text-red-500 dark:text-red-400"><%= @pending.count %></span>
        <span class="text-gray-500 dark:text-gray-400">件の申請が届いています</span>
      <% else %>
        <span class="text-gray-400 dark:text-gray-500">現在、届いている申請はありません</span>
      <% end %>
    </p>
  </div>

  <%# ── 申請リスト ── %>
  <div id="pending_list_section">
    <% if @pending.any? %>
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm
                  border border-gray-100 dark:border-gray-700 overflow-hidden">
        <ul class="divide-y divide-gray-50 dark:divide-gray-700/70">
          <% @pending.each do |pending| %>
            <li id="pending_friendship_<%= pending.id %>"
                class="flex items-center gap-4 px-5 py-3.5
                       hover:bg-gray-50/80 dark:hover:bg-gray-700/30
                       transition-colors duration-100">

              <%# アバター + 名前 %>
              <%= link_to user_path(pending.user), class: "flex items-center gap-3 flex-1 min-w-0" do %>
                <div class="shrink-0">
                  <% if pending.user.avatar.attached? %>
                    <%= image_tag pending.user.avatar,
                        class: "w-10 h-10 rounded-full object-cover
                                ring-1 ring-gray-200 dark:ring-gray-600" %>
                  <% else %>
                    <div class="w-10 h-10 rounded-full
                                bg-gray-100 dark:bg-gray-700
                                ring-1 ring-gray-200 dark:ring-gray-600
                                flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400 dark:text-gray-500"
                           viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="1.5"
                           stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                        <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                        <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                      </svg>
                    </div>
                  <% end %>
                </div>
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-100 truncate">
                  <%= pending.user.name %>
                </span>
              <% end %>

              <%# 承認・拒否ボタン %>
              <div class="flex items-center gap-2 shrink-0">
                <%= button_to friendship_path(pending),
                    method: :patch,
                    params: { action_type: 'accept' },
                    class: "px-3.5 py-1.5
                            bg-emerald-500 hover:bg-emerald-600
                            text-white text-xs font-semibold rounded-lg
                            shadow-sm transition-colors duration-100 cursor-pointer" do %>
                  承認
                <% end %>

                <%= button_to friendship_path(pending),
                    method: :patch,
                    params: { action_type: 'reject' },
                    class: "px-3.5 py-1.5 text-xs font-medium rounded-lg
                            text-gray-400 dark:text-gray-500
                            border border-gray-200 dark:border-gray-700
                            hover:text-red-500 dark:hover:text-red-400
                            hover:border-red-200 dark:hover:border-red-800
                            hover:bg-red-50 dark:hover:bg-red-900/20
                            active:bg-red-100
                            transition-colors duration-100 cursor-pointer" do %>
                  拒否
                <% end %>
              </div>

            </li>
          <% end %>
        </ul>
      </div>

    <% else %>
      <%# フレンド申請が無い場合 %>
      <%= render 'pending_empty_state' %>
    <% end %>
  </div>

</div>
