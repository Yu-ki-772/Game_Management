<span id="invite_button_<%= alarm.uuid %>_<%= user.uuid %>">
  <% if membership %>
    <%# 招待済みの場合: 削除ボタンとして表示する %>
    <%= button_to "招待済み",
          alarm_alarm_membership_path(alarm, membership),
          method: :delete,
          class: "px-3 py-1 bg-indigo-50 hover:bg-red-50 hover:text-red-600 text-indigo-600 text-xs font-semibold rounded-md border border-indigo-200 hover:border-red-200 transition" %>
  <% else %>
    <%# 未招待の場合: 作成ボタンとして表示する %>
    <%= button_to "招待する",
          alarm_alarm_memberships_path(alarm),
          params: { user_id: user.uuid },
          method: :post,
          class: "px-3 py-1 bg-gray-50 hover:bg-indigo-50 text-gray-600 hover:text-indigo-600 text-xs font-semibold rounded-md border border-gray-200 hover:border-indigo-200 transition" %>
  <% end %>
</span>