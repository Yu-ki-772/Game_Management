<%# app/views/alarm_memberships/_invite_button.html.erb %>
<span id="invite_button_<%= alarm.uuid %>_<%= user.uuid %>">
  <% if membership %>
    <%#
      招待済みの場合：ブルーで表示し、hover 時に赤へ変化させる。
      「招待済み → 解除」という状態変化を色のグラデーションで表現することで、
      ユーザーが「今何が起きているか / 押したら何が起きるか」を直感的に理解できる。
    %>
    <%= button_to "招待済み",
          alarm_alarm_membership_path(alarm, membership),
          method: :delete,
          data: { turbo_submits_with: "解除中..." },
          class: "px-3 py-1 text-xs font-medium rounded-md
                  border border-blue-200 dark:border-blue-800
                  text-blue-600 dark:text-blue-400
                  bg-white dark:bg-gray-950
                  hover:border-red-200 dark:hover:border-red-900
                  hover:text-red-500 dark:hover:text-red-400
                  hover:bg-red-50 dark:hover:bg-red-950/50
                  transition-colors" %>
  <% else %>
    <%# 未招待の場合：ブルーのボーダースタイルで統一 %>
    <%= button_to "招待する",
          alarm_alarm_memberships_path(alarm),
          params: { user_id: user.uuid },
          method: :post,
          data: { turbo_submits_with: "招待中..." },
          class: "px-3 py-1 text-xs font-medium rounded-md
                  border border-blue-200 dark:border-blue-800
                  text-blue-600 dark:text-blue-400
                  bg-white dark:bg-gray-950
                  hover:bg-blue-50 dark:hover:bg-blue-950/50
                  transition-colors" %>
  <% end %>
</span>