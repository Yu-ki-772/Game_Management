<%# app/views/alarm_memberships/_invite_button.html.erb %>
<span id="invite_button_<%= alarm.uuid %>_<%= user.uuid %>">
  <% if membership %>
    <%# 招待済みの場合: 削除ボタンとして表示する %>
    <%= button_to "招待済み",
          alarm_alarm_membership_path(alarm, membership),
          method: :delete,
          data: { turbo_submits_with: "解除中..." },
          class: "px-3 py-1 
                  bg-indigo-100 dark:bg-indigo-800/60
                  hover:bg-red-50 dark:hover:bg-red-900/30
                  text-indigo-700 dark:text-indigo-300
                  hover:text-red-600 dark:hover:text-red-400
                  text-xs font-semibold rounded-md
                  border border-indigo-300 dark:border-indigo-600
                  hover:border-red-200 dark:hover:border-red-800 transition" %>
  <% else %>
    <%# 未招待の場合: 作成ボタンとして表示する %>
    <%= button_to "招待する",
          alarm_alarm_memberships_path(alarm),
          params: { user_id: user.uuid },
          method: :post,
          data: { turbo_submits_with: "招待中..." },
          class: "px-3 py-1
                  bg-indigo-100 dark:bg-indigo-800/60
                  hover:bg-indigo-200 dark:hover:bg-indigo-700
                  text-indigo-700 dark:text-indigo-300
                  text-xs font-semibold rounded-md
                  border border-indigo-300 dark:border-indigo-600 transition" %>
  <% end %>
</span>