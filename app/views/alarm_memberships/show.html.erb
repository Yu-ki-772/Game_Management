<%# app/views/alarm_memberships/show.html.erb %>
<div class="max-w-lg mx-auto px-4 py-8 space-y-6">

  <%= link_to "← 戻る", request.referer || alarms_path,
        class: "text-sm text-gray-500 dark:text-gray-400 hover:underline" %>

  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden">

    <%# ステータスバー %>
    <% if @membership.notified? %>
      <div class="bg-emerald-500 text-white text-xs font-semibold text-center py-2 tracking-wide">
        ✅ 通知済み
      </div>
    <% else %>
      <div class="bg-blue-500 text-white text-xs font-semibold text-center py-2 tracking-wide">
        ⏳ 待機中
      </div>
    <% end %>

    <div class="px-6 py-6 space-y-6">

      <%# 日時・ラベル %>
      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 font-medium mb-1">アラーム</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-gray-100">
          <%= @alarm.scheduled_at.strftime("%H:%M") %>
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
          <%= @alarm.scheduled_at.strftime("%Y/%m/%d") %>
          （<%= %w[日 月 火 水 木 金 土][@alarm.scheduled_at.wday] %>）
          <% if @alarm.started_at.present? %>
            <span class="ml-1 text-gray-400 dark:text-gray-500">
              <%= @alarm.started_at.strftime("%H:%M") %> 〜
            </span>
          <% end %>
        </p>
        <% if @alarm.label.present? %>
          <p class="mt-2 inline-block text-sm font-medium text-gray-700 dark:text-gray-300
                     bg-gray-100 dark:bg-gray-700 rounded-lg px-3 py-1">
            <%= @alarm.label %>
          </p>
        <% end %>
      </div>

      <% if @alarm.alarm_logs.exists?(user_uuid: current_user.uuid) %>
        <div class="text-center">
          <span class="inline-block text-sm text-emerald-600 font-semibold bg-emerald-50 dark:bg-emerald-900/30 rounded-xl px-5 py-3">
            ✅ あなたはストップ済みです
          </span>
        </div>
      <% else %>
        <%= button_to 'アラームをストップ',
              unlock_alarm_alarm_membership_path(@alarm, @membership),
              method: :patch,
              class: "w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white
                      font-semibold rounded-xl transition text-sm" %>
      <% end %>

      <%# 作成者・メンバー %>
      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 font-medium mb-3">参加者</p>
        <ul class="space-y-2">

          <li class="flex items-center gap-3">
            <% if @creator.avatar.attached? %>
              <%= image_tag @creator.avatar, class: "w-8 h-8 rounded-full object-cover" %>
            <% else %>
              <span class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
              </span>
            <% end %>
            <span class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= @creator.name %></span>
            <span class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-700 rounded px-1.5 py-0.5">作成者</span>
          </li>

          <% @display_members.each do |member| %>
            <li class="flex items-center gap-3">
              <% if member.avatar.attached? %>
                <%= image_tag member.avatar, class: "w-8 h-8 rounded-full object-cover" %>
              <% else %>
                <span class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                  </svg>
                </span>
              <% end %>
              <span class="text-sm text-gray-700 dark:text-gray-300"><%= member.name %></span>
              <% if @alarm.alarm_logs.find_by(user_uuid: member.uuid) %>
                <span class="text-xs text-emerald-600 bg-emerald-50 dark:bg-emerald-900/30 rounded px-1.5 py-0.5">
                  ストップ済み
                </span>
              <% end %>
            </li>
          <% end %>

          <%# 21人目以降は件数だけ表示 %>
          <% if @hidden_count > 0 %>
            <li class="text-xs text-gray-400 dark:text-gray-500 pl-1">
              他 <%= @hidden_count %> 人
            </li>
          <% end %>

        </ul>
      </div>

    </div>
  </div>
</div>