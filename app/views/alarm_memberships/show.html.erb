<%# app/views/alarm_memberships/show.html.erb %>
<div class="max-w-lg mx-auto px-4 py-8 space-y-6">

  <%= link_to request.referer || alarms_path,
      class: "inline-flex items-center gap-1.5 text-base
              text-gray-600 dark:text-gray-500
              dark:hover:text-gray-200
              transition-colors" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    戻る
  <% end %>

  <% expired = @alarm.scheduled_at < Time.current %>

  <div class="bg-white dark:bg-gray-950
              rounded-xl
              border border-gray-200 dark:border-gray-800">

    <%# ステータスバー：通知済み → 時間超過 → 待機中 の順で評価 %>
    <% if expired %>
      <div class="flex items-center justify-center gap-1.5
                  text-base font-semibold text-center py-2 tracking-wide rounded-t-xl
                  bg-red-500 text-white">
        <svg class="w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor"
            viewBox="0 0 24 24" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 9v4"/>
          <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214
                  a1.914 1.914 0 0 0 1.636-2.87l-8.106-13.536
                  a1.914 1.914 0 0 0-3.274 0z"/>
          <path d="M12 16h.01"/>
        </svg>
        時間超過
      </div>
    <% else %>
      <div class="flex items-center justify-center gap-1.5
                  text-base font-semibold text-center py-2 tracking-wide rounded-t-xl
                  bg-gray-900 dark:bg-white text-white dark:text-gray-900">
        <svg class="w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor"
            viewBox="0 0 24 24" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8v4l3 3"/>
          <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/>
        </svg>
        待機中
      </div>
    <% end %>

    <div class="px-6 py-6 space-y-6
                <%= expired ? 'bg-red-50/40 dark:bg-red-950/20' : '' %>
                rounded-b-xl transition-colors duration-100">

      <%# 日時・ラベル：expired を渡して時刻テキストの色を連動させる %>
      <div>
        <%= render "alarm_memberships/alarm_detail", alarm: @alarm, expired: expired %>
      </div>

      <%# ストップ済み or ストップボタン %>
      <% if @alarm.alarm_logs.exists?(user_uuid: current_user.uuid) %>
        <div class="text-center">
          <span class="inline-flex items-center gap-1.5
                       text-base font-semibold
                       text-emerald-600 dark:text-emerald-400
                       bg-emerald-50 dark:bg-emerald-900/20
                       border border-emerald-200 dark:border-emerald-800
                       rounded-lg px-5 py-3">
            ✓ ストップ済み
          </span>
        </div>
      <% else %>
        <% if expired %>
          <%= button_to 'アラームをストップ',
                unlock_alarm_alarm_membership_path(@alarm, @membership),
                method: :patch,
                data: { turbo_submits_with: "ストップ中..." },
                class: "w-full py-3 text-lg font-semibold rounded-lg
                        border border-red-300 dark:border-red-800
                        text-red-500 dark:text-red-400
                        bg-white dark:bg-gray-950
                        hover:bg-red-100 dark:hover:bg-red-950/50
                        transition-colors" %>
        <% else %>
          <% if stoppable?(@alarm) %>
            <%= button_to 'アラームをストップ',
                  unlock_alarm_alarm_membership_path(@alarm, @membership),
                  method: :patch,
                  data: { turbo_submits_with: "ストップ中..." },
                  class: "w-full py-3 text-lg font-semibold rounded-lg
                          bg-gray-900 dark:bg-white
                          text-white dark:text-gray-900
                          hover:bg-gray-700 dark:hover:bg-gray-300
                          transition-colors" %>
          <% else %>
            <span class="inline-flex items-center justify-center
                        rounded-md px-4 py-2
                        text-lg font-medium
                        bg-gray-900 dark:bg-white
                        text-white dark:text-gray-900
                        opacity-40
                        cursor-not-allowed">
              アラームをストップ
            </span>
          <% end %>
          <p class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-500">
            ※ アラーム時刻の前後５時間以内でないとストップできません
          </p>
        <% end %>
      <% end %>

      <%# 作成者向け操作ボタン %>
      <% if @alarm.created_by?(current_user) %>
        <div class="flex items-center justify-end gap-2 pt-2
                    border-t border-gray-100 dark:border-gray-800">
          <%= render "alarm_memberships/invite_dropdown", alarm: @alarm %>

          <%= link_to edit_alarm_path(@alarm),
              data: { turbo_frame: "dialog" },
              class: "px-3 py-1.5 text-sm font-medium rounded-md
                      border border-gray-200 dark:border-gray-800
                      text-gray-600 dark:text-gray-400
                      bg-white dark:bg-gray-950
                      hover:bg-gray-50 dark:hover:bg-gray-900
                      hover:text-gray-900 dark:hover:text-gray-100
                      transition-colors" do %>
            編集
          <% end %>

          <%= button_to alarm_path(@alarm),
              method: :delete,
              data: { turbo_confirm: '本当に削除しますか?',
                      turbo_submits_with: "削除中..." },
              class: "px-3 py-1.5 text-sm font-medium rounded-md
                      border border-red-200 dark:border-red-900
                      text-red-500 dark:text-red-400
                      bg-white dark:bg-gray-950
                      hover:bg-red-50 dark:hover:bg-red-950/50
                      transition-colors" do %>
            削除
          <% end %>
        </div>
      <% end %>

      <%# 参加者リスト %>
      <div class="border-t border-gray-100 dark:border-gray-800 pt-6">
        <p class="text-lg font-medium text-gray-600 dark:text-gray-500 mb-3">
          参加者
        </p>
        <ul class="space-y-2">

          <li class="flex items-center gap-3">
            <% if @creator.avatar.attached? %>
              <%= image_tag @creator.avatar,
                    class: "w-8 h-8 rounded-full object-cover
                            border border-gray-200 dark:border-gray-700" %>
            <% else %>
              <span class="w-8 h-8 rounded-full
                          bg-gray-100 dark:bg-gray-800
                          border border-gray-200 dark:border-gray-700
                          flex items-center justify-center">
                <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
              </span>
            <% end %>

            <%# 名前とバッジをひとつの div にまとめて隣り合わせにする %>
            <div class="flex items-center gap-2 flex-1 min-w-0">
              <span class="text-base font-medium text-gray-900 dark:text-white truncate">
                <%= @creator.name %>
              </span>
              <span class="shrink-0 text-sm text-gray-700 dark:text-gray-400
                          bg-gray-100 dark:bg-gray-800
                          rounded px-1.5 py-0.5">
                作成者
              </span>
            </div>
          </li>

          <% @display_members.each do |member| %>
            <li class="flex items-center gap-3">
              <% if member.avatar.attached? %>
                <%= image_tag member.avatar,
                      class: "w-8 h-8 rounded-full object-cover
                              border border-gray-200 dark:border-gray-700" %>
              <% else %>
                <span class="w-8 h-8 rounded-full
                             bg-gray-100 dark:bg-gray-800
                             border border-gray-200 dark:border-gray-700
                             flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                  </svg>
                </span>
              <% end %>
              <span class="text-base text-gray-700 dark:text-gray-300 flex-1">
                <%= member.name %>
              </span>
              <% if @alarm.alarm_logs.find_by(user_uuid: member.uuid) %>
                <span class="text-xs font-medium
                             text-emerald-600 dark:text-emerald-400
                             bg-emerald-50 dark:bg-emerald-900/20
                             border border-emerald-200 dark:border-emerald-800
                             rounded px-1.5 py-0.5">
                  ストップ済み
                </span>
              <% end %>
            </li>
          <% end %>

          <% if @hidden_count > 0 %>
            <li class="text-sm text-gray-600 dark:text-gray-500 pl-1">
              他 <%= @hidden_count %> 人
            </li>
          <% end %>

        </ul>
      </div>

    </div>
  </div>
</div>