<%# app/views/alarm_memberships/_alarm_detail.html.erb %>
<%#
  show.html.erb から expired を locals で受け取る。
  update.turbo_stream.erb など他の場所から呼ばれる場合は
  expired: false をデフォルトとして扱う。
  expired が true のとき時刻テキストを赤系にして pending 画面と統一する。
%>
<% expired = local_assigns.fetch(:expired, false) %>

<div id="alarm_detail_<%= alarm.id %>">

  <%# 時刻：最も重要な情報なので大きく表示。membership_row の text-base より大きい text-3xl で詳細感を出す。 %>
  <p class="text-4xl font-bold tabular-nums tracking-tight leading-none
             <%= expired ? 'text-red-500 dark:text-red-400' : 'text-gray-900 dark:text-white' %>">
    <% if alarm.started_at.present? %>
      <%= alarm.started_at.strftime("%H:%M") %>
      <span class="text-xl font-normal text-gray-400 dark:text-gray-600 mx-1">–</span>
      <%= alarm.scheduled_at.strftime("%H:%M") %>
    <% else %>
      <%= alarm.scheduled_at.strftime("%H:%M") %>
    <% end %>
  </p>

  <%# 日付：補足情報なので控えめに。membership_row の日付テキストと同じトークン。 %>
  <p class="text-sm font-medium tabular-nums mt-1
            text-gray-500 dark:text-gray-500">
    <%= alarm.scheduled_at.strftime("%Y年%-m月%-d日") %>
    （<%= %w[日 月 火 水 木 金 土][alarm.scheduled_at.wday] %>）
  </p>

  <%# ラベル：bg-gray-700 → bg-gray-800 に統一 %>
  <% if alarm.label.present? %>
    <p class="mt-3 inline-block text-base font-semibold
              text-gray-700 dark:text-gray-300
              bg-gray-100 dark:bg-gray-800
              rounded-lg px-3 py-1.5">
      <%= alarm.label %>
    </p>
  <% end %>

</div>