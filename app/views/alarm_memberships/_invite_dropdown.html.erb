<%# app/views/alarm_memberships/_invite_dropdown.html.erb %>
<div data-controller="dropdown" class="inline-block">

  <button data-action="click->dropdown#toggle"
          class="px-3 py-1.5 text-xs font-medium rounded-md
                 border border-blue-200 dark:border-blue-800
                 text-blue-600 dark:text-blue-400
                 bg-white dark:bg-gray-950
                 hover:bg-blue-50 dark:hover:bg-blue-950/50
                 transition-colors">
    招待
  </button>

  <div data-dropdown-target="menu"
       class="hidden absolute right-0 z-50
              w-72 max-w-[calc(100vw-2rem)]
              bg-white dark:bg-gray-950
              border border-gray-200 dark:border-gray-800
              rounded-lg shadow-lg shadow-black/5 dark:shadow-black/40
              p-3">

    <%= form_with url: search_users_alarm_alarm_memberships_path(alarm),
                  method: :get,
                  data: {
                    turbo_frame: "alarm_membership_search_#{alarm.uuid}",
                    dropdown_target: "form"
                  } do |f| %>
      <%= f.search_field :q_name_cont,
                         placeholder: "名前で検索",
                         data: { action: "input->dropdown#search" },
                         class: "w-full rounded-md px-3 py-1.5 text-sm mb-2
                                 border border-gray-200 dark:border-gray-800
                                 bg-white dark:bg-gray-900
                                 text-gray-900 dark:text-gray-100
                                 placeholder-gray-400 dark:placeholder-gray-600
                                 focus:outline-none focus:ring-1
                                 focus:ring-blue-400 dark:focus:ring-blue-600
                                 focus:border-blue-400 dark:focus:border-blue-600
                                 transition-colors",
                         name: "q[name_cont]" %>
    <% end %>

    <%= turbo_frame_tag "alarm_membership_search_#{alarm.uuid}" do %>
    <% end %>

  </div>
</div>