<%# app/views/bug_reports/new.html.erb %>
<div class="flex flex-col h-full -mx-4 -my-6">

  <div class="flex-1 overflow-y-auto px-4 pt-6 pb-12">
    <div class="max-w-lg mx-auto space-y-6">

      <%# 戻るリンク %>
      <div>
        <%= link_to others_path,
            class: "inline-flex items-center gap-1.5 text-base
                    text-gray-400 dark:text-gray-500
                    hover:text-gray-700 dark:hover:text-gray-200
                    transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          戻る
        <% end %>
      </div>

      <%# ── ページヘッダー：アラーム一覧と同じ構造 ── %>
      <div class="pb-5">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
          不具合報告
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-500 mt-1">
          アプリの動作に問題があった場合は、できるだけ詳しく状況を教えてください。<br>
          内容を確認の上、順次対応いたします。
        </p>
      </div>

      <div class="bg-white dark:bg-gray-950
                  border border-gray-200 dark:border-gray-800
                  rounded-xl overflow-hidden">
        <div class="px-5 py-4 space-y-4">


          <%= form_with url: bug_report_path, method: :post do |f| %>
            <div class="space-y-4">

              <%= f.text_area :body,
                    maxlength: 1000,
                    placeholder: "例：〇〇の画面で△△を操作したとき、××が起きました",
                    rows: 6,
                    class: "w-full rounded-md px-3 py-2.5
                            text-base text-gray-700 dark:text-gray-200
                            placeholder-gray-300 dark:placeholder-gray-600
                            bg-gray-50 dark:bg-gray-900
                            border border-gray-200 dark:border-gray-800
                            focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600
                            focus:border-gray-400 dark:focus:border-gray-600
                            resize-none transition" %>

              <%= f.submit '送信する',
                    class: "w-full py-2.5 rounded-md
                            text-base font-medium
                            text-white dark:text-gray-900
                            bg-gray-900 dark:bg-white
                            hover:bg-gray-700 dark:hover:bg-gray-300
                            transition-colors cursor-pointer" %>
            </div>
          <% end %>

        </div>
      </div>

    </div>
  </div>

</div>