<%# app/views/alarm_logs/list.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <% if user_signed_in? %>

    <%= render 'alarm_logs/navigation' %>

    <%# ── ページヘッダー ── %>
    <div class="flex items-end justify-between
                pb-6 border-b border-gray-200 dark:border-gray-800 mb-8">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
          記録一覧
        </h1>
      </div>
      <% unless @alarm_logs.empty? %>
        <span class="text-xs text-gray-400 dark:text-gray-500 tabular-nums pb-0.5">
          全 <%= @total_count %> 件
        </span>
      <% end %>
    </div>

    <%# ── 記録一覧 ── %>
    <div class="bg-white dark:bg-gray-950
                border border-gray-200 dark:border-gray-800
                rounded-xl overflow-hidden">

      <%# ページネーション（上） %>
      <% if @pagy.pages > 1 %>
        <div class="px-5 py-3 border-b border-gray-200 dark:border-gray-800 flex justify-center">
          <%== @pagy.series_nav %>
        </div>
      <% end %>

      <%# デスクトップ: テーブル %>
      <div class="hidden sm:block">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800">
              <%# 日付を左端に追加 %>
              <th class="text-left text-[11px] font-medium tracking-widest uppercase
                         text-gray-400 dark:text-gray-500 px-5 py-3 w-1/3">日付</th>
              <th class="text-left text-[11px] font-medium tracking-widest uppercase
                         text-gray-400 dark:text-gray-500 px-5 py-3 w-1/3">プレイ時間</th>
              <%# 引き延ばしは右端・右揃え %>
              <th class="text-right text-[11px] font-medium tracking-widest uppercase
                         text-gray-400 dark:text-gray-500 px-5 py-3 w-1/3">引き延ばし</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @alarm_logs.each do |alarm_log| %>
              <% minutes = alarm_log.minutes_to_unlock %>
              <% color_class = minutes >= 60 ? "text-red-500 dark:text-red-400" :
                               minutes >= 0  ? "text-orange-400 dark:text-orange-400" :
                                               "text-emerald-600 dark:text-emerald-400" %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-900/40 transition-colors duration-100">

                <%# 日付列 %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4" do %>
                    <span class="text-sm tabular-nums text-gray-500 dark:text-gray-400">
                      <%= l(alarm_log.unlocked_at, format: "%-m/%-d（%a）") %>
                    </span>
                  <% end %>
                </td>

                <%# プレイ時間列 %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4" do %>
                    <span class="text-sm font-semibold tabular-nums text-gray-900 dark:text-white">
                      <%= alarm_log.play_duration.present? ? format_play_minutes(alarm_log.play_duration) : "—" %>
                    </span>
                  <% end %>
                </td>

                <%# 引き延ばし列：右揃え %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4 text-right" do %>
                    <span class="text-sm font-bold tabular-nums <%= color_class %>">
                      <%= format_play_minutes(minutes) %>
                    </span>
                  <% end %>
                </td>

              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# モバイル: リスト %>
      <div class="sm:hidden divide-y divide-gray-100 dark:divide-gray-800">
        <% @alarm_logs.each do |alarm_log| %>
          <% minutes = alarm_log.minutes_to_unlock %>
          <% color_class = minutes >= 60 ? "text-red-500 dark:text-red-400" :
                           minutes >= 0  ? "text-orange-400 dark:text-orange-400" :
                                           "text-emerald-600 dark:text-emerald-400" %>
          <%= link_to alarm_log_path(alarm_log),
              class: "flex items-center justify-between px-5 py-4
                      hover:bg-gray-50 dark:hover:bg-gray-900/40
                      transition-colors duration-100" do %>

            <%# 左側：日付とプレイ時間 %>
            <div class="flex flex-col gap-0.5">
              <span class="text-sm font-medium tabular-nums text-gray-900 dark:text-white">
                <%= l(alarm_log.unlocked_at, format: "%-m/%-d（%a）") %>
              </span>
              <% if alarm_log.play_duration.present? %>
                <span class="text-xs text-gray-400 dark:text-gray-500">
                  <%= format_play_minutes(alarm_log.play_duration) %> プレイ
                </span>
              <% end %>
            </div>

            <%#
              右側：引き延ばし時間。
              shrink-0 で縮まらないようにし、whitespace-nowrap で改行を防ぐ。
              w-16 の固定幅を外したことで「120分」のような長い値でも折り返さない。
            %>
            <div class="shrink-0 flex flex-col items-end gap-0.5 ml-4">
              <span class="text-lg font-bold tabular-nums leading-tight whitespace-nowrap <%= color_class %>">
                <%= format_play_minutes(minutes) %>
              </span>
              <span class="text-[10px] text-gray-400 dark:text-gray-500 leading-tight">
                引き延ばし
              </span>
            </div>

          <% end %>
        <% end %>
      </div>

      <%# 空状態 %>
      <% if @alarm_logs.empty? %>
        <div class="flex flex-col items-center justify-center py-20">
          <p class="text-sm text-gray-400 dark:text-gray-500">まだ記録がありません</p>
        </div>
      <% end %>

      <%# ページネーション（下） %>
      <% if @pagy.pages > 1 %>
        <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-800 flex justify-center">
          <%== @pagy.series_nav %>
        </div>
      <% end %>

    </div>

  <% end %>
</div>