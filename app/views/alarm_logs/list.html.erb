<%# app/views/alarm_logs/list.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <% if user_signed_in? %>

    <%= render 'alarm_logs/navigation' %>

    <%# ── ページヘッダー ── %>
    <div class="max-w-2xl pb-6 border-b border-gray-200 dark:border-gray-800 mb-8">
      <div class="flex items-baseline gap-5">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
          記録一覧
        </h1>
        <% unless @alarm_logs.empty? %>
          <span class="text-sm text-gray-600 dark:text-gray-500 tabular-nums">
            全 <%= @total_count %> 件
          </span>
        <% end %>
      </div>
    </div>

    <%# ── 記録一覧 ── %>
    <div class="max-w-2xl bg-white dark:bg-gray-950
                border border-gray-200 dark:border-gray-800
                rounded-xl overflow-hidden">

      <%# ページネーション（上） %>
      <% if @pagy.pages > 1 %>
        <div class="px-5 py-3 border-b border-gray-200 dark:border-gray-800 flex justify-center">
          <%== @pagy.series_nav %>
        </div>
      <% end %>

      <%# デスクトップ: テーブル %>
      <div class="hidden sm:block">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800">
              <%# 日付を左端に追加 %>
              <th class="text-left text-sm font-medium tracking-widest uppercase
                         text-gray-600 dark:text-gray-500 px-5 py-3 w-1/3">日付</th>
              <th class="text-left text-sm font-medium tracking-widest uppercase
                         text-gray-600 dark:text-gray-500 px-5 py-3 w-1/3">プレイ時間</th>
              <%# 引き延ばしは右端・右揃え %>
              <th class="text-right text-sm font-medium tracking-widest uppercase
                         text-gray-600 dark:text-gray-500 px-5 py-3 w-1/3">引き延ばし</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @alarm_logs.each do |alarm_log| %>
              <% minutes = alarm_log.minutes_to_stop %>
              <% color_class = minutes >= 60 ? "text-red-500 dark:text-red-400" :
                               minutes >= 0  ? "text-orange-400 dark:text-orange-400" :
                                               "text-emerald-600 dark:text-emerald-400" %>
              <tr class="transition-colors duration-100">

                <%# 日付列 %>
                <td class="p-0">
                  <div class="block px-5 py-4">
                    <span class="text-base tabular-nums text-gray-500 dark:text-gray-400">
                      <%= l(alarm_log.stopped_at, format: "%-m/%-d（%a）") %>
                    </span>
                  </div>
                </td>

                <%# プレイ時間列 %>
                <td class="p-0">
                  <div class="block px-5 py-4">
                    <span class="text-lg font-semibold tabular-nums text-gray-900 dark:text-white">
                      <%= alarm_log.play_duration.present? ? format_play_minutes(alarm_log.play_duration) : "—" %>
                    </span>
                  </div>
                </td>

                <%# 引き延ばし列：右揃え %>
                <td class="p-0">
                  <div class="block px-5 py-4 text-right">
                    <span class="text-xl font-bold tabular-nums <%= color_class %>">
                      <%= format_play_minutes(minutes) %>
                    </span>
                  </div>
                </td>

              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# モバイル: リスト %>
      <div class="sm:hidden divide-y divide-gray-100 dark:divide-gray-800">
        <% @alarm_logs.each do |alarm_log| %>
          <% minutes = alarm_log.minutes_to_stop %>
          <% color_class = minutes >= 60 ? "text-red-500 dark:text-red-400" :
                           minutes >= 0  ? "text-orange-400 dark:text-orange-400" :
                                           "text-emerald-600 dark:text-emerald-400" %>
          <div class="flex items-center justify-between px-5 py-4
                      transition-colors duration-100">

            <%# 左側：日付とプレイ時間 %>
            <div class="flex flex-col gap-0.5">
              <span class="text-base font-medium tabular-nums text-gray-900 dark:text-white">
                <%= l(alarm_log.stopped_at, format: "%-m/%-d（%a）") %>
              </span>
            </div>

            <%#
              右側：引き延ばし時間。
            %>
            <div class="shrink-0 flex flex-col items-end gap-0.5 ml-4">
              <span class="text-xl font-bold tabular-nums leading-tight whitespace-nowrap <%= color_class %>">
                <%= format_play_minutes(minutes) %>
              </span>
              <span class="text-sm text-gray-600 dark:text-gray-500 leading-tight">
                引き延ばし
              </span>
            </div>

          </div>
        <% end %>
      </div>

      <%# 空状態 %>
      <% if @alarm_logs.empty? %>
        <div class="flex flex-col items-center justify-center py-20">
          <p class="text-base text-gray-500 dark:text-gray-500">まだ記録がありません</p>
        </div>
      <% end %>

      <%# ページネーション（下） %>
      <% if @pagy.pages > 1 %>
        <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-800 flex justify-center">
          <%== @pagy.series_nav %>
        </div>
      <% end %>

    </div>

  <% end %>
</div>