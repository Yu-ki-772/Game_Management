<%# app/views/alarm_logs/show.html.erb %>
<div class="max-w-2xl mx-auto px-4 py-8">

  <%# 戻るリンク %>
  <div class="mb-6">
    <%= link_to alarm_logs_path, class: "inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      プレイ記録一覧に戻る
    <% end %>
  </div>

  <%# ヘッダー %>
  <div class="pb-5 border-b border-gray-200 dark:border-gray-700 mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">記録の詳細</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
      <%= l(@alarm_log.unlocked_at, format: :long) %>
    </p>
  </div>

  <%# ─── 自分の記録カード ──────────────────────────────────────── %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5 mb-4">
    <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-4">あなたの記録</p>

    <%# プレイ時間・引き延ばし時間 %>
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">プレイ時間</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-gray-100">
          <%= @alarm_log.play_duration.present? ? format_play_duration(@alarm_log.play_duration) : "-" %>
        </p>
      </div>

      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">引き延ばし時間</p>
        <% minutes     = @alarm_log.minutes_to_unlock %>
        <% color_class = minutes >= 60 ? "text-red-400" :
                         minutes >= 0  ? "text-orange-400" :
                                         "text-emerald-400" %>
        <p class="text-3xl font-bold <%= color_class %>">
          <%= minutes %>分
        </p>
      </div>
    </div>

    <%# 終了予定時刻・やめた時刻 %>
    <div class="flex gap-6">
      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">終了予定時刻</p>
        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
          <%= l(@alarm_log.alarm.scheduled_at, format: :short) %>
        </p>
      </div>

      <div>
        <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">やめた時刻</p>
        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
          <%= l(@alarm_log.unlocked_at, format: :short) %>
        </p>
      </div>
    </div>
  </div>

  <%# ─── アラーム情報カード ──────────────────────────────────────── %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden mb-4">
    <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
      <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">アラーム情報</p>
    </div>

    <div class="divide-y divide-gray-50 dark:divide-gray-700">

      <% if @alarm_log.alarm.label.present? %>
        <div class="px-5 py-3.5 flex justify-between items-center">
          <span class="text-xs text-gray-400 dark:text-gray-500">ラベル</span>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= @alarm_log.alarm.label %></span>
        </div>
      <% end %>

      <% if @alarm_log.alarm.started_at.present? %>
        <div class="px-5 py-3.5 flex justify-between items-center">
          <span class="text-xs text-gray-400 dark:text-gray-500">プレイ開始時刻</span>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= l(@alarm_log.alarm.started_at, format: :short) %></span>
        </div>
      <% end %>

      <div class="px-5 py-3.5 flex justify-between items-center">
        <span class="text-xs text-gray-400 dark:text-gray-500">作成者</span>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= @alarm_log.alarm.creator.name %></span>
      </div>

    </div>
  </div>

  <%# ─── 一緒にプレイしたフレンド ──────────────────────────── %>
  <% if @members.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
        <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">一緒にプレイしたフレンド</p>
      </div>

      <div class="px-5 py-2 flex justify-end items-center border-b border-gray-50 dark:border-gray-700">
        <span class="text-xs text-gray-400 dark:text-gray-500">引き延ばし時間</span>
      </div>

      <div class="divide-y divide-gray-50 dark:divide-gray-700">
        <% @members.each do |member| %>
          <% other_member_log = @other_member_logs.find { |log| log.user_uuid == member.uuid } %>

          <div class="px-5 py-3.5 flex items-center justify-between">
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= member.name %></span>

            <% if other_member_log %>
              <% other_member_minutes_to_unlock = other_member_log.minutes_to_unlock %>
              <% other_member_color_class = other_member_minutes_to_unlock >= 60 ? "text-red-400" :
                                            other_member_minutes_to_unlock >= 0  ? "text-orange-400" :
                                                                                   "text-emerald-400" %>
              <span class="text-sm font-bold <%= other_member_color_class %>"><%= other_member_minutes_to_unlock %>分</span>
            <% else %>
              <span class="text-xs text-gray-400 dark:text-gray-500">未ストップ</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
