<%# app/views/alarm_logs/index.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <% if user_signed_in? %>
    <div class="pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">プレイ記録</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">プレイ時間の統計と一覧です</p>
    </div>

    <div class="grid grid-cols-2 gap-3 mb-10">
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-3">引き延ばし時間（平均）</p>
        <% avg_color = @average_minutes.nil?  ? "text-gray-900 dark:text-gray-100" :
                       @average_minutes >= 60 ? "text-red-400" :
                       @average_minutes >= 0  ? "text-orange-400" :
                                                "text-emerald-400" %>
        <p class="text-3xl font-bold <%= avg_color %>">
          <%= @average_minutes ? "#{@average_minutes}分" : "-" %>
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-3">総プレイ記録数</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-gray-100">
          <%= @total_count %><span class="text-lg font-medium text-gray-400 dark:text-gray-500 ml-0.5">件</span>
        </p>
      </div>
    </div>

    <%# ─── グラフセクション（共通設定には、chatkickのinitializersの設定が適用される） ─────────────────────────────────────── %>
    <div class="space-y-4 mb-10">

      <%# フレンドごとの記録 %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 mb-1">
          一緒にプレイしたフレンドごとの引き延ばし時間（平均）を比較
        </p>

        <%# 凡例 %>
        <div class="flex items-center gap-4 mb-4">
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="text-xs text-gray-400 dark:text-gray-500">0分未満</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-orange-400"></span>
            <span class="text-xs text-gray-400 dark:text-gray-500">0〜59分</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-red-400"></span>
            <span class="text-xs text-gray-400 dark:text-gray-500">60分以上</span>
          </div>
        </div>

        <% if @friend_stats.any? %>
          <% friend_colors = @friend_stats.values.map do |avg|
               avg >= 60 ? "#f87171" : avg >= 0 ? "#fb923c" : "#34d399"
             end %>

          <%= bar_chart @friend_stats,
              height:  "#{[@friend_stats.size * 44, 120].max}px",
              dataset: { backgroundColor: friend_colors, borderRadius: 4 },
              library: {
                indexAxis: "y",
                scales: {
                  y: {
                    ticks: { color: "#d1d5db", font: { size: 13, weight: "600" } },
                    grid:  { display: false }
                  }
                },
              } %>
        <% else %>
          <div class="text-center py-10">
            <p class="text-sm text-gray-400 dark:text-gray-500">まだデータがありません</p>
          </div>
        <% end %>
      </div>

      <%# プレイ時間の統計（過去7日間・日別合計） %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 mb-1">
          日ごとのプレイ時間の推移（過去7日間）
        </p>

        <% if @play_duration_stats.any? %>
          <%= line_chart @play_duration_stats,
              height: "200px",
              colors: ["#818cf8"],
              suffix: "分",
              library: {
                elements: {
                  line:  { borderWidth: 2, tension: 0.3 },
                  point: { radius: 3, hoverRadius: 5 }
                }
              } %>
        <% else %>
          <div class="text-center py-10">
            <p class="text-sm text-gray-400 dark:text-gray-500">まだデータがありません</p>
          </div>
        <% end %>
      </div>

      <%# 引き延ばし時間の推移 %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 mb-1">
          引き延ばし時間の推移（直近7回）
        </p>

        <% if @minutes_stats.any? %>
          <% point_colors = @minutes_stats.values.map do |value|
               value >= 60 ? "#f87171" : value >= 0 ? "#fb923c" : "#34d399"
             end %>

          <%= line_chart @minutes_stats,
              height: "200px",
              colors: ["#818cf8"],
              suffix: "分",
              library: {
                elements: {
                  line:  { borderWidth: 2, tension: 0.3 },
                  point: { radius: 3, hoverRadius: 5, backgroundColor: point_colors }
                }
              } %>
        <% else %>
          <div class="text-center py-10">
            <p class="text-sm text-gray-400 dark:text-gray-500">まだデータがありません</p>
          </div>
        <% end %>
      </div>

    </div>

    <%# ── 記録一覧 ──────────────────────────────────────────────── %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden">

      <%# セクションヘッダー %>
      <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700 bg-gray-50/60 dark:bg-gray-700/30
                  flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">プレイ記録一覧</h2>
        <% unless @alarm_logs.empty? %>
          <span class="text-xs text-gray-400 dark:text-gray-500 tabular-nums">
            <%= @total_count %>件
          </span>
        <% end %>
      </div>

      <%# ページネーション（上） %>
      <% if @pagy.pages > 1 %>
        <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-700 flex justify-center">
          <%== @pagy.series_nav %>
        </div>
      <% end %>

      <%# デスクトップ: テーブル %>
      <div class="hidden sm:block">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-100 dark:border-gray-700 bg-gray-50/40 dark:bg-gray-700/20">
              <th class="text-left text-xs font-semibold text-gray-600 dark:text-gray-400 px-5 py-3 w-1/4">
                プレイ時間
              </th>
              <th class="text-left text-xs font-semibold text-gray-600 dark:text-gray-400 px-5 py-3 w-1/4">
                引き延ばし
              </th>
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3 w-1/4">
                終了予定
              </th>
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3 w-1/4">
                やめた時刻
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-gray-700/70">
            <% @alarm_logs.each do |alarm_log| %>
              <% minutes     = alarm_log.minutes_to_unlock %>
              <% color_class = minutes >= 60 ? "text-red-400" :
                               minutes >= 0  ? "text-orange-400" :
                                               "text-emerald-400" %>
              <tr class="hover:bg-gray-50/80 dark:hover:bg-gray-700/30 transition-colors duration-100">

                <%# プレイ時間 %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4" do %>
                    <span class="text-sm font-semibold tabular-nums text-gray-800 dark:text-gray-100">
                      <%= alarm_log.play_duration.present? ? format_play_duration(alarm_log.play_duration) : "—" %>
                    </span>
                  <% end %>
                </td>

                <%# 引き延ばし時間 %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4" do %>
                    <span class="text-sm font-bold tabular-nums <%= color_class %>">
                      <%= minutes %>分
                    </span>
                  <% end %>
                </td>

                <%# 終了予定時刻 %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4" do %>
                    <span class="text-xs tabular-nums text-gray-400 dark:text-gray-500">
                      <%= l(alarm_log.alarm.scheduled_at, format: :short) %>
                    </span>
                  <% end %>
                </td>

                <%# やめた時刻 %>
                <td class="p-0">
                  <%= link_to alarm_log_path(alarm_log), class: "block px-5 py-4" do %>
                    <span class="text-xs tabular-nums text-gray-400 dark:text-gray-500">
                      <%= l(alarm_log.unlocked_at, format: :short) %>
                    </span>
                  <% end %>
                </td>

              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# モバイル: リスト %>
      <div class="sm:hidden divide-y divide-gray-50 dark:divide-gray-700/70">
        <% @alarm_logs.each do |alarm_log| %>
          <% minutes     = alarm_log.minutes_to_unlock %>
          <% color_class = minutes >= 60 ? "text-red-400" :
                           minutes >= 0  ? "text-orange-400" :
                                           "text-emerald-400" %>
          <%= link_to alarm_log_path(alarm_log),
              class: "flex items-center gap-4 px-5 py-4
                      hover:bg-gray-50/80 dark:hover:bg-gray-700/30
                      transition-colors duration-100" do %>

            <%# 引き延ばし時間 %>
            <div class="shrink-0 flex flex-col items-end gap-0.5">
              <span class="text-lg font-bold tabular-nums leading-tight <%= color_class %>">
                <%= minutes %>分
              </span>
              <span class="text-[10px] text-gray-400 dark:text-gray-500 leading-tight whitespace-nowrap">
                引き延ばし
              </span>
            </div>

            <%# 縦区切り線 %>
            <div class="w-px self-stretch bg-gray-100 dark:bg-gray-700 shrink-0"></div>

            <div class="flex-1 min-w-0 flex flex-col gap-0.5">
              <% if alarm_log.play_duration.present? %>
                <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
                  <%= format_play_duration(alarm_log.play_duration) %>
                  <span class="text-xs font-normal text-gray-400 dark:text-gray-500">プレイ</span>
                </p>
              <% end %>
              <p class="text-xs text-gray-400 dark:text-gray-500">
                やめた時刻
                <span class="tabular-nums ml-1"><%= l(alarm_log.unlocked_at, format: :short) %></span>
              </p>
              <p class="text-xs text-gray-400 dark:text-gray-500">
                終了予定
                <span class="tabular-nums ml-1"><%= l(alarm_log.alarm.scheduled_at, format: :short) %></span>
              </p>
            </div>

          <% end %>
        <% end %>
      </div>

      <%# ページネーション（下）：2ページ以上ある場合のみ表示 %>
      <% if @pagy.pages > 1 %>
        <div class="px-5 py-4 border-t border-gray-100 dark:border-gray-700 flex justify-center">
          <%== @pagy.series_nav %>
        </div>
      <% end %>

      <%# 記録がない場合 %>
      <% if @alarm_logs.empty? %>
        <div class="text-center py-16">
          <p class="text-sm text-gray-400 dark:text-gray-500">まだ記録がありません</p>
        </div>
      <% end %>

    </div>


    <%# アラームストップ時のモーダル %>
    <% if flash[:alarm_log_id] %>
      <% alarm_log = AlarmLog.find(flash[:alarm_log_id]) %>
      <%= render 'alarms/unlock_modal', alarm_log: alarm_log %>
    <% end %>
  <% end %>
</div>
