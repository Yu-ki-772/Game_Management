<%# app/views/alarm_logs/index.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <% if user_signed_in? %>
    <div class="pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">記録</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">ゲームをやめた記録の一覧です</p>
    </div>

    <div class="grid grid-cols-2 gap-3 mb-10">
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-3">記録の平均</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-gray-100">
          <%= format_minutes_defer(@alarm_logs.average(:minutes_to_unlock)&.round) %>
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm p-5">
        <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-3">記録数</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-gray-100">
          <%= @alarm_logs.count %><span class="text-lg font-medium text-gray-400 dark:text-gray-500 ml-0.5">件</span>
        </p>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">記録一覧</h2>
      </div>

      <%# デスクトップ: テーブル形式 %>
      <div class="hidden sm:block">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-100 dark:border-gray-700">
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3">記録</th>
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3">プレイ時間</th>
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3">ラベル</th>
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3">予定</th>
              <th class="text-left text-xs font-medium text-gray-400 dark:text-gray-500 px-5 py-3">やめた時間</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
            <% @alarm_logs.each do |alarm_log| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                <td class="px-5 py-3.5">
                  <span class="text-base font-bold text-gray-900 dark:text-gray-100">
                    <%= format_minutes_defer(alarm_log.minutes_to_unlock) %>
                  </span>
                </td>
                <td class="px-5 py-3.5">
                  <span class="text-base font-bold text-gray-900 dark:text-gray-100">
                    <%= alarm_log.play_duration.present? ? format_play_duration(alarm_log.play_duration) : "-" %>
                  </span>
                </td>
                <td class="px-5 py-3.5">
                  <span class="text-sm text-gray-700 dark:text-gray-300"><%= alarm_log.alarm.label %></span>
                  <% unless alarm_log.alarm.created_by?(current_user) %>
                    <p class="text-xs text-indigo-400 dark:text-indigo-300 mt-0.5">
                      <%= truncate(alarm_log.alarm.creator.name, length: 11, omission: "...") %> さんのアラーム
                    </p>
                  <% end %>
                </td>
                <td class="px-5 py-3.5">
                  <span class="text-xs text-gray-500 dark:text-gray-400"><%= l(alarm_log.alarm.scheduled_at, format: :short) %></span>
                </td>
                <td class="px-5 py-3.5">
                  <span class="text-xs text-gray-500 dark:text-gray-400"><%= l(alarm_log.unlocked_at, format: :short) %></span>
                </td>
                <td class="px-5 py-3.5">
                  <% if alarm_log.ignored? %>
                    <span class="px-2 py-0.5 bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-medium rounded border border-red-200 dark:border-red-800">
                      長すぎ
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# モバイル: シンプルなリスト形式 %>
      <div class="sm:hidden divide-y divide-gray-50 dark:divide-gray-700">
        <% @alarm_logs.each do |alarm_log| %>
          <div class="px-5 py-4 flex items-center justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-base font-bold text-gray-900 dark:text-gray-100">
                  <%= format_minutes_defer(alarm_log.minutes_to_unlock) %>
                </span>
                <% if alarm_log.ignored? %>
                  <span class="px-1.5 py-0.5 bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-medium rounded border border-red-200 dark:border-red-800">
                    長すぎ
                  </span>
                <% end %>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-400 truncate"><%= alarm_log.alarm.label %></p>
              <% unless alarm_log.alarm.created_by?(current_user) %>
                <p class="text-xs text-indigo-400 dark:text-indigo-300 mt-0.5">
                  <%= truncate(alarm_log.alarm.creator.name, length: 11, omission: "...") %> さんのアラーム
                </p>
              <% end %>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                やめた時間 <%= l(alarm_log.unlocked_at, format: :short) %>
              </p>
              <% if alarm_log.play_duration.present? %>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
                  プレイ時間 <%= format_play_duration(alarm_log.play_duration) %>
                </p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# 記録がない場合 %>
      <% if @alarm_logs.empty? %>
        <div class="text-center py-16 text-gray-400 dark:text-gray-500">
          <p class="text-sm">まだ記録がありません</p>
        </div>
      <% end %>
    </div>

    <%# アラームストップ時のモーダル %>
    <% if flash[:alarm_log_id] %>
      <% alarm_log = AlarmLog.find(flash[:alarm_log_id]) %>
      <%= render 'alarms/unlock_modal', alarm_log: alarm_log %>
    <% end %>

  <% else %>
    <div class="flex items-center justify-center min-h-[60vh]">
      <div class="max-w-md mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">
          記録機能を利用するにはログインしてください
        </h2>
        <%= link_to new_user_session_path,
            class: "inline-flex items-center gap-2 px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition text-sm font-semibold" do %>
          <span>ログイン</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" />
          </svg>
        <% end %>
      </div>
    </div>
  <% end %>
</div>