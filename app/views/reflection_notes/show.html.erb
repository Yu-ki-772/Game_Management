<%# app/views/reflection_notes/show.html.erb %>
<div class="max-w-3xl mx-auto px-4 py-8">

  <%# ページヘッダー %>
  <div class="flex items-center justify-between mb-6">
    <%= link_to "← 一覧に戻る",
          reflection_notes_path,
          class: "text-sm text-gray-500 dark:text-gray-400
                  hover:text-emerald-600 dark:hover:text-emerald-400
                  transition-colors" %>
    <div class="flex gap-2">
      <%= link_to "編集",
            edit_reflection_note_path(@reflection_note),
            class: "text-sm font-medium
                    text-emerald-600 dark:text-emerald-400
                    hover:text-emerald-800 dark:hover:text-emerald-300
                    border border-emerald-300 dark:border-emerald-700
                    hover:border-emerald-500 dark:hover:border-emerald-500
                    px-4 py-1.5 rounded-lg transition-colors" %>
      <%= button_to "削除",
            reflection_note_path(@reflection_note),
            method: :delete,
            data: { turbo_confirm: "本当に削除しますか？" },
            class: "text-sm font-medium text-red-600 dark:text-red-400
                    hover:text-red-800 dark:hover:text-red-300
                    border border-red-300 dark:border-red-800
                    hover:border-red-500 dark:hover:border-red-600
                    px-4 py-1.5 rounded-lg transition-colors bg-transparent dark:bg-transparent" %>
    </div>
  </div>

  <%# メインカード %>
  <div class="bg-white dark:bg-gray-800
              border border-gray-200 dark:border-gray-700
              rounded-xl shadow-sm">

    <div class="p-6 sm:p-8">

      <%# 種別バッジ + 作成日時 %>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <span class="inline-block text-xs font-semibold px-3 py-1 rounded-full <%= reflection_type_color_class(@reflection_note.reflection_type) %>">
          <%= I18n.t("enums.reflection_note.reflection_type.#{@reflection_note.reflection_type}") %>
        </span>
        <div class="text-xs text-gray-400 dark:text-gray-500 space-x-3">
          <span>作成：<%= @reflection_note.created_at.strftime("%Y/%m/%d %H:%M") %></span>
          <% if @reflection_note.updated_at != @reflection_note.created_at %>
            <span>更新：<%= @reflection_note.updated_at.strftime("%Y/%m/%d %H:%M") %></span>
          <% end %>
        </div>
      </div>

      <%# タイトル %>
      <h1 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-6">
        <%= @reflection_note.title.presence || "（タイトルなし）" %>
      </h1>

      <%# 本文 %>
      <div class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-wrap mb-6">
        <%= @reflection_note.body %>
      </div>

      <%# タグ %>
      <% if @reflection_note.tags.any? %>
        <div class="flex flex-wrap gap-2 pt-5 border-t border-gray-100 dark:border-gray-700">
          <% @reflection_note.tags.each do |tag| %>
            <span class="inline-block text-xs bg-gray-100 dark:bg-gray-700
                         text-gray-500 dark:text-gray-400
                         px-3 py-1 rounded-full">
              # <%= tag.name %>
            </span>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

</div>
