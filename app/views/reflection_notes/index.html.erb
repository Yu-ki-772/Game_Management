<div class="max-w-5xl mx-auto px-4 py-8">

  <%# ============================================================ %>
  <%# ページヘッダー                                                %>
  <%# ============================================================ %>
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-gray-800">振り返りメモ一覧</h1>
    <%= link_to "＋ 新規作成",
          new_reflection_note_path,
          class: "inline-flex items-center gap-1 bg-indigo-600 hover:bg-indigo-700
                  text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
  </div>

  <%# ============================================================ %>
  <%# 絞込フィルター                                                %>
  <%# ============================================================ %>
  <div class="bg-white border border-gray-200 rounded-xl p-5 mb-8 space-y-4 shadow-sm">

    <%# --- reflection_type フィルター -------------------------------- %>
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">種別</p>
      <div class="flex flex-wrap gap-2">
        <%
          type_active   = params[:reflection_type].blank?
          base_btn      = "px-3 py-1.5 rounded-full text-sm font-medium transition-colors border"
          active_btn    = "bg-indigo-600 text-white border-indigo-600"
          inactive_btn  = "bg-white text-gray-600 border-gray-300 hover:border-indigo-400 hover:text-indigo-600"
        %>
        <%= link_to "すべて",
              reflection_notes_path(tag_id: params[:tag_id], period: params[:period]),
              class: "#{base_btn} #{type_active ? active_btn : inactive_btn}" %>

        <% ReflectionNote.reflection_types.each_key do |key| %>
          <% is_active = params[:reflection_type] == key %>
          <%= link_to I18n.t("enums.reflection_note.reflection_type.#{key}"),
                reflection_notes_path(reflection_type: key, tag_id: params[:tag_id], period: params[:period]),
                class: "#{base_btn} #{is_active ? active_btn : inactive_btn}" %>
        <% end %>
      </div>
    </div>

    <%# --- タグフィルター ------------------------------------------- %>
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">タグ</p>
      <div class="flex flex-wrap gap-2">
        <% tag_none = params[:tag_id].blank? %>
        <%= link_to "すべて",
              reflection_notes_path(reflection_type: params[:reflection_type], period: params[:period]),
              class: "#{base_btn} #{tag_none ? active_btn : inactive_btn}" %>

        <% @all_tags.each do |tag| %>
          <% is_active = params[:tag_id].to_s == tag.id.to_s %>
          <%= link_to tag.name,
                reflection_notes_path(reflection_type: params[:reflection_type], tag_id: tag.id, period: params[:period]),
                class: "#{base_btn} #{is_active ? active_btn : inactive_btn}" %>
        <% end %>
      </div>
    </div>

    <%# --- 期間フィルター ------------------------------------------- %>
    <div>
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">期間</p>
      <div class="flex flex-wrap gap-2">
        <%
          periods = {
            ""             => "すべて",
            "this_week"    => "今週",
            "this_month"   => "今月",
            "last_3_months"=> "3か月",
            "last_6_months"=> "半年",
            "last_year"    => "1年間"
          }
        %>
        <% periods.each do |value, label| %>
          <% is_active = params[:period].to_s == value %>
          <%= link_to label,
                reflection_notes_path(reflection_type: params[:reflection_type], tag_id: params[:tag_id], period: value),
                class: "#{base_btn} #{is_active ? active_btn : inactive_btn}" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ============================================================ %>
  <%# 一覧カード                                                     %>
  <%# ============================================================ %>
  <% if @reflection_notes.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @reflection_notes.each do |note| %>
        <article class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md
                        transition-shadow flex flex-col">

          <div class="p-5 flex-1">
            <%# 種別 %>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <%
                type_colors = {
                  "success"     => "bg-emerald-100 text-emerald-700",
                  "improvement" => "bg-amber-100 text-amber-700",
                  "hypothesis"  => "bg-sky-100 text-sky-700"
                }
                color_class = type_colors[note.reflection_type] || "bg-gray-100 text-gray-600"
              %>
              <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full <%= color_class %>">
                <%= I18n.t("enums.reflection_note.reflection_type.#{note.reflection_type}") %>
              </span>
              <% note.tags.first(7).each do |tag| %>
                <span class="inline-block text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">
                  # <%= tag.name %>
                </span>
              <% end %>
            </div>

            <%# タイトル %>
            <h2 class="text-base font-semibold text-gray-800 mb-2 line-clamp-1">
              <%= truncate(note.title.presence || "（タイトルなし）", length: 15) %>
            </h2>

            <%# 本文プレビュー %>
            <p class="text-sm text-gray-600 line-clamp-3 leading-relaxed">
              <%= truncate(note.body, length: 25) %>
            </p>
          </div>

          <div class="border-t border-gray-100 px-5 py-3 flex items-center justify-between">
            <span class="text-xs text-gray-400"><%= note.created_at.strftime("%Y/%m/%d") %></span>
            <div class="flex gap-2">
              <%= link_to "編集",
                    edit_reflection_note_path(note),
                    class: "text-xs font-medium text-indigo-600 hover:text-indigo-800
                            border border-indigo-300 hover:border-indigo-500
                            px-3 py-1 rounded-lg transition-colors" %>
              <%= button_to "削除",
                    reflection_note_path(note),
                    method: :delete,
                    data: { turbo_confirm: "本当に削除しますか？" },
                    class: "text-xs font-medium text-red-600 hover:text-red-800
                            border border-red-300 hover:border-red-500
                            px-3 py-1 rounded-lg transition-colors bg-transparent" %>
            </div>
          </div>

        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-gray-400">
      <p class="text-lg mb-1">該当する振り返りメモがありません</p>
      <p class="text-sm">フィルターを変更するか、新規作成してください。</p>
    </div>
  <% end %>

</div>
