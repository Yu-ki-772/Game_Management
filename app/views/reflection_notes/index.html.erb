<%# app/views/reflection_notes/index.html.erb %>
<div class="max-w-5xl mx-auto px-4 py-8">

  <%# ページヘッダー %>
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">振り返りメモ一覧</h1>
    <%= link_to "＋ 新規作成",
          new_reflection_note_path,
          class: "inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-700
                  text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
  </div>

  <%# 検索・絞込フィルター %>
  <div class="bg-white dark:bg-gray-800
              border border-gray-200 dark:border-gray-700
              rounded-xl p-5 mb-8 space-y-4 shadow-sm">

    <%# テキスト検索 + 種別 + タグ (ransack) %>
    <%= render "search_form" %>

    <%# 期間フィルター %>
    <div>
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">期間</p>
      <div class="flex flex-wrap gap-2">
        <%
          base_btn     = "px-3 py-1.5 rounded-full text-sm font-medium transition-colors border"
          active_btn   = "bg-emerald-600 text-white border-emerald-600"
          inactive_btn = "bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 border-gray-300 dark:border-gray-600 hover:border-emerald-400 hover:text-emerald-600 dark:hover:border-emerald-500 dark:hover:text-emerald-400"
        %>
        <% periods = {
             ""              => "すべて",
             "this_week"     => "今週",
             "this_month"    => "今月",
             "last_3_months" => "3か月",
             "last_6_months" => "半年",
             "last_year"     => "1年間"
           } %>
        <% periods.each do |value, label| %>
          <% is_active = params[:period].to_s == value %>
          <%= link_to label,
                reflection_notes_path(q: params[:q]&.to_unsafe_h, period: value),
                class: "#{base_btn} #{is_active ? active_btn : inactive_btn}" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ============================================================ %>
  <%# 一覧カード                                                     %>
  <%# ============================================================ %>
  <% if @reflection_notes.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @reflection_notes.each do |note| %>
        <article class="bg-white dark:bg-gray-800
                        border border-gray-200 dark:border-gray-700
                        rounded-xl shadow-sm hover:shadow-md dark:hover:shadow-gray-900/50
                        transition-shadow flex flex-col">

          <div class="p-5 flex-1">
            <%# 種別 %>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <%
                type_colors = {
                  "success"     => "bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400",
                  "improvement" => "bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-400",
                  "hypothesis"  => "bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-400"
                }
                color_class = type_colors[note.reflection_type] || "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400"
              %>
              <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full <%= color_class %>">
                <%= I18n.t("enums.reflection_note.reflection_type.#{note.reflection_type}") %>
              </span>
              <% note.tags.first(7).each do |tag| %>
                <span class="inline-block text-xs bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 px-2 py-0.5 rounded-full">
                  # <%= tag.name %>
                </span>
              <% end %>
            </div>

            <%# タイトル %>
            <h2 class="text-base font-semibold text-gray-800 dark:text-gray-100 mb-2 line-clamp-1">
              <%= truncate(note.title.presence || "（タイトルなし）", length: 15) %>
            </h2>

            <%# 本文プレビュー %>
            <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-3 leading-relaxed">
              <%= truncate(note.body, length: 25) %>
            </p>
          </div>

          <div class="border-t border-gray-100 dark:border-gray-700 px-5 py-3 flex items-center justify-between">
            <span class="text-xs text-gray-400 dark:text-gray-500"><%= note.created_at.strftime("%Y/%m/%d") %></span>
            <div class="flex gap-2">
              <%# 編集ボタン %>
              <%= link_to "編集",
                    edit_reflection_note_path(note),
                    class: "text-xs font-medium
                            text-emerald-600 dark:text-emerald-400
                            hover:text-emerald-800 dark:hover:text-emerald-300
                            border border-emerald-300 dark:border-emerald-700
                            hover:border-emerald-500 dark:hover:border-emerald-500
                            px-3 py-1 rounded-lg transition-colors" %>
              <%= button_to "削除",
                    reflection_note_path(note),
                    method: :delete,
                    data: { turbo_confirm: "本当に削除しますか？" },
                    class: "text-xs font-medium text-red-600 dark:text-red-400
                            hover:text-red-800 dark:hover:text-red-300
                            border border-red-300 dark:border-red-800
                            hover:border-red-500 dark:hover:border-red-600
                            px-3 py-1 rounded-lg transition-colors bg-transparent dark:bg-transparent" %>
            </div>
          </div>

        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-gray-400 dark:text-gray-500">
      <p class="text-lg mb-1">該当する振り返りメモがありません</p>
      <p class="text-sm mb-4">フィルターを変更するか、新規作成してください。</p>
      <%= link_to "＋ 新規作成",
            new_reflection_note_path,
            class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700
                    text-white text-base font-semibold px-8 py-3 rounded-xl transition-colors" %>
    </div>
  <% end %>

</div>
