<div class="max-w-2xl mx-auto px-4 py-10">

  <%# パンくず %>
  <nav class="text-sm text-gray-400 mb-6">
    <%= link_to "一覧へ戻る", reflection_notes_path,
          class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2">/</span>
    <span class="text-gray-600">新規作成</span>
  </nav>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
    <h1 class="text-xl font-bold text-gray-800 mb-8">振り返りメモを作成</h1>

    <%= form_with model: @reflection_note, url: reflection_notes_path do |f| %>

      <%= render "form", f: f,
            reflection_note: @reflection_note,
            existing_tags: @existing_tags %>

      <div class="flex items-center gap-3">
        <%= f.submit "作成する",
              class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium
                      px-6 py-2 rounded-lg transition-colors cursor-pointer" %>
        <%= link_to "キャンセル",
              reflection_notes_path,
              class: "text-sm font-medium text-gray-500 hover:text-gray-800
                      border border-gray-300 hover:border-gray-400
                      px-6 py-2 rounded-lg transition-colors" %>
      </div>

    <% end %>
  </div>

</div>
