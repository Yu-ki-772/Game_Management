<%# app/views/reflection_notes/new.html.erb %>
<%= turbo_frame_tag "dialog" do %>
  <dialog data-controller="dialog"
          data-action="click->dialog#clickOutside turbo:before-cache@window->dialog#beforeCache"
          class="fixed inset-0 mx-auto mt-20 rounded-xl shadow-lg p-6 w-11/12 max-w-2xl backdrop:bg-black/40 bg-white dark:bg-gray-800">

    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">振り返りメモを作成</h2>
      <button data-action="click->dialog#close"
              type="button"
              class="text-gray-400 hover:text-gray-600 transition">✕</button>
    </div>

    <%= form_with model: @reflection_note, url: reflection_notes_path do |f| %>

      <%= render "form", f: f,
            reflection_note: @reflection_note,
            existing_tags: @existing_tags %>

      <div class="flex items-center gap-3">
        <%= f.submit "作成する",
              class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium
                      px-6 py-2 rounded-lg transition-colors cursor-pointer" %>
        <button type="button"
                data-action="click->dialog#close"
                class="text-sm font-medium text-gray-500 dark:text-gray-400
                       hover:text-gray-800 dark:hover:text-gray-200
                       border border-gray-300 dark:border-gray-600
                       hover:border-gray-400 dark:hover:border-gray-500
                       px-6 py-2 rounded-lg transition-colors">
          キャンセル
        </button>
      </div>

    <% end %>
  </dialog>
<% end %>