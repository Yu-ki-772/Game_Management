<%# app/views/reflection_notes/_search_form.html.erb %>
<div class="mb-4" data-controller="search">
  <%= search_form_for @q, url: reflection_notes_path(period: params[:period]), method: :get,
      html: { data: { search_target: "form" } } do |f| %>

    <div class="flex flex-col gap-3 md:flex-row md:items-center">
      <%# テキスト検索 %>
      <div class="relative flex-1">

        <%# 検索アイコン %>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400 dark:text-gray-500"
              xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>

        <%= f.text_field :title_or_body_cont,
            placeholder: "タイトルまたは本文を検索...",
            maxlength: 100,
            autofocus: true,
            class: "w-full pl-10 pr-4 py-2 
                    border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    placeholder-gray-400 dark:placeholder-gray-500
                    focus:outline-none focus:ring-2 focus:ring-emerald-500
                    focus:ring-offset-0 focus:border-transparent transition",
            data: { action: "input->search#search", turbo_permanent: true } %>
      </div>

      <%# 種別フィルター %>
      <div class="relative md:w-48">
        <%= f.select :reflection_type_eq,
            options_for_select(
              [["すべての種別", ""]] + ReflectionNote.reflection_types.map { |key, value|
                [I18n.t("enums.reflection_note.reflection_type.#{key}"), value]
              },
              f.object.reflection_type_eq
            ),
            {},
            class: "w-full px-4 py-2.5
                    border border-gray-300 dark:border-gray-600
                    rounded-lg
                    bg-white dark:bg-gray-700
                    text-gray-900 dark:text-gray-100
                    focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500
                    text-sm appearance-none",
            data: { action: "change->search#search" } %>
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-gray-400 dark:text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>

      <%# タグフィルター %>
      <div class="relative md:w-48">
        <%= f.select :tags_id_eq,
            options_for_select(
              [["すべてのタグ", ""]] + @all_tags.map { |t| ["\# #{t.name}", t.id] },
              f.object.tags_id_eq
            ),
            {},
            class: "w-full px-4 py-2.5
                    border border-gray-300 dark:border-gray-600
                    rounded-lg
                    bg-white dark:bg-gray-700
                    text-gray-900 dark:text-gray-100
                    focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500
                    text-sm appearance-none",
            data: { action: "change->search#search" } %>
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-gray-400 dark:text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>
    </div>
  <% end %>
</div>