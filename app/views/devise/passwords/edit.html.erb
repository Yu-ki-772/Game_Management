<%# app/views/devise/passwords/edit.html.erb %>
<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4">
  <div class="w-full max-w-md">

    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">新しいパスワードを設定</h2>
      <% if @minimum_password_length %>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= @minimum_password_length %>文字以上で設定してください</p>
      <% end %>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-8">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="space-y-5">
          <div>
            <%= f.label :password, "新しいパスワード",
                class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= f.password_field :password,
                autofocus: true,
                autocomplete: "new-password",
                class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                        bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                        focus:outline-none focus:ring-1 focus:ring-emerald-500
                        focus:border-emerald-500 focus:ring-offset-0 transition" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "パスワードの確認",
                class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                        bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                        focus:outline-none focus:ring-1 focus:ring-emerald-500
                        focus:border-emerald-500 focus:ring-offset-0 transition" %>
          </div>

          <div>
            <%= f.submit "パスワードを変更する",
                class: "w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700
                        dark:hover:bg-emerald-500
                        text-white text-sm font-semibold rounded-lg
                        transition cursor-pointer" %>
          </div>
        </div>
      <% end %>

      <div class="pt-6 mt-6 border-t border-gray-100 dark:border-gray-700 flex flex-col items-center gap-3">
        <%= link_to "ログイン", new_session_path(resource_name),
            class: "text-sm text-emerald-600 dark:text-emerald-400
                    hover:text-emerald-700 dark:hover:text-emerald-300
                    font-medium transition" %>
        <%= link_to "新規登録", new_registration_path(resource_name),
            class: "text-sm text-emerald-600 dark:text-emerald-400
                    hover:text-emerald-700 dark:hover:text-emerald-300
                    font-medium transition" %>
        <%= link_to "アカウントロックの解除", new_unlock_path(resource_name),
            class: "text-sm text-gray-400 dark:text-gray-500
                    hover:text-gray-600 dark:hover:text-gray-300 transition" %>
      </div>
    </div>

  </div>
</div>