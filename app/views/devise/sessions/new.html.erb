<%# app/views/devise/sessions/new.html.erb %>
<div class="min-h-screen flex items-center justify-center px-4 py-12
            bg-white dark:bg-gray-950">

  <div class="w-full max-w-md">

    <%# ヘッダー：タイトル %>
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">ログイン</h2>
      <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">アカウントにログインしてください</p>
    </div>

    <%# メインカード %>
    <div class="bg-gray-50 dark:bg-gray-900
                rounded-xl
                border border-gray-200 dark:border-gray-800
                p-8">

      <%# Google OAuth ボタン %>
      <div class="mb-6 flex justify-center">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            data: { turbo: false },
            class: "bg-transparent border-0 p-0 cursor-pointer
                    transition-transform hover:scale-105 active:scale-95" do %>
          <%= image_tag "google_login.svg", height: 40 %>
        <% end %>
      </div>

      <%# 区切り線 %>
      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-200 dark:border-gray-800"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="px-3 bg-gray-50 dark:bg-gray-900
                       text-gray-400 dark:text-gray-500 text-xs font-medium">
            または
          </span>
        </div>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name),
          html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# メールアドレス %>
        <div class="space-y-1.5">
          <%= f.label :email, "メールアドレス",
              class: "block text-sm font-semibold text-gray-700 dark:text-gray-300" %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "example@email.com",
                class: "w-full pl-10 pr-4 py-2.5 rounded-md
                        border border-gray-200 dark:border-gray-700
                        bg-white dark:bg-gray-800
                        text-gray-900 dark:text-gray-100 text-sm
                        placeholder-gray-400 dark:placeholder-gray-500
                        focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600
                        focus:border-gray-400 dark:focus:border-gray-600
                        transition-colors" %>
          </div>
        </div>

        <%# パスワード %>
        <div class="space-y-1.5">
          <%= f.label :password, "パスワード",
              class: "block text-sm font-semibold text-gray-700 dark:text-gray-300" %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <%= f.password_field :password,
                autocomplete: "current-password",
                class: "w-full pl-10 pr-4 py-2.5 rounded-md
                        border border-gray-200 dark:border-gray-700
                        bg-white dark:bg-gray-800
                        text-gray-900 dark:text-gray-100 text-sm
                        focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600
                        focus:border-gray-400 dark:focus:border-gray-600
                        transition-colors" %>
          </div>
        </div>


        <%# ログインボタン %>
        <div>
          <%= f.submit "ログイン",
              class: "w-full py-3 px-4 rounded-md
                      text-sm font-bold
                      text-white dark:text-gray-900
                      bg-gray-900 dark:bg-white
                      hover:bg-gray-700 dark:hover:bg-gray-300
                      transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <%# リンク類 %>
      <div class="pt-6 mt-6 border-t border-gray-200 dark:border-gray-800
                  flex flex-col items-center gap-3">
        <%= link_to "新規登録", new_registration_path(resource_name),
            class: "text-sm font-semibold
                    text-gray-700 dark:text-gray-300
                    hover:text-gray-900 dark:hover:text-gray-100
                    transition-colors" %>
        <%= link_to "パスワードをお忘れの方", new_password_path(resource_name),
            class: "text-sm text-gray-400 dark:text-gray-500
                    hover:text-gray-600 dark:hover:text-gray-300 transition-colors" %>
        <%= link_to "アカウントロックの解除", new_unlock_path(resource_name),
            class: "text-sm text-gray-400 dark:text-gray-500
                    hover:text-gray-600 dark:hover:text-gray-300 transition-colors" %>
      </div>
    </div>

  </div>
</div>