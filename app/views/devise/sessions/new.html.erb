<%# app/views/devise/sessions/new.html.erb %>
<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-8">

    <div class="pb-5 border-b border-gray-200 dark:border-gray-700 mb-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">ログイン</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">アカウントにログインしてください</p>
    </div>

    <%# Google OAuth ボタン %>
    <div class="mb-6">
      <%= button_to user_google_oauth2_omniauth_authorize_path,
          method: :post,
          data: { turbo: false },
          class: "w-full py-2.5 px-4
                  bg-white dark:bg-gray-700
                  hover:bg-gray-50 dark:hover:bg-gray-600
                  text-gray-700 dark:text-gray-200
                  text-sm font-semibold
                  border border-gray-200 dark:border-gray-600
                  rounded-lg transition flex items-center justify-center gap-2" do %>
        Googleでログイン
      <% end %>
    </div>

    <%# 区切り線 %>
    <div class="relative mb-6">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-100 dark:border-gray-700"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="px-2 bg-white dark:bg-gray-800 text-gray-400 dark:text-gray-500 text-xs">または</span>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>

      <div>
        <%= f.label :email, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.password_field :password,
            autocomplete: "current-password",
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me,
              class: "h-4 w-4 text-emerald-600 focus:ring-emerald-300
                      border-gray-200 dark:border-gray-600 rounded
                      bg-white dark:bg-gray-700" %>
          <%= f.label :remember_me, "ログイン状態を保持する",
              class: "text-sm text-gray-600 dark:text-gray-400" %>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit "ログイン",
            class: "w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition cursor-pointer" %>
      </div>

    <% end %>

    <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>