<%# app/views/devise/sessions/new.html.erb %>
<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4">
  <div class="w-full max-w-md">

    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">ログイン</h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">アカウントにログインしてください</p>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-8">

      <%# Google OAuth ボタン %>
      <div class="mb-6 flex justify-center">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            data: { turbo: false },
            class: "bg-transparent border-0 p-0 cursor-pointer" do %>
          <%= image_tag "google_login.svg", height: 40 %>
        <% end %>
      </div>

      <%# 区切り線 %>
      <div class="relative mb-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-100 dark:border-gray-700"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="px-2 bg-white dark:bg-gray-800 text-gray-400 dark:text-gray-500 text-xs">または</span>
        </div>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "メールアドレス",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                      bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                      focus:outline-none focus:ring-1 focus:ring-emerald-500
                      focus:border-emerald-500 focus:ring-offset-0 transition" %>
        </div>

        <div>
          <%= f.label :password, "パスワード",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                      bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                      focus:outline-none focus:ring-1 focus:ring-emerald-500
                      focus:border-emerald-500 focus:ring-offset-0 transition" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me,
                class: "h-4 w-4 text-emerald-600 focus:ring-emerald-300
                        border-gray-300 dark:border-gray-600 rounded
                        bg-white dark:bg-gray-700" %>
            <%= f.label :remember_me, "ログイン状態を保持する",
                class: "text-sm text-gray-600 dark:text-gray-400" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "ログイン",
              class: "w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700
                      dark:hover:bg-emerald-500
                      text-white text-sm font-semibold rounded-lg
                      transition cursor-pointer" %>
        </div>
      <% end %>

      <div class="pt-6 mt-6 border-t border-gray-100 dark:border-gray-700">
        <%= render "devise/shared/links" %>
      </div>
    </div>

  </div>
</div>