<%# app/views/devise/shared/_error_messages.html.erb %>
<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false"
       class="mb-6 rounded-lg bg-red-50 dark:bg-red-900/30
              border border-red-200 dark:border-red-800
              px-4 py-3" role="alert">
    <p class="text-xs font-semibold text-red-600 dark:text-red-400 mb-1">
      <%= pluralize(resource.errors.count, "件のエラー") %>が発生しました
    </p>
    <ul class="space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li class="text-xs text-red-600 dark:text-red-400"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>