<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class="mb-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3" role="alert">
    <p class="text-xs font-semibold text-red-600 mb-1">
      <%= pluralize(resource.errors.count, "件のエラー") %>が発生しました
    </p>
    <ul class="space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li class="text-xs text-red-600"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>