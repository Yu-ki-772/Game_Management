<%# app/views/devise/shared/_links.html.erb %>
<div class="flex flex-col items-center gap-3">

  <%- if controller_name != 'sessions' %>
    <%= link_to "ログイン", new_session_path(resource_name),
        class: "text-sm text-emerald-600 dark:text-emerald-400
                hover:text-emerald-700 dark:hover:text-emerald-300
                font-medium transition" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "新規登録", new_registration_path(resource_name),
        class: "text-sm text-emerald-600 dark:text-emerald-400
                hover:text-emerald-700 dark:hover:text-emerald-300
                font-medium transition" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "パスワードをお忘れの方", new_password_path(resource_name),
        class: "text-sm text-gray-400 dark:text-gray-500
                hover:text-gray-600 dark:hover:text-gray-300 transition" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "確認メールが届かない方", new_confirmation_path(resource_name),
        class: "text-sm text-gray-400 dark:text-gray-500
                hover:text-gray-600 dark:hover:text-gray-300 transition" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "アカウントロックの解除", new_unlock_path(resource_name),
        class: "text-sm text-gray-400 dark:text-gray-500
                hover:text-gray-600 dark:hover:text-gray-300 transition" %>
  <% end %>

</div>