<%# app/views/devise/registrations/new.html.erb %>
<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4 py-12">
  <div class="w-full max-w-md">

    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">アカウント作成</h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">アカウントを作成してください</p>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <p class="text-sm text-gray-500 dark:text-gray-400">
          <span class="text-red-500">*</span> は必須項目です
        </p>

        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" do %>
            名前 <span class="text-red-500">*</span>
          <% end %>
          <%= f.text_field :name,
              autofocus: true,
              autocomplete: "name",
              class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                      bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                      focus:outline-none focus:ring-1 focus:ring-emerald-500
                      focus:border-emerald-500 focus:ring-offset-0 transition" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" do %>
            メールアドレス <span class="text-red-500">*</span>
          <% end %>
          <%= f.email_field :email,
              autocomplete: "email",
              class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                      bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                      focus:outline-none focus:ring-1 focus:ring-emerald-500
                      focus:border-emerald-500 focus:ring-offset-0 transition" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" do %>
            パスワード <span class="text-red-500">*</span>
          <% end %>
          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                      bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                      focus:outline-none focus:ring-1 focus:ring-emerald-500
                      focus:border-emerald-500 focus:ring-offset-0 transition" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1.5 ml-1"><%= @minimum_password_length %> 文字以上</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" do %>
            パスワード確認 <span class="text-red-500">*</span>
          <% end %>
          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
                      bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm
                      focus:outline-none focus:ring-1 focus:ring-emerald-500
                      focus:border-emerald-500 focus:ring-offset-0 transition" %>
        </div>

        <div>
          <%= f.submit "アカウントを作成",
              class: "w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700
                      dark:hover:bg-emerald-500
                      text-white text-sm font-semibold rounded-lg
                      transition cursor-pointer" %>
        </div>
      <% end %>

      <div class="pt-6 mt-6 border-t border-gray-100 dark:border-gray-700 flex flex-col items-center gap-3">
        <%= link_to "ログイン", new_session_path(resource_name),
            class: "text-sm text-emerald-600 dark:text-emerald-400
                    hover:text-emerald-700 dark:hover:text-emerald-300
                    font-medium transition" %>
      </div>
    </div>

  </div>
</div>