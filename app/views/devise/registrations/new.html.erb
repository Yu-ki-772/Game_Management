<%# app/views/devise/registrations/new.html.erb %>
<div class="min-h-screen flex items-center justify-center px-4 py-12 relative overflow-hidden
            bg-gradient-to-br from-gray-50 via-emerald-50/30 to-gray-100
            dark:from-gray-950 dark:via-emerald-950/20 dark:to-gray-900">

  <div class="pointer-events-none absolute -top-32 -right-32 w-96 h-96 rounded-full
              bg-emerald-200/30 dark:bg-emerald-900/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-32 w-96 h-96 rounded-full
              bg-emerald-300/20 dark:bg-emerald-800/10 blur-3xl"></div>

  <div class="w-full max-w-md relative z-10">

    <%# ヘッダー：アイコン＋タイトル %>
    <div class="text-center mb-8">

      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">アカウント作成</h2>
      <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">アカウントを作成してください</p>
    </div>

    <%# メインカード %>
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm
                rounded-2xl shadow-xl shadow-gray-200/60 dark:shadow-gray-950/40
                border border-white dark:border-gray-700/60 p-8">

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
          html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <p class="text-xs text-gray-400 dark:text-gray-500">
          <span class="text-red-500 font-bold">*</span> は必須項目です
        </p>

        <%# ユーザネーム %>
        <div class="space-y-1.5">
          <%= f.label :name, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300" do %>
            ユーザネーム <span class="text-red-400">*</span>
          <% end %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <%= f.text_field :name,
                autofocus: true,
                autocomplete: "name",
                class: "w-full pl-10 pr-4 py-2.5 rounded-xl
                        border border-gray-200 dark:border-gray-600
                        bg-gray-50 dark:bg-gray-700/60
                        text-gray-900 dark:text-gray-100 text-sm
                        placeholder-gray-400 dark:placeholder-gray-500
                        focus:outline-none focus:ring-2 focus:ring-emerald-500/40
                        focus:border-emerald-500 focus:bg-white dark:focus:bg-gray-700
                        transition duration-150" %>
          </div>
        </div>

        <%# メールアドレス %>
        <div class="space-y-1.5">
          <%= f.label :email, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300" do %>
            メールアドレス <span class="text-red-400">*</span>
          <% end %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <%= f.email_field :email,
                autocomplete: "email",
                placeholder: "example@email.com",
                class: "w-full pl-10 pr-4 py-2.5 rounded-xl
                        border border-gray-200 dark:border-gray-600
                        bg-gray-50 dark:bg-gray-700/60
                        text-gray-900 dark:text-gray-100 text-sm
                        placeholder-gray-400 dark:placeholder-gray-500
                        focus:outline-none focus:ring-2 focus:ring-emerald-500/40
                        focus:border-emerald-500 focus:bg-white dark:focus:bg-gray-700
                        transition duration-150" %>
          </div>
        </div>

        <%# パスワード %>
        <div class="space-y-1.5">
          <%= f.label :password, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300" do %>
            パスワード <span class="text-red-400">*</span>
          <% end %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <%= f.password_field :password,
                autocomplete: "new-password",
                class: "w-full pl-10 pr-4 py-2.5 rounded-xl
                        border border-gray-200 dark:border-gray-600
                        bg-gray-50 dark:bg-gray-700/60
                        text-gray-900 dark:text-gray-100 text-sm
                        focus:outline-none focus:ring-2 focus:ring-emerald-500/40
                        focus:border-emerald-500 focus:bg-white dark:focus:bg-gray-700
                        transition duration-150" %>
          </div>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1 ml-1 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <%= @minimum_password_length %> 文字以上
            </p>
          <% end %>
        </div>

        <%# パスワード確認 %>
        <div class="space-y-1.5">
          <%= f.label :password_confirmation, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300" do %>
            パスワード確認 <span class="text-red-400">*</span>
          <% end %>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "w-full pl-10 pr-4 py-2.5 rounded-xl
                        border border-gray-200 dark:border-gray-600
                        bg-gray-50 dark:bg-gray-700/60
                        text-gray-900 dark:text-gray-100 text-sm
                        focus:outline-none focus:ring-2 focus:ring-emerald-500/40
                        focus:border-emerald-500 focus:bg-white dark:focus:bg-gray-700
                        transition duration-150" %>
          </div>
        </div>

        <%# 送信ボタン %>
        <div class="pt-1">
          <%= f.submit "アカウントを作成",
              class: "w-full py-3 px-4
                      bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700
                      dark:bg-emerald-600 dark:hover:bg-emerald-500
                      text-white text-sm font-bold tracking-wide rounded-xl
                      shadow-md shadow-emerald-500/30
                      transition-all duration-150 cursor-pointer
                      hover:shadow-lg hover:shadow-emerald-500/40
                      hover:-translate-y-px active:translate-y-0" %>
        </div>
      <% end %>

      <%# リンク類 %>
      <div class="pt-6 mt-6 border-t border-gray-100 dark:border-gray-700
                  flex flex-col items-center gap-3">
        <%= link_to "ログインはこちら", new_session_path(resource_name),
            class: "text-sm text-emerald-600 dark:text-emerald-400
                    hover:text-emerald-700 dark:hover:text-emerald-300
                    font-semibold transition" %>
      </div>
    </div>

  </div>
</div>
