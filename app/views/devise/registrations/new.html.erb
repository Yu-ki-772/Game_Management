<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full bg-white rounded-xl shadow-sm border border-gray-100 p-8">

    <div class="pb-5 border-b border-gray-200 mb-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900">アカウント作成</h2>
      <p class="mt-1 text-sm text-gray-500">アカウントを作成してください</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <p class="text-sm text-gray-500">
        <span class="text-red-500">*</span> は必須項目です
      </p>

      <div>
        <%= f.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          名前 <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :name,
            autofocus: true,
            autocomplete: "name",
            class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          メールアドレス <span class="text-red-500">*</span>
        <% end %>
        <%= f.email_field :email,
            autocomplete: "email",
            class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          パスワード <span class="text-red-500">*</span>
        <% end %>
        <%= f.password_field :password,
            autocomplete: "new-password",
            class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mt-1.5 ml-1"><%= @minimum_password_length %> 文字以上</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          パスワード確認 <span class="text-red-500">*</span>
        <% end %>
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
      </div>

      <div class="pt-2">
        <%= f.submit "アカウントを作成",
            class: "w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 pt-6 border-t border-gray-100 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>