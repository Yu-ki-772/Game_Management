<%# app/views/devise/registrations/edit.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="max-w-md">

    <%# 戻るリンク %>
    <%= link_to user_path(current_user),
          class: "inline-flex items-center gap-1 text-sm
                  text-gray-400 dark:text-gray-500
                  hover:text-gray-700 dark:hover:text-gray-300
                  transition-colors duration-100 mb-6" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      プロフィールに戻る
    <% end %>

    <%# ページヘッダ %>
    <div class="pb-5 border-b border-gray-200 dark:border-gray-800 mb-8">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
        プロフィール編集
      </h1>
    </div>

    <%# 編集フォーム %>
    <div class="bg-white dark:bg-gray-900 rounded-xl
                border border-gray-200 dark:border-gray-800 p-8">

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
          html: { method: :put, class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# アバター %>
        <div class="flex flex-col items-center gap-4">
          <% if @user.avatar_image? %>
            <%= image_tag @user.avatar,
                class: "rounded-full w-20 h-20 object-cover
                        border border-gray-200 dark:border-gray-800" %>
          <% else %>
            <%# アbたー画像未設定時のデフォルトアイコン（ヘッダーと統一） %>
            <div class="w-20 h-20 rounded-full
                        bg-gray-50 dark:bg-gray-800
                        border border-gray-200 dark:border-gray-800
                        flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24"
                   fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round"
                   class="text-gray-400 dark:text-gray-500">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
              </svg>
            </div>
          <% end %>

          <div class="w-full">
            <%= f.label :avatar, "アバター画像",
                class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
            <div class="rounded-md border border-gray-200 dark:border-gray-800
                        bg-gray-50 dark:bg-gray-800 p-1">
              <%= f.file_field :avatar,
                  class: "w-full text-sm text-gray-500 dark:text-gray-400
                          file:mr-3 file:py-1.5 file:px-4 file:rounded-md
                          file:border file:border-gray-200 dark:file:border-gray-700
                          file:text-xs file:font-semibold file:text-gray-600 dark:file:text-gray-400
                          file:bg-white dark:file:bg-gray-900
                          hover:file:bg-gray-50 dark:hover:file:bg-gray-800
                          file:transition-colors" %>
            </div>
          </div>
        </div>

        <%# ユーザーネーム %>
        <div>
          <%= f.label :name, "ユーザネーム",
              class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
          <%= f.text_field :name,
              class: "w-full px-4 py-2
                      border border-gray-200 dark:border-gray-800 rounded-md text-sm
                      bg-gray-50 dark:bg-gray-800
                      text-gray-900 dark:text-gray-100
                      focus:outline-none focus:ring-1
                      focus:ring-gray-400 dark:focus:ring-gray-600
                      focus:border-gray-400 dark:focus:border-gray-600
                      transition-colors duration-100" %>
        </div>

        <%# 自己紹介 %>
        <div>
          <%= f.label :description, "自己紹介",
              class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" %>
          <%= f.text_area :description,
              rows: 4,
              class: "w-full px-4 py-2
                      border border-gray-200 dark:border-gray-800 rounded-md text-sm
                      bg-gray-50 dark:bg-gray-800
                      text-gray-900 dark:text-gray-100
                      focus:outline-none focus:ring-1
                      focus:ring-gray-400 dark:focus:ring-gray-600
                      focus:border-gray-400 dark:focus:border-gray-600
                      resize-y transition-colors duration-100" %>
        </div>

        <%# 更新ボタン＋キャンセルボタン %>
        <div class="flex items-center gap-3 pt-2">
          <%= link_to "キャンセル", user_path(current_user),
              class: "flex-1 text-center py-2.5 px-4
                      text-sm font-semibold
                      text-gray-500 dark:text-gray-400
                      hover:text-gray-700 dark:hover:text-gray-200
                      hover:bg-gray-100 dark:hover:bg-gray-800
                      rounded-md transition-colors duration-100" %>
          <%= f.submit "更新",
              data: { turbo_submits_with: "更新中..." },
              class: "flex-1 py-2.5 px-4
                      bg-gray-900 dark:bg-white
                      hover:bg-gray-700 dark:hover:bg-gray-300
                      text-white dark:text-gray-900
                      text-sm font-semibold rounded-md
                      transition-colors duration-100 cursor-pointer" %>
        </div>

      <% end %>
    </div>

  </div>
</div>