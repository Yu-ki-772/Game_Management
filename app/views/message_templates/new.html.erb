<%# app/views/message_templates/new.html.erb %>
<%= turbo_frame_tag "dialog" do %>
  <dialog data-controller="dialog"
          data-action="click->dialog#clickOutside turbo:before-cache@window->dialog#beforeCache"
          class="fixed inset-0 mx-auto mt-16 rounded-2xl shadow-xl
                 p-0 w-11/12 max-w-lg
                 backdrop:bg-black/50
                 bg-white dark:bg-gray-800
                 border border-gray-100 dark:border-gray-700">

    <%# ── ヘッダー ── %>
    <div class="flex items-start justify-between px-6 pt-6 pb-5
                border-b border-gray-100 dark:border-gray-700">
      <div>
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 leading-tight">
          定型文を作成
        </h2>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
          カテゴリごとにグループ化されます
        </p>
      </div>
      <button data-action="click->dialog#close"
              type="button"
              class="p-1.5 -mt-1 -mr-1 rounded-lg
                     text-gray-400 dark:text-gray-500
                     hover:text-gray-600 dark:hover:text-gray-300
                     hover:bg-gray-100 dark:hover:bg-gray-700
                     transition-colors duration-100"
              aria-label="閉じる">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <%# ── フォーム本体 ── %>
    <%= form_with model: @message_template, class: "px-6 py-5 space-y-5" do |f| %>

      <p class="text-xs text-gray-400 dark:text-gray-500">
        <span class="text-red-500 font-medium">*</span> は必須項目です
      </p>

      <%= render 'shared/error_messages', object: f.object %>

      <%# ── 理由・カテゴリ ── %>
      <div class="space-y-1.5">
        <%= f.label :reason, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" do %>
          理由・カテゴリ <span class="text-red-400">*</span>
        <% end %>
        <%= f.text_field :reason,
            placeholder: '例: 体調不良',
            list: 'reason-datalist',
            class: "w-full px-3.5 py-2.5
                    border border-gray-200 dark:border-gray-600 rounded-lg
                    text-sm text-gray-900 dark:text-gray-100
                    bg-white dark:bg-gray-700/60
                    placeholder:text-gray-300 dark:placeholder:text-gray-600
                    focus:outline-none focus:ring-2 focus:ring-emerald-400/50
                    focus:border-emerald-400 dark:focus:border-emerald-500
                    transition-colors duration-100" %>
        <p class="text-xs text-gray-400 dark:text-gray-500 leading-relaxed">
          既存カテゴリを選択、または新しく入力できます（255文字以内）
        </p>
        <datalist id="reason-datalist">
          <% @existing_reasons.each do |reason| %>
            <option value="<%= reason %>"></option>
          <% end %>
        </datalist>
      </div>

      <%# ── 定型文の内容 ── %>
      <div class="space-y-1.5">
        <%= f.label :template, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" do %>
          定型文の内容 <span class="text-red-400">*</span>
        <% end %>
        <%= f.text_area :template,
            rows: 5,
            placeholder: '定型文の内容を入力してください...',
            class: "w-full px-3.5 py-2.5
                    border border-gray-200 dark:border-gray-600 rounded-lg
                    text-sm text-gray-900 dark:text-gray-100
                    bg-white dark:bg-gray-700/60
                    placeholder:text-gray-300 dark:placeholder:text-gray-600
                    focus:outline-none focus:ring-2 focus:ring-emerald-400/50
                    focus:border-emerald-400 dark:focus:border-emerald-500
                    resize-y transition-colors duration-100" %>
        <p class="text-xs text-gray-400 dark:text-gray-500">
          255文字以内
        </p>
      </div>

      <%# ── フッター: 送信 + キャンセル ── %>
      <div class="flex items-center justify-between pt-2
                  border-t border-gray-100 dark:border-gray-700">
        <button type="button"
                data-action="click->dialog#close"
                class="px-4 py-2 text-sm font-medium rounded-lg
                       text-gray-500 dark:text-gray-400
                       hover:text-gray-700 dark:hover:text-gray-200
                       hover:bg-gray-100 dark:hover:bg-gray-700
                       transition-colors duration-100">
          キャンセル
        </button>

        <%= f.submit '作成する',
            class: "px-5 py-2 text-sm font-semibold rounded-lg
                    bg-emerald-500 hover:bg-emerald-600
                    text-white
                    shadow-sm
                    transition-colors duration-100 cursor-pointer" %>
      </div>

    <% end %>
  </dialog>
<% end %>
