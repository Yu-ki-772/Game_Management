<%# 定型文作成画面 %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%# ページヘッダー %>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3 pb-5 border-b border-gray-200 mb-8">
    <h1 class="text-2xl font-bold text-gray-900">定型文を作成</h1>
    <span class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 rounded-full self-start sm:self-auto">
      カテゴリごとにグループ化されます
    </span>
  </div>

  <%#
    フォームカード: 他ページのカードと同じ shadow-sm + border に統一。
    スマホでは横幅いっぱい、md以上で max-w-2xl に制限。
  %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-2xl">
    <%= form_with model: @message_template, class: "space-y-6" do |f| %>

      <p class="text-sm text-gray-500">
        <span class="text-red-500">*</span> は必須項目です
      </p>

      <%= render 'shared/error_messages', object: f.object %>

      <div>
        <%= f.label :reason, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          理由・カテゴリ <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :reason,
            placeholder: '例: 体調不良',
            list: 'reason-datalist',
            class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>

        <datalist id="reason-datalist">
          <% @existing_reasons.each do |reason| %>
            <option value="<%= reason %>"></option>
          <% end %>
        </datalist>

        <p class="text-xs text-gray-400 mt-1.5 ml-1">
          一覧画面ではこのカテゴリごとに表示されます
        </p>
      </div>

      <div>
        <%= f.label :template, class: "block text-sm font-semibold text-gray-700 mb-2" do %>
          定型文の内容 <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_area :template,
            rows: 5,
            placeholder: '定型文の内容を入力してください...',
            class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent resize-y transition" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit '定型文を作成',
            class: "px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition cursor-pointer" %>
        <%= link_to 'キャンセル', message_templates_path,
            class: "px-5 py-2 bg-white hover:bg-gray-50 text-gray-600 text-sm font-semibold rounded-lg border border-gray-200 transition" %>
      </div>
    <% end %>
  </div>
</div>