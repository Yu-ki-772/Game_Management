<%# app/views/message_templates/_templates_list.html.erb %>
<%# コピー専用。管理操作(ブックマーク・編集等)は一切含まない。 %>

<% if message_templates.empty? %>
  <div class="bg-white dark:bg-gray-950
              border border-gray-200 dark:border-gray-800
              rounded-xl p-12 text-center">
    <svg class="mx-auto h-8 w-8 text-gray-500 dark:text-gray-700 mb-4"
         xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <p class="text-base font-medium text-gray-700 dark:text-gray-400 mb-1">
      <%= empty_message %>
    </p>
  </div>

<% else %>

  <div class="space-y-5">
    <% message_templates.group_by(&:reason).each do |reason, templates| %>

      <section class="bg-white dark:bg-gray-950
                      border border-gray-300 dark:border-gray-800
                      rounded-xl overflow-hidden"
               data-controller="disclosure"
               data-disclosure-key-value="<%= reason %>">

        <button type="button"
                data-action="click->disclosure#toggle"
                class="w-full px-5 py-3.5 flex items-center justify-between
                       bg-gray-50 dark:bg-gray-900/40
                       hover:bg-gray-100 dark:hover:bg-gray-900/60
                       transition-colors duration-100">
          <h2 class="text-lg text-gray-800 dark:text-gray-300 leading-snug">
            <%= reason %>
          </h2>
          <svg data-disclosure-target="icon"
               class="w-5 h-5 text-gray-400 dark:text-gray-500 shrink-0
                      transition-transform duration-200
                      -rotate-90"
               fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <ul data-disclosure-target="content"
            class="divide-y divide-gray-200 dark:divide-gray-800
                   hidden">
          <% templates.each do |template| %>

            <li class="px-5 py-4
                      hover:bg-gray-50 dark:hover:bg-gray-900/40
                      transition-colors duration-100"
                data-controller="clipboard">

              <div class="flex items-baseline gap-2 flex-wrap">
                <p class="text-base leading-relaxed text-gray-800 dark:text-gray-300"
                  data-clipboard-target="source">
                  <%= template.template %>
                </p>

                <button type="button"
                        data-clipboard-target="button"
                        data-action="click->clipboard#copy"
                        class="shrink-0 p-1 rounded-md
                              text-gray-400 dark:text-gray-500
                              hover:text-emerald-600 dark:hover:text-emerald-400
                              hover:bg-emerald-50 dark:hover:bg-emerald-900/30
                              transition-colors duration-100">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </div>
            </li>
          <% end %>
        </ul>

      </section>
    <% end %>
  </div>

<% end %>