<% if message_templates.empty? %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-gray-500 font-medium mb-2">
      <%= empty_message %>
    </p>
    <p class="text-gray-400 text-sm">
      <%= empty_description %>
    </p>
  </div>
<% else %>
  <div class="space-y-6">
    <% message_templates.group_by(&:reason).each do |reason, templates| %>
      <section class="bg-white rounded-xl shadow-sm border border-gray-100">

        <div class="px-4 md:px-6 py-4 border-b border-gray-100 bg-gray-50 rounded-t-xl">
          <div class="flex items-center gap-3">
            <span class="w-1 h-5 bg-emerald-500 rounded-full shrink-0"></span>
            <h2 class="text-base font-semibold text-gray-800">
              <%= reason %>
            </h2>
          </div>
        </div>

        <ul class="divide-y divide-gray-50 px-2 py-2">
          <% templates.each do |template| %>
            <% bookmark = user_bookmarks[template.id] %>

            <li class="px-3 md:px-4 py-3 rounded-lg hover:bg-emerald-50 transition group"
                data-controller="clipboard">
              <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between md:gap-4">
                <p class="text-gray-800 flex-1 text-sm leading-relaxed"
                   data-clipboard-target="source">
                  <%= template.template %>
                </p>

                <div class="flex items-center gap-2 shrink-0 justify-end md:justify-start">
                  <%# コピーボタン %>
                  <button type="button"
                          data-clipboard-target="button"
                          data-action="click->clipboard#copy"
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold rounded-md border border-blue-200 transition">
                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    コピー
                  </button>

                  <% if user_signed_in? %>
                    <% if bookmark %>
                      <%= render 'unbookmark_button', message_template: template, bookmark: bookmark %>
                    <% else %>
                      <%= render 'bookmark_button', message_template: template %>
                    <% end %>

                    <% if template.user_uuid.present? %>
                      <%= link_to edit_message_template_path(template),
                          class: "px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-md border border-emerald-200 transition" do %>
                        編集
                      <% end %>
                      <%= button_to message_template_path(template),
                          method: :delete,
                          data: { turbo_confirm: '本当に削除しますか?' },
                          class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded-md border border-red-200 transition" do %>
                        削除
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>