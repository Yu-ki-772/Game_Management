<%# 定型文編集画面 %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-baseline gap-3 pb-4 border-b-2 border-emerald-500 mb-8">
    <h1 class="text-3xl font-bold">定型文を編集</h1>
    <span class="text-xs bg-emerald-200 text-emerald-800 px-3 py-1 rounded-full">
      ※ カテゴリごとにグループ化されます
    </span>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 max-w-2xl">
    <%= form_with model: @message_template, class: "space-y-6" do |f| %>

      <p class="text-sm text-gray-600 mb-4">
        <span class="text-red-600">*</span>がついているのは必須項目です
      </p>

      <%# バリデーションエラーの表示用 %>
      <%= render 'shared/error_messages', object: f.object %>

      <div>
        <%= f.label :reason, class: "block text-gray-700 font-semibold mb-2" do %>
          理由・カテゴリ<span class="text-red-600">*</span>
        <% end %>
        <%= f.text_field :reason, 
            placeholder: '例: 体調不良',
            list: 'reason-datalist',
            class: "w-full px-4 py-2 border border-emerald-200 rounded focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent" %>

        <%# 既存の理由を表示 %>
        <datalist id="reason-datalist">
          <% @existing_reasons.each do |reason| %>
            <option value="<%= reason %>"></option>
          <% end %>
        </datalist>

        <span class="text-xs text-gray-500 font-normal ml-2 block mt-1">
          (一覧画面ではこのカテゴリごとに表示されます)
        </span>
      </div>

      <div>
        <%= f.label :template, class: "block text-gray-700 font-semibold mb-2" do %>
          定型文の内容<span class="text-red-600">*</span>
        <% end %>
        <%= f.text_area :template,
            rows: 5,
            placeholder: '定型文の内容を入力してください...', 
            class: "w-full px-4 py-2 border border-emerald-200 rounded focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent resize-y" %>
      </div>

      <div class="flex items-center space-x-4 pt-4">
        <%= f.submit '定型文を更新', 
            class: "px-6 py-2 bg-emerald-600 text-white rounded hover:bg-emerald-700 transition font-semibold cursor-pointer" %>
        <%= link_to 'キャンセル', message_templates_path, 
            class: "px-6 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400 transition font-semibold" %>
      </div>
    <% end %>
  </div>
</div>