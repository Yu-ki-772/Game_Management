<%# app/views/message_templates/edit.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%# 戻るリンク %>
  <%= link_to request.referer || message_templates_path,
        class: "inline-flex items-center gap-1 text-sm text-gray-400 dark:text-gray-500
                hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors mb-6" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    戻る
  <% end %>

  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3 pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">定型文を編集</h1>
    <span class="text-xs bg-emerald-50 dark:bg-emerald-900/30
                 text-emerald-700 dark:text-emerald-400
                 border border-emerald-200 dark:border-emerald-800
                 px-3 py-1 rounded-full self-start sm:self-auto">
      カテゴリごとにグループ化されます
    </span>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 max-w-2xl">
    <%= form_with model: @message_template, class: "space-y-6" do |f| %>

      <p class="text-sm text-gray-500 dark:text-gray-400">
        <span class="text-red-500">*</span> は必須項目です
      </p>

      <%= render 'shared/error_messages', object: f.object %>

      <div>
        <%= f.label :reason, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
          理由・カテゴリ <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :reason,
            placeholder: '例: 体調不良',
            list: 'reason-datalist',
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    placeholder-gray-400 dark:placeholder-gray-500
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent transition" %>
        <%# 既存の理由を表示 %>
        <datalist id="reason-datalist">
          <% @existing_reasons.each do |reason| %>
            <option value="<%= reason %>"></option>
          <% end %>
        </datalist>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1.5 ml-1">
          一覧画面ではこのカテゴリごとに表示されます
        </p>
      </div>

      <div>
        <%= f.label :template, class: "block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2" do %>
          定型文の内容 <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_area :template,
            rows: 5,
            placeholder: '定型文の内容を入力してください...',
            class: "w-full px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-lg text-sm
                    bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100
                    placeholder-gray-400 dark:placeholder-gray-500
                    focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:border-transparent
                    resize-y transition" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit '定型文を更新',
            class: "px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition cursor-pointer" %>
        <%= link_to 'キャンセル', request.referer || message_templates_path,
            class: "px-5 py-2 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600
                    text-gray-600 dark:text-gray-300 text-sm font-semibold rounded-lg
                    border border-gray-200 dark:border-gray-600 transition" %>
      </div>
    <% end %>
  </div>
</div>