<%# app/views/message_templates/edit.html.erb %>
<%= turbo_frame_tag "dialog" do %>
  <dialog data-controller="dialog"
          data-action="click->dialog#clickOutside turbo:before-cache@window->dialog#beforeCache"
          class="fixed inset-0 mx-auto mt-16
                 rounded-xl p-0 w-11/12 max-w-lg
                 backdrop:bg-black/50
                 bg-white dark:bg-gray-950
                 border border-gray-200 dark:border-gray-800">

    <%# ── ヘッダー ── %>
    <div class="flex items-start justify-between px-6 pt-6 pb-5
                border-b border-gray-200 dark:border-gray-800">
      <div>
        <h2 class="text-2xl font-bold tracking-tight
                   text-gray-900 dark:text-white leading-tight">
          定型文を編集
        </h2>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-0.5">
          カテゴリごとにグループ化されます
        </p>
      </div>
      <button data-action="click->dialog#close"
              type="button"
              class="p-1.5 -mt-1 -mr-1 rounded-md
                     text-gray-400 dark:text-gray-500
                     hover:text-gray-600 dark:hover:text-gray-300
                     hover:bg-gray-100 dark:hover:bg-gray-900
                     transition-colors duration-100"
              aria-label="閉じる">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <%# ── フォーム本体 ── %>
    <%= form_with model: @message_template, class: "px-6 py-5 space-y-5" do |f| %>

      <p class="text-sm text-gray-400 dark:text-gray-500">
        <span class="text-red-500 font-medium">*</span> は必須項目です
      </p>

      <%= render 'shared/error_messages', object: f.object %>

      <%# ── 理由・カテゴリ ── %>
      <div class="space-y-1.5">
        <%= f.label :reason,
            class: "block text-sm font-medium text-gray-700 dark:text-gray-300" do %>
          カテゴリ <span class="text-red-400">*</span>
        <% end %>
        <%= f.text_field :reason,
            placeholder: '例: 体調不良の場合',
            list: 'reason-datalist',
            class: "w-full px-3.5 py-2.5 text-base
                    border border-gray-200 dark:border-gray-800
                    rounded-md
                    bg-white dark:bg-gray-950
                    text-gray-900 dark:text-white
                    placeholder:text-gray-300 dark:placeholder:text-gray-600
                    focus:outline-none focus:ring-1
                    focus:ring-gray-400 dark:focus:ring-gray-600
                    focus:border-gray-400 dark:focus:border-gray-600
                    transition-colors duration-100" %>
        <p class="text-sm text-gray-400 dark:text-gray-500 leading-relaxed">
          既存カテゴリを選択、または新しく入力できます
        </p>
        <datalist id="reason-datalist">
          <% @existing_reasons.each do |reason| %>
            <option value="<%= reason %>"></option>
          <% end %>
        </datalist>
      </div>

      <%# ── 定型文の内容 ── %>
      <div class="space-y-1.5">
        <%= f.label :template,
            class: "block text-sm font-medium text-gray-700 dark:text-gray-300" do %>
          定型文の内容 <span class="text-red-400">*</span>
        <% end %>
        <%= f.text_area :template,
            rows: 5,
            placeholder: '定型文の内容を入力してください...',
            class: "w-full px-3.5 py-2.5 text-base
                    border border-gray-200 dark:border-gray-800
                    rounded-md
                    bg-white dark:bg-gray-950
                    text-gray-900 dark:text-white
                    placeholder:text-gray-300 dark:placeholder:text-gray-600
                    focus:outline-none focus:ring-1
                    focus:ring-gray-400 dark:focus:ring-gray-600
                    focus:border-gray-400 dark:focus:border-gray-600
                    transition-colors duration-100" %>
      </div>

      <%# ── フッター ── %>
      <div class="flex items-center justify-end gap-2 pt-2
                  border-t border-gray-200 dark:border-gray-800">

        <button type="button"
                data-action="click->dialog#close"
                class="px-4 py-2 text-sm font-medium rounded-md
                      text-gray-500 dark:text-gray-400
                      hover:text-gray-700 dark:hover:text-gray-200
                      hover:bg-gray-100 dark:hover:bg-gray-900
                      transition-colors duration-100">
          キャンセル
        </button>

        <%= f.submit '更新する',
            data: { turbo_submits_with: "更新中..." },
            class: "px-5 py-2 text-base font-semibold rounded-md
                    bg-gray-900 dark:bg-white
                    text-white dark:text-gray-900
                    hover:bg-gray-700 dark:hover:bg-gray-100
                    transition-colors duration-100 cursor-pointer" %>
      </div>

    <% end %>
  </dialog>
<% end %>