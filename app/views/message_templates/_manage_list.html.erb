<%# app/views/message_templates/_manage_list.html.erb %>
<%# 管理専用。ブックマーク・編集・削除が主役。コピーボタンは含まない。 %>

<% if message_templates.empty? %>
  <div class="bg-white dark:bg-gray-950
              border border-gray-200 dark:border-gray-800
              rounded-xl p-12 text-center">
    <svg class="mx-auto h-8 w-8 text-gray-300 dark:text-gray-700 mb-4"
         xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">
      <%= empty_message %>
    </p>
    <p class="text-xs text-gray-400 dark:text-gray-500">
      <%= empty_description %>
    </p>
  </div>

<% else %>

  <div class="space-y-5">
    <% message_templates.group_by(&:reason).each do |reason, templates| %>

      <section class="bg-white dark:bg-gray-950
                      border border-gray-200 dark:border-gray-800
                      rounded-xl overflow-hidden"
               data-controller="disclosure"
               data-disclosure-key-value="<%= reason %>">

        <button type="button"
                data-action="click->disclosure#toggle"
                class="w-full px-5 py-3.5 flex items-center justify-between
                       bg-gray-50 dark:bg-gray-900/40
                       hover:bg-gray-100 dark:hover:bg-gray-900/60
                       transition-colors duration-100">
          <h2 class="text-base font-semibold text-gray-700 dark:text-gray-300 leading-snug">
            <%= reason %>
            <span class="ml-1.5 text-xs font-normal text-gray-400 dark:text-gray-500">
              <%= templates.size %>件
            </span>
          </h2>
          <svg data-disclosure-target="icon"
               class="w-4 h-4 text-gray-400 dark:text-gray-500 shrink-0
                      transition-transform duration-200"
               fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <ul data-disclosure-target="content"
            class="divide-y divide-gray-100 dark:divide-gray-800">
          <% templates.each do |template| %>
            <% bookmark = user_bookmarks[template.id] %>
            <% is_owner = template.user_uuid.present? && template.user_uuid == current_user&.uuid %>

            <li class="px-5 py-4
                       hover:bg-gray-50 dark:hover:bg-gray-900/40
                       transition-colors duration-100">

              <div class="flex items-center gap-4">

                <p class="flex-1 min-w-0 text-base leading-relaxed text-gray-700 dark:text-gray-300">
                  <%= template.template %>
                </p>

                <div class="flex items-center gap-2 shrink-0">

                  <% if user_signed_in? %>
                    <% if bookmark %>
                      <%= render 'unbookmark_button', message_template: template, bookmark: bookmark %>
                    <% else %>
                      <%= render 'bookmark_button', message_template: template %>
                    <% end %>
                  <% end %>

                  <% if user_signed_in? && is_owner %>
                    <%= link_to edit_message_template_path(template),
                        data: { turbo_frame: "dialog" },
                        class: "px-3 py-1.5 text-xs font-medium rounded-md
                                text-gray-600 dark:text-gray-400
                                border border-gray-200 dark:border-gray-800
                                bg-white dark:bg-gray-950
                                hover:bg-gray-50 dark:hover:bg-gray-900
                                hover:text-gray-900 dark:hover:text-gray-100
                                transition-colors duration-100" do %>
                      編集
                    <% end %>

                    <%= button_to message_template_path(template),
                        method: :delete,
                        data: { turbo_confirm: '本当に削除しますか?',
                                turbo_submits_with: "削除中..." },
                        class: "px-3 py-1.5 text-xs font-medium rounded-md
                                text-red-500 dark:text-red-400
                                border border-red-200 dark:border-red-900
                                bg-white dark:bg-gray-950
                                hover:bg-red-50 dark:hover:bg-red-950/50
                                transition-colors duration-100" do %>
                      削除
                    <% end %>
                  <% end %>

                </div>
              </div>
            </li>
          <% end %>
        </ul>

      </section>
    <% end %>
  </div>

<% end %>