<%# app/views/message_templates/create.turbo_stream.erb %>

<%# index ページ用 %>
<%= turbo_stream.update "message_templates_list_content" do %>
  <%= render 'templates_list',
      message_templates: @message_templates,
      empty_message: "定型文が見つかりませんでした",
      empty_description: "検索条件を変更してお試しください" %>
<% end %>

<%# manage ページ用 %>
<%= turbo_stream.update "manage_list_content" do %>
  <%= render 'manage_list',
      message_templates: @message_templates,
      user_bookmarks: @user_bookmarks,
      empty_message: "定型文が見つかりませんでした",
      empty_description: "検索条件を変更してお試しください" %>
<% end %>

<%= render_turbo_stream_flash_messages %>
<%= turbo_stream.update "dialog" %>