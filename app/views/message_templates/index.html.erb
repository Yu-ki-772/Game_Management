<%# app/views/message_templates/index.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%= render 'message_templates/navigation' %>

  <div class="pb-5 border-b border-gray-200 dark:border-gray-800 mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
      定型文一覧
    </h1>
  </div>

  <%= turbo_frame_tag "message_templates_list" do %>

    <div id="message_templates_list_content">
      <%= render 'templates_list',
          message_templates: @message_templates,
          empty_message: "定型文が見つかりませんでした",
          empty_description: "検索条件を変更してお試しください" %>
    </div>
  <% end %>
</div>