<%# app/views/message_templates/bookmarks.html.erb %>
<div class="max-w-7xl mx-auto px-4 py-8">

  <%# ページヘッダー %>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between pb-5 border-b border-gray-200 dark:border-gray-700 mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">ブックマーク一覧</h1>

    <div class="flex items-center gap-3">
      <%= link_to message_templates_path,
          class: "inline-flex items-center justify-center gap-2 flex-1 md:flex-none
                  bg-white dark:bg-gray-700
                  hover:bg-emerald-50 dark:hover:bg-emerald-900/30
                  text-emerald-700 dark:text-emerald-400
                  font-semibold px-5 py-2 rounded-lg
                  border border-emerald-200 dark:border-emerald-800
                  transition text-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M9 6l11 0" /><path d="M9 12l11 0" /><path d="M9 18l11 0" />
          <path d="M5 6l0 .01" /><path d="M5 12l0 .01" /><path d="M5 18l0 .01" />
        </svg>
        すべての定型文
      <% end %>

      <%= link_to new_message_template_path,
          data: { turbo_frame: "dialog" },
          class: "inline-flex items-center justify-center gap-2 flex-1 md:flex-none
                  bg-emerald-600 hover:bg-emerald-700 text-white
                  font-semibold px-5 py-2 rounded-lg transition text-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 5l0 14" /><path d="M5 12l14 0" />
        </svg>
        定型文を作成
      <% end %>
    </div>
  </div>

  <%# Turbo Frame %>
  <%= turbo_frame_tag "bookmarks_list" do %>
    <%# 検索フォーム %>
    <%= render 'search_form',
        q: @q,
        url: bookmarks_message_templates_path,
        turbo_frame: "bookmarks_list",
        available_reasons: @available_reasons %>

    <div id="bookmarks_list_content">
      <%= render 'templates_list',
          message_templates: @bookmarks_message_templates,
          user_bookmarks: @user_bookmarks,
          empty_message: @empty_message,
          empty_description: @empty_description %>
    </div>
  <% end %>
</div>