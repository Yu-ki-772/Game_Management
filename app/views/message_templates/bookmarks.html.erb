<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center pb-4 border-b-2 border-emerald-500 mb-8">
    <h1 class="text-3xl font-bold">ブックマーク一覧</h1>
    
    <div class="flex items-center gap-3">
      <%= link_to message_templates_path,
                  class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold px-6 py-2.5 rounded-lg transition flex items-center gap-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-list"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l11 0" /><path d="M9 12l11 0" /><path d="M9 18l11 0" /><path d="M5 6l0 .01" /><path d="M5 12l0 .01" /><path d="M5 18l0 .01" /></svg>
        すべての定型文
      <% end %>
      
      <%= link_to new_message_template_path,
                  class: "bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-6 py-2.5 rounded-lg transition flex items-center gap-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
        定型文を作成
      <% end %>
    </div>
  </div>
  

  <div class="space-y-8">
    <% @bookmarks_message_templates.group_by(&:reason).each do |reason, templates| %>
      <section class="bg-white rounded-lg shadow-md p-6">
        <div class="mb-4">
          <h2 class="text-xl font-semibold text-gray-900">
            <%= reason %>
          </h2>
        </div>
        
        <ul class="space-y-3">
          <% templates.each do |template| %>
            <%# 定型文に該当ユーザのブックマークレコードがあれば取得 %>
            <% bookmark = @user_bookmarks[template.id] %>

            <li class="px-4 py-3 bg-gray-100 rounded hover:bg-gray-200 transition">
              <div class="flex items-start justify-between gap-4">
                <p class="text-gray-900 flex-1">
                  <%= template.template %>
                </p>

                <div class="flex items-center gap-2 shrink-0">
                  <%# ブックマーク解除ボタン %>
                  <%= render 'unbookmark_button', message_template: template, bookmark: bookmark %>

                  <% if template.user_id.present? %>
                    <%= link_to edit_message_template_path(template), 
                                class: "px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-semibold rounded transition" do %>
                      編集
                    <% end %>
                    <%= button_to message_template_path(template), 
                                  method: :delete,
                                  data: { turbo_confirm: '本当に削除しますか?' },
                                  class: "px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-sm font-semibold rounded transition" do %>
                      削除
                    <% end %>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
