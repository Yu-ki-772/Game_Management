<%# app/views/message_templates/_navigation.html.erb %>
<nav class="mb-4 sm:mb-6
            bg-white dark:bg-gray-950
            rounded-xl
            border border-gray-200 dark:border-gray-800
            p-1 flex gap-0.5 overflow-x-auto">

  <%# 一覧 %>
  <%= link_to message_templates_path,
      class: "flex-shrink-0 flex items-center gap-1.5
              px-3.5 py-2 rounded-lg text-sm font-medium
              transition-colors duration-100
              #{current_page?(message_templates_path) ?
                'bg-gray-900 dark:bg-white text-white dark:text-gray-900' :
                'text-gray-500 dark:text-gray-400
                 hover:text-gray-900 dark:hover:text-gray-100
                 hover:bg-gray-100 dark:hover:bg-gray-900'}" do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 6l11 0M9 12l11 0M9 18l11 0M5 6l0 .01M5 12l0 .01M5 18l0 .01"/>
    </svg>
    <span>一覧</span>
  <% end %>

  <%# ブックマーク %>
  <%= link_to bookmarks_message_templates_path,
      class: "flex-shrink-0 flex items-center gap-1.5
              px-3.5 py-2 rounded-lg text-sm font-medium
              transition-colors duration-100
              #{current_page?(bookmarks_message_templates_path) ?
                'bg-gray-900 dark:bg-white text-white dark:text-gray-900' :
                'text-gray-500 dark:text-gray-400
                 hover:text-gray-900 dark:hover:text-gray-100
                 hover:bg-gray-100 dark:hover:bg-gray-900'}" do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
    </svg>
    <span>ブックマーク</span>
  <% end %>

  <%# 管理画面 %>
  <%= link_to manage_message_templates_path,
      class: "flex-shrink-0 flex items-center gap-1.5
              px-3.5 py-2 rounded-lg text-sm font-medium
              transition-colors duration-100
              #{current_page?(manage_message_templates_path) ?
                'bg-gray-900 dark:bg-white text-white dark:text-gray-900' :
                'text-gray-500 dark:text-gray-400
                  hover:text-gray-900 dark:hover:text-gray-100
                  hover:bg-gray-100 dark:hover:bg-gray-900'}" do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37c1 .608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>
    <span>管理</span>
  <% end %>

</nav>