<%# app/views/simple_calendar/_month_calendar.html.erb %>
<div class="w-full bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-sm">
  <div class="flex justify-between items-center p-4 sm:p-3 md:p-4
              bg-gradient-to-r from-emerald-50 dark:from-emerald-950 to-emerald-100 dark:to-emerald-900/50
              border-b-2 border-emerald-500 gap-2">
    <%= link_to calendar.url_for_previous_view,
        data: { turbo_frame: "calendar" },
        class: "inline-flex items-center px-3 py-2
                text-emerald-600 dark:text-emerald-400
                font-semibold rounded-lg
                hover:bg-emerald-100 dark:hover:bg-emerald-900/50
                transition-all min-h-[44px]" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span class="hidden sm:inline ml-1">前月</span>
    <% end %>

    <span class="text-base sm:text-xl font-bold text-gray-800 dark:text-gray-100">
      <%= start_date.strftime("%Y年%m月") %>
    </span>

    <%= link_to calendar.url_for_next_view,
        data: { turbo_frame: "calendar" },
        class: "inline-flex items-center px-3 py-2
                text-emerald-600 dark:text-emerald-400
                font-semibold rounded-lg
                hover:bg-emerald-100 dark:hover:bg-emerald-900/50
                transition-all min-h-[44px]" do %>
      <span class="hidden sm:inline mr-1">次月</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    <% end %>
  </div>

  <table class="simple-calendar">
    <thead>
      <tr>
        <% t('date.abbr_day_names').each_with_index do |day_name, index| %>
          <th class="p-2 sm:p-3 text-center text-[10px] sm:text-xs font-semibold
                     bg-gray-50 dark:bg-gray-700/50
                     border-b-2 border-gray-200 dark:border-gray-700
                     <%= 'text-red-600 dark:text-red-400' if index == 0 %>
                     <%= 'text-blue-600 dark:text-blue-400' if index == 6 %>
                     <%= 'text-gray-700 dark:text-gray-300' unless [0, 6].include?(index) %>">
            <%= day_name %>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <%= content_tag :td, class: calendar.td_classes_for(day) do %>
              <div class="h-full flex flex-col p-1 sm:p-2">
                <!-- 日付ヘッダー -->
                <div class="flex justify-between items-start mb-1">
                  <span class="text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-200">
                    <%= day.day %>
                  </span>

                  <div class="flex items-center gap-1">
                    <% if day == Date.today %>
                      <span class="text-[8px] sm:text-[10px] bg-emerald-500 text-white px-1 sm:px-1.5 py-0.5 rounded font-semibold">
                        今日
                      </span>
                    <% end %>

                    <!-- 新規アラーム作成ボタン -->
                    <% if day >= Date.today && day.month == start_date.month %>
                      <%= link_to new_alarm_path(date: day.to_s),
                          title: "アラームを追加",
                          data: { turbo_frame: "_top" },
                          class: "flex items-center justify-center w-3.5 h-3.5 sm:w-5 sm:h-5 md:w-6 md:h-6
                                  rounded bg-emerald-500 text-white
                                  opacity-85 hover:opacity-100 hover:bg-emerald-600
                                  hover:scale-110 active:scale-95 transition-all flex-shrink-0" do %>
                        <svg class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 md:w-4 md:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <!-- アラーム一覧 -->
                <% if defined?(Haml) && respond_to?(:block_is_haml?) && block_is_haml?(passed_block) %>
                  <% capture_haml(day, sorted_events.fetch(day, []), &passed_block) %>
                <% else %>
                  <% passed_block.call day, sorted_events.fetch(day, []) %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>