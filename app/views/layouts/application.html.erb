<%# app/views/layouts/application.html.erb %>
<!DOCTYPE html>
<html>
  <head>
    <%# ヘルパーでメタタグを設定 %>
    <%= display_meta_tags(default_meta_tags) %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Game Exit">
    <meta name="application-name" content="Game Exit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (function() {
        var saved = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = saved === "dark" || (saved !== "light" && prefersDark);
        if (isDark) document.documentElement.classList.add("dark");
      })();
    </script>

    <%= yield :head %>

    <%= favicon_link_tag "favicon/favicon.ico" %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="<%= asset_path('icon-192x192.png') %>" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path('icon-192x192.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body
    data-controller="theme"
    class="bg-gray-50 dark:bg-gray-900 flex flex-col min-h-screen transition-colors duration-200">

    <%= render 'shared/header' %>

    <!-- フラッシュメッセージ -->
    <div id="flash_messages"
        class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 items-center">
      <%= render "shared/flash" %>
    </div>

    <main class="container mx-auto px-4 py-6 max-w-7xl pb-24 flex-1">
      <%= yield %>
    </main>

    <%= render 'shared/footer' %>

    <%= turbo_frame_tag "dialog" %>

    <div id="push_notification_modal"></div>
    <%= render "shared/push_notification_modal" if flash[:show_push_notification_modal] %>
  </body>
</html>
