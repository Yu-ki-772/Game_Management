<%# app/views/layouts/application.html.erb %>
<!DOCTYPE html>
<html>
  <head>
    <%# ヘルパーでメタタグを設定 %>
    <%= display_meta_tags(default_meta_tags) %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Game Exit">
    <meta name="application-name" content="Game Exit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (function() {
        var saved = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = saved === "dark" || (saved !== "light" && prefersDark);
        if (isDark) document.documentElement.classList.add("dark");
      })();
    </script>

    <%= yield :head %>

    <%= favicon_link_tag "favicon/favicon.ico" %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="<%= asset_path('icon-192x192.png') %>" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path('icon-192x192.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body
    data-controller="theme"
    class="bg-gray-50 dark:bg-gray-900 flex flex-col min-h-screen transition-colors duration-200">

    <%= render 'shared/header' %>

    <!-- フラッシュメッセージ -->
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 items-center">
      <% if notice %>
        <div data-controller="flash"
            data-action="turbo:before-cache@window->flash#beforeCache"
             class="inline-flex items-center gap-3 rounded-lg px-4 py-3 max-w-sm w-max
                    shadow-lg
                    bg-emerald-50 border border-emerald-200
                    dark:bg-emerald-950 dark:border-emerald-800
                    transition-opacity duration-500"
             role="alert">
          <p class="text-xs text-emerald-700 dark:text-emerald-300">
            <%= notice %>
          </p>
          <button data-action="flash#dismiss"
                  class="shrink-0 text-emerald-400 hover:text-emerald-600 dark:hover:text-emerald-200"
                  aria-label="閉じる">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      <% end %>

      <% if alert %>
        <div data-controller="flash"
             data-flash-duration-value="0"
             class="inline-flex items-center gap-3 rounded-lg px-4 py-3 max-w-sm w-max
                    shadow-lg
                    bg-red-50 border border-red-200
                    dark:bg-red-950 dark:border-red-800
                    transition-opacity duration-500"
             role="alert">
          <p class="text-xs text-red-600 dark:text-red-400">
            <%= alert %>
          </p>
          <button data-action="flash#dismiss"
                  class="shrink-0 text-red-400 hover:text-red-600 dark:hover:text-red-200"
                  aria-label="閉じる">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>

    <main class="container mx-auto px-4 py-6 max-w-7xl pb-24 flex-1">
      <%= yield %>
    </main>

    <%= render 'shared/footer' %>

    <%= turbo_frame_tag "dialog" %>

    <%= render "shared/pwa_install_prompt" if flash[:show_pwa_install_prompt] %>
    <%= render "shared/push_notification_modal" if flash[:show_push_notification_modal] %>
  </body>
</html>
