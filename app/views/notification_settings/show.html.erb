<div class="max-w-lg mx-auto py-8 px-4">
  <h1 class="text-xl font-semibold text-gray-800 mb-6">通知設定</h1>

  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
    <h2 class="text-sm font-medium text-gray-700 mb-1">プッシュ通知</h2>
    <p class="text-xs text-gray-500 mb-6">
      アラームの時間になったときにブラウザで通知をお届けします。
    </p>

    <div data-controller="push-notification"
         data-push-notification-vapid-public-key-value="<%= ENV['VAPID_PUBLIC_KEY'] %>">

      <p id="push-status-loading" class="text-sm text-gray-400">確認中...</p>

      <%# 購読していない場合に表示するボタン。 %>
      <button id="push-subscribe-btn"
              data-action="click->push-notification#subscribe"
              class="hidden w-full px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition">
        通知をオンにする
      </button>

      <%# 購読している場合に表示するボタン。 %>
      <button id="push-unsubscribe-btn"
              data-action="click->push-notification#unsubscribe"
              class="hidden w-full px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition">
        通知をオフにする
      </button>

      <%# Service Worker 非対応ブラウザへのメッセージ。初期状態は hidden。 %>
      <p id="push-not-supported"
         class="hidden text-sm text-red-500">
        このブラウザはプッシュ通知に対応していません。
      </p>
    </div>
  </div>
</div>