<%# app/views/notification_settings/show.html.erb %>
<div class="max-w-lg mx-auto py-8 px-4">
  <%# tracking-tight を追加 %>
  <h1 class="text-xl font-semibold tracking-tight
             text-gray-800 dark:text-gray-100 mb-6">通知設定</h1>

  <%# shadow-sm 削除、bg・border をトークンに合わせる、rounded-lg → rounded-xl %>
  <div class="bg-white dark:bg-gray-900
              rounded-xl border border-gray-200 dark:border-gray-800
              p-6">
    <h2 class="text-base font-medium text-gray-700 dark:text-gray-300 mb-1">プッシュ通知</h2>
    <p class="text-sm text-gray-400 dark:text-gray-500 mb-6">
      アラームの時間になったときにブラウザで通知をお届けします。
    </p>

    <div data-controller="push-notification"
         data-push-notification-vapid-public-key-value="<%= ENV['VAPID_PUBLIC_KEY'] %>">

      <p id="push-status-loading" class="text-sm text-gray-400 dark:text-gray-500">確認中...</p>

      <%# 購読していない → プライマリボタン（グレー反転）。blue は未定義トークンのため変更 %>
      <button id="push-subscribe-btn"
              data-push-notification-target="subscribeBtn"
              data-action="click->push-notification#subscribe"
              class="hidden w-full px-4 py-2
                     bg-gray-900 dark:bg-white
                     hover:bg-gray-700 dark:hover:bg-gray-300
                     text-white dark:text-gray-900
                     text-sm font-semibold rounded-md
                     transition-colors duration-100">
        通知をオンにする
      </button>

      <%# 購読している → デストラクティブパターン（通知を無効化する破壊的アクション） %>
      <button id="push-unsubscribe-btn"
              data-push-notification-target="unsubscribeBtn"
              data-action="click->push-notification#unsubscribe"
              class="hidden w-full px-4 py-2
                     text-gray-500 dark:text-gray-400
                     border border-gray-200 dark:border-gray-800
                     hover:text-red-500 dark:hover:text-red-400
                     hover:border-red-200 dark:hover:border-red-800
                     hover:bg-red-50 dark:hover:bg-red-900/20
                     active:bg-red-100 dark:active:bg-red-900/40
                     text-sm font-medium rounded-md
                     transition-colors duration-100">
        通知をオフにする
      </button>

      <%# Service Worker 非対応：赤は「緊急・エラー」として意味論的に正当 %>
      <p id="push-not-supported"
         class="hidden text-sm text-red-500 dark:text-red-400 leading-relaxed">
        現在の環境ではプッシュ通知を有効にできません。iOSでプッシュ通知を有効にしたい場合は、このアプリをホーム画面に追加してください。
      </p>

    </div>
  </div>
</div>